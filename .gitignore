# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
*.tsbuildinfo

# Next.js build cache (apps/site). It's already ignored by apps/site/.gitignore, but the EAS
# build archive only honors the ROOT .gitignore (not nested ones) — so without this line the
# ~2GB .next cache bloats every `eas build` upload. Keep heavy build caches ignored at root.
.next
.expo

# Rust build output (apps/tv-tauri/src-tauri/target) — ignored only by Tauri's NESTED .gitignore, which
# the EAS build archive doesn't honor (root only). Without this, `eas build` tries to pack the ~36GB Rust
# target dir → "Compressing project files" hangs forever. Same class of fix as `.next` above. `target/`
# (trailing slash, no leading slash) matches any Rust target dir at any depth; no tracked source lives
# under one, so this is safe.
target/

# Generated files
apps/web/src/routeTree.gen.ts
apps/tv-web/src/routeTree.gen.ts
apps/tv-web/.tanstack/

# Environment variables
.env
.env*.local

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Turbo
.turbo
.nx

# Better-T-Stack
.alchemy
.vercel

# Testing
coverage
.nyc_output

# Misc
*.tgz
.cache
tmp
temp

# Local-only docs and plans (design notes, project plan, scratch SQL, etc.)
.docs/
.plans/

# Local reference repos (sibling sources cloned for design reference)
.tmp/
.refs/

# Generated capability-probe test media (large, regeneratable)
apps/server/capability-media/

# Bumper ambient music (user-provided; dev default dir — self-host mounts a volume here)
apps/server/bumper-music/

# Capability media tarball staged for the Docker build (pulled from the media-v1 release,
# baked into the image). Keep the dir (.gitkeep) so the Dockerfile COPY has a source.
docker/cap-media/*.tar.gz

# Stray tsc build-mode emit in the (TS-only) api source tree (belongs in dist/, not src/)
packages/api/src/**/*.js
packages/api/src/**/*.d.ts
*.ipk

# Workflow SDK generated handler bundles (bunx workflow build) — 20MB+, rebuilt on every build.
.well-known/

# Gradle build caches from the Android native modules (packages/*/android/.gradle) — build junk.
.gradle/

# webOS ares-package output (.ipk build artifacts)
apps/tv-web/build-ipk/

# Electrobun desktop build outputs (installer + release artifacts + the pre-bundled pg launcher)
apps/desktop/artifacts/
apps/desktop/pg-launcher/

# Code-signing material — NEVER commit. Drop a .p12/.p8 here only to hand it to `gh secret set`, then delete.
*.p12
*.p8
*.pfx
*.cer
*.certSigningRequest
.secrets/

# Agent skills installed locally via `npx skills add` (HyperFrames + video skills).
# Local-only tooling — not committed. Keep the project's own version-bump skill tracked.
.claude/skills/*
!.claude/skills/version-bump/
skills-lock.json
