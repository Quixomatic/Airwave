{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // `.well-known/**` = the Workflow SDK's generated flow/step/webhook handlers
      // (`workflow build`, §7.3a). Without it a cache hit would restore a build with no
      // handlers, and every workflow run would 404 on dispatch.
      // `.next/**` (minus its local cache) = the Next.js build output for `apps/site`.
      // Without it a turbo cache HIT replays an empty output set and Vercel fails with
      // "The Next.js output directory .next was not found" (the build never re-runs).
      "outputs": ["dist/**", ".well-known/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // The Workflow SDK's flow/step handlers. `pnpm dev` rebuilds these only when stale;
    // run this directly after editing anything under `workflows/` if you're not restarting.
    "workflow:build": {
      "cache": false,
      "outputs": [".well-known/**"]
    },
    // The workflow observability web UI (runs, steps, events, streams). Long-lived and
    // deliberately separate from `dev` — start it only when you want to watch a run.
    "workflow:ui": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
