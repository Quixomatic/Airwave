/// General-purpose, app-wide settings — a **singleton** (one row; upsert-by-key returns it). Add a column
/// here for any global config that isn't tied to a specific entity. Read/created via `getAppSettings`.
model AppSettings {
  id  String @id @default(cuid())
  /// Singleton guard: always "global" so upsert-by-key returns the one row.
  key String @unique @default("global")

  /// Stable per-install fingerprint (a UUID), generated once on first read and never changed. Surfaced in the
  /// public /api/health handshake so clients can confirm a server is Airwave and recognize a specific install.
  /// Nullable + self-healing: existing installs backfill it on the next read. See getInstanceId.
  instanceId String?

  /// Friendly DISPLAY name for this server (e.g. "Blue Turtle Airwave"), shown in scan pickers and the
  /// /api/identity handshake. Unlike instanceId this is MUTABLE — seeded with a generated name on first read
  /// but editable in General settings. Nullable + self-healing: existing installs backfill it. See getServerName.
  serverName String?

  /// Max channels the AI lineup builder builds in parallel. Lower it (down to 1) for slow local models
  /// that can't keep up with parallel agent loops; default 6 (the previous hardcoded value).
  channelBuildConcurrency Int @default(6)

  /// Max channels the lineup importer resolves/creates in parallel. Less demanding than the AI builder
  /// (no LLM), but still capped; default 4 (the previous hardcoded value).
  importConcurrency Int @default(4)

  /// Max output tokens for the AI lineup PLANNER's single design call. A full lineup is a lot of JSON;
  /// too low truncates the plan (surfaces as a schema error), too high risks the step timeout. Default
  /// 32000 (the previous hardcoded value). Raise for very large libraries / verbose models.
  plannerMaxOutputTokens Int @default(32000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
