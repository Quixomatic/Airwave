/// A user's favorited channel (powers the "Favorites Only" guide filter). Stored
/// server-side so it syncs across all the user's devices/platforms.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, channelId])
  @@index([userId])
  @@map("favorite")
}

/// Per-user, per-channel playback state — powers cross-device resume and DVR
/// (whether the user is following the live edge or behind it).
model ChannelWatchState {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // true = following the live timeline; false = behind live (paused/rewound/from start)
  atLiveEdge Boolean @default(true)
  // When behind live: the wall-clock instant on the channel timeline the user's
  // playback maps to — lets any device resume the exact spot.
  positionAt DateTime?
  // Denormalized convenience so a client can resume without recomputing.
  lastRatingKey     String?
  lastOffsetSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, channelId])
  @@index([userId])
  @@map("channel_watch_state")
}

/// A live "who's watching what" session (our in-house version of Plex's Now Playing —
/// we deliberately don't report sessions/watch-state to Plex). Kept fresh by client
/// heartbeats; a session is "active" while its `lastHeartbeatAt` is recent. One per
/// user (a user watches one channel at a time); switching channels updates it.
model WatchSession {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  // "program" | "bumper" | "off"
  state          String  @default("off")
  ratingKey      String? // the media currently playing (null for bumpers)
  title          String? // denormalized snapshot for the admin view
  delaySeconds   Int     @default(0) // how far behind live
  // Absolute instant on the channel timeline the viewer is at (delaySeconds is
  // relative to "now"; this is the exact spot — for cross-device resume later).
  positionAt     DateTime?
  // The Plex transcode session id, if any — lets a reaper stop stale transcodes.
  transcodeSession String?

  startedAt       DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())

  @@index([channelId])
  @@index([lastHeartbeatAt])
  @@map("watch_session")
}
