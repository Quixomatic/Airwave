enum BumperSource {
  PLEX_PLAYLIST
  PLEX_COLLECTION
  LOCAL_DIR
}

/// How breaks are placed on a channel's timeline. Between-programs only for now;
/// mid-program (with a settable cadence) is a future option — the fields exist so
/// enabling it needs no migration.
enum BumperPlacement {
  BETWEEN_PROGRAMS
  MID_PROGRAM
}

/// Global commercial/bumper configuration — a **singleton** (one row; admins have
/// full control here). Every break is framed by a client-rendered **interstitial**
/// ("We'll be right back" → "Up Next: <title>" with cover art + a countdown); when
/// commercial media sources are configured (future), their clips play *within* that
/// frame. A channel can only pick a mode (see Channel.bumperMode) — never a source.
model BumperConfig {
  id      String  @id @default(cuid())
  /// Singleton guard: always "global" so upsert-by-key returns the one row.
  key     String  @unique @default("global")
  /// Enabled by default so a first-time install has interstitial breaks out of the box.
  enabled Boolean @default(true)

  /// Bumped on every settings change. Each channel's schedule is stamped with the
  /// rev it was built under (Channel.bumperRev); Bumper Sync rebuilds any channel
  /// whose stamp is behind — so any tier/threshold change reconciles cleanly.
  rev Int @default(0)

  // ── Interstitial break lengths (contextual — chosen per program transition) ─
  /// Fallback length when no specific tier applies, in seconds.
  interstitialSeconds Int @default(15)
  /// After a movie — a real intermission (you just watched a feature).
  afterMovieSeconds   Int @default(120)
  /// After a TV episode — a normal between-shows breather.
  afterEpisodeSeconds Int @default(30)
  /// Quick break — same show continues, or a short episode is up next.
  quickSeconds        Int @default(10)
  /// An episode at or under this many minutes counts as "short" (→ quick break).
  shortEpisodeMinutes Int @default(20)

  /// Reserved for future template/style variants; one auto-derived style for now.
  interstitialStyle   String  @default("up-next")
  /// DEPRECATED — the single-track "elevator music" hook, superseded by the BumperMusic library below.
  /// Left nullable/unused; the ambient bed now comes from enabled `BumperMusic` rows, chosen at random.
  interstitialMusicKey String?

  // ── Ambient bumper music (the BumperMusic library) ─────────────────────────
  /// Play a soft random music bed under the interstitial. On by default.
  musicEnabled   Boolean @default(true)
  /// Bed level 0–100 (kept LOW by default so it's a bed, not the foreground).
  musicVolume    Int     @default(30)
  /// Fade the track in at the start of a bumper / out before it ends, in milliseconds.
  musicFadeInMs  Int     @default(1000)
  musicFadeOutMs Int     @default(1500)

  // ── Commercial media (future — clips shown inside the interstitial frame) ───
  source            BumperSource?
  plexPlaylistKey   String?
  plexCollectionKey String?
  localDirPath      String? // server-readable dir of clips (served via a small static endpoint)
  minPerBreak       Int          @default(1)
  maxPerBreak       Int          @default(1) // clamp 1–5 in app logic

  // ── Placement (future mid-program cadence) ─────────────────────────────────
  placement          BumperPlacement @default(BETWEEN_PROGRAMS)
  /// For MID_PROGRAM: insert a break roughly every N minutes into a program.
  midProgramCadenceMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bumper_config")
}

/// One ambient bumper-music track (§7.14). The audio file lives in BUMPER_MUSIC_DIR (a volume on self-host);
/// this row indexes it plus its enabled state + metadata, so the folder stays the source of truth for bytes
/// and the DB for "what's in the random pool". Two ingestion paths: uploaded through the admin UI, or dropped
/// into the volume and picked up by the manual `bumper-music-scan` job. The TV apps stream these over the API.
model BumperMusic {
  id          String  @id @default(cuid())
  /// File name relative to BUMPER_MUSIC_DIR — the on-disk identity.
  filename    String  @unique
  /// Display name (defaults to the filename without extension; editable).
  title       String
  /// In the random pool when true. The per-track on/off toggle in the admin UI.
  enabled     Boolean @default(true)
  contentType String? // "audio/mpeg" | "audio/mp4" | "audio/aac"
  sizeBytes   Int?
  /// How it got here: "upload" (admin UI) or "scan" (found in the volume by the scan job).
  source      String  @default("upload")
  /// True when the indexed file has gone missing (the scan flags it; the UI warns). Kept, not deleted.
  missing     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bumper_music")
}
