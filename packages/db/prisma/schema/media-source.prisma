enum MediaSourceType {
  PLEX
  JELLYFIN
  EMBY
}

/// A connected media server (configured once by an admin, Overseerr-style).
/// Holds the owner token used for metadata scraping + as the playback fallback
/// for users who haven't linked their own account.
model MediaSource {
  id                String          @id @default(cuid())
  type              MediaSourceType @default(PLEX)
  name              String
  baseUrl           String? // resolved/pinned connection URI (server → Plex; also the LAN URL, since the server runs alongside Plex)
  // The server's OFF-network Plex connection URIs (from plex.tv /resources), kept fresh by the
  // hourly plex-connection-refresh job. A client that can't reach `baseUrl` on the LAN falls back
  // to remoteUrl (WAN), then relayUrl (last resort, ~2 Mbps). baseUrl covers the local case.
  remoteUrl         String? // Plex remote/WAN connection URI
  relayUrl          String? // Plex relay connection URI
  machineIdentifier String? // Plex server clientIdentifier
  token             String // owner/admin token — encrypted at rest
  clientIdentifier  String? // the X-Plex-Client-Identifier used to obtain the token
  webAppUrl         String? // optional Plex web-app URL override
  enabled           Boolean         @default(true)
  isDefault         Boolean         @default(false)

  ownerUserId String?
  owner       User?   @relation("MediaSourceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  channels   Channel[]
  libraries  MediaLibrary[]
  mediaItems MediaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@map("media_source")
}

/// Cached metadata for one media-server item (movie or episode). Populated when a
/// channel's content is resolved and refreshed by metadata sync; the central place
/// to enrich (e.g. episodes inheriting genres/cast from their parent show). Schedule
/// slots point here via `mediaItemId` instead of copying metadata onto every row.
model MediaItem {
  id            String      @id @default(cuid())
  mediaSourceId String
  mediaSource   MediaSource @relation(fields: [mediaSourceId], references: [id], onDelete: Cascade)

  ratingKey String // media-server item id
  type      String // "show" | "movie" | "episode"
  title     String
  durationMs Int    @default(0)
  year      Int?
  airDate   String? // originallyAvailableAt — for by-air-date ordering

  // An episode references its parent show (which holds the show-level metadata —
  // genres, cast, studio, art). Movies have no parent. The effective guide for a
  // slot is the item's own bundle merged over its parent's.
  parentId String?
  parent   MediaItem?  @relation("MediaItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaItem[] @relation("MediaItemChildren")

  /// This item's own display bundle (GuideMeta). For an episode: title, summary,
  /// season/episode, badges. For a show: genres, cast, studio, art, … (shared by
  /// its episodes via `parent`).
  guide Json

  /// Whether the item is still present on the media server (for the missing-media
  /// edge case — sync flips this instead of hard-deleting so built schedules render).
  available    Boolean  @default(true)
  lastSyncedAt DateTime @default(now())

  scheduleItems       ScheduleItem[]
  targetedByBumpers   ScheduleItem[] @relation("ScheduleItemTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mediaSourceId, ratingKey])
  @@index([mediaSourceId, type])
  @@index([parentId])
  @@map("media_item")
}

/// A library (section) on a connected media server. Synced from Plex; the admin
/// enables/disables which ones feed channels (Overseerr-style).
model MediaLibrary {
  id            String      @id @default(cuid())
  mediaSourceId String
  mediaSource   MediaSource @relation(fields: [mediaSourceId], references: [id], onDelete: Cascade)
  key           String // media-server section key
  title         String
  type          String // "movie" | "show" | …
  enabled       Boolean     @default(true)
  lastScanAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mediaSourceId, key])
  @@index([mediaSourceId])
  @@map("media_library")
}
