enum OrderingStrategy {
  SHUFFLE
  IN_ORDER
  BY_AIR_DATE
}

enum ChannelDefinitionKind {
  PREDICATE // metadata predicate groups (resolved against Plex's API for Plex sources)
  PLEX_COLLECTION
  PLEX_PLAYLIST
  MANUAL_ITEMS // explicit include/exclude of specific media items
}

enum DefinitionMode {
  INCLUDE
  EXCLUDE
}

/// A channel's thin control over bumpers. The global BumperConfig owns the actual
/// content (sources, timing); a channel only picks a mode. INHERIT = follow the
/// global config; OFF = never; INTERSTITIAL_ONLY = just the break frame; FULL =
/// interstitial + commercials. (INTERSTITIAL_ONLY and FULL behave the same until
/// commercial media sources ship.)
enum BumperMode {
  INHERIT
  OFF
  INTERSTITIAL_ONLY
  FULL
}

/// A guide package — the toggleable grouping of channels (e.g. "Time Machine").
model ChannelPackage {
  id          String    @id @default(cuid())
  key         String    @unique // stable slug
  name        String
  description String?
  icon        String? // "lucide:Sparkles" / "phosphor:Television"
  tint        String? // TintedIconTile tint token — channels inherit this unless they override
  sortIndex   Int       @default(0)

  // Provenance: auto-generated packages carry `generated=true` so a regen can delete
  // + rebuild them without touching manually-created packages.
  generated Boolean @default(false)
  // Distinct provenance for the AI assistant / workflow (separate from the static generator's
  // `generated`), so those can be listed + cleanly reverted via `clear_ai_generated`.
  aiGenerated Boolean @default(false)

  channels    Channel[]
  userAccess  UserPackageAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("channel_package")
}

/// A live channel. Its candidate pool comes from one or more ChannelDefinitions;
/// ordering + a stable shuffle seed make the materialized schedule deterministic.
model Channel {
  id          String           @id @default(cuid())
  number      Int              @unique // guide channel number
  name        String
  callsign    String? // short memorable code, e.g. "EVRTV" (uppercase, ≤6 chars)
  description String?
  icon        String? // "lucide:Sparkles" / "phosphor:Television" — overrides the package icon
  tint        String? // TintedIconTile tint token — overrides the package tint
  enabled     Boolean          @default(true)
  sortIndex   Int              @default(0)
  ordering    OrderingStrategy @default(SHUFFLE)
  shuffleSeed Int? // stable seed for deterministic shuffle
  // OPTIONAL bolt-on grouping/rotation strategy (§7.6 Arc 3) layered OVER `ordering`. null = base ordering
  // only (byte-for-byte today's behavior). Shape (see services/schedule/timeline.ts `ChannelStrategy`):
  // { rotation: "clustered"|"round_robin", rotationOrder?: "shuffle"|"cycle",
  //   grouping: [{ scope: "show"|"movie"|"collection", run: n|[min,max]|"all"|{minutes:[min,max]}, filter? }],
  //   constraints?: { noRepeatWithin?: {...} } }. Base order still governs within-group order + group sort.
  strategy    Json?
  // When ordering != SHUFFLE, Plex sorts the pool by this field/direction and the
  // scheduler preserves that order. `sortField` is a SORT_FIELDS key.
  sortField   String           @default("title")
  sortDir     String           @default("asc")

  // Provenance: auto-generated channels carry `generated=true` + the `presetKey`
  // they came from, so a regen deletes + rebuilds them without wiping manual channels.
  generated Boolean @default(false)
  presetKey String?
  // Distinct provenance for the AI assistant / workflow (separate from the static generator), so
  // those can be listed + cleanly reverted via `clear_ai_generated`.
  aiGenerated Boolean @default(false)

  // Where the rolling schedule build left off, so a WINDOWED build (a cheap 12h head
  // start instead of a full 300-day pass) can be continued mid-pass by `extend` instead
  // of restarting the pool from the top. A full `generateChannelSchedule` resets these.
  // `schedulePassSeed` pins the in-progress pass's seed — the builder normally folds
  // `startAt` into the seed, so without pinning it a resumed build would reshuffle
  // mid-pass. Stored SIGNED (`| 0`): Postgres Int is signed 32-bit and the seed is an
  // unsigned hash; the PRNG re-normalizes with `>>> 0` at use.
  schedulePassSeed  Int @default(0)
  schedulePassIndex Int @default(0)
  schedulePassPos   Int @default(0)

  // Thin per-channel bumper override; the global BumperConfig owns the content.
  bumperMode BumperMode @default(INHERIT)
  // The BumperConfig.rev this channel's schedule was last built under; Bumper Sync
  // rebuilds the channel when it falls behind the current config rev.
  bumperRev  Int        @default(0)

  mediaSourceId String
  mediaSource   MediaSource @relation(fields: [mediaSourceId], references: [id], onDelete: Cascade)

  packageId String?
  package   ChannelPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  definitions   ChannelDefinition[]
  scheduleItems ScheduleItem[]
  favorites     Favorite[]
  watchStates   ChannelWatchState[]
  watchSessions WatchSession[]
  userAccess    UserChannelAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([mediaSourceId])
  @@map("channel")
}

/// One clause of a channel's candidate pool. Multiple clauses combine
/// (INCLUDE/EXCLUDE) to support refinement + manual inclusions/exclusions.
model ChannelDefinition {
  id        String                @id @default(cuid())
  channelId String
  channel   Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  kind      ChannelDefinitionKind
  mode      DefinitionMode        @default(INCLUDE)
  sortIndex Int                   @default(0)

  // PREDICATE — a Plex filter query (resolved against Plex's API).
  // Jellyfin/Emby get our own filtering engine over a local metadata cache later.
  plexFilter     Json?
  plexLibraryKey String?

  // PLEX_COLLECTION / PLEX_PLAYLIST
  plexCollectionKey String?
  plexPlaylistKey   String?

  // MANUAL_ITEMS — explicit media-server item ids (ratingKeys)
  manualItemKeys String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channelId])
  @@map("channel_definition")
}
