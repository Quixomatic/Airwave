enum ScheduleItemKind {
  PROGRAM
  BUMPER
}

/// The materialized, server-authoritative timeline for a channel. Clients compute
/// "what's on now" as (now - startsAt). Regenerated on a rolling horizon.
model ScheduleItem {
  id        String           @id @default(cuid())
  channelId String
  channel   Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  kind      ScheduleItemKind @default(PROGRAM)

  startsAt        DateTime
  durationSeconds Int
  // offset into the underlying media file where playback begins (usually 0)
  startOffsetSeconds Int @default(0)

  ratingKey String // media-server item id to play

  // Metadata for display lives in the central MediaItem cache; slots point at it.
  mediaItemId String?
  mediaItem   MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([channelId, startsAt])
  @@index([mediaItemId])
  @@map("schedule_item")
}
