{
  "name": "@airwave/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "postinstall": "node -e \"process.exit(process.env.EAS_BUILD?0:1)\" || prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@airwave/env": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "catalog:",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@airwave/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "typescript": "catalog:"
  }
}
