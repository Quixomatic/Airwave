# Airwave on Unraid — .env for the Docker Compose Manager stack
#
# Pair this with the repo's docker-compose.yml (see README.md). It mirrors the full .env.example, tuned for
# Unraid: appdata bind paths, Unraid's nobody:users ids, and the default ports. Edit every CHANGE_ME value.

# --- Image ------------------------------------------------------------------
CG_IMAGE=ghcr.io/quixomatic/airwave:latest

# --- Where the apps are reachable FROM YOUR BROWSER / TV ---------------------
# Use this Unraid server's LAN IP (or a domain) + the published ports below. NOT "localhost".
SERVER_PUBLIC_URL=http://CHANGE_ME_UNRAID_IP:36020
WEB_PUBLIC_URL=http://CHANGE_ME_UNRAID_IP:36021

# --- Published host ports ---------------------------------------------------
SERVER_PORT=36020
WEB_PORT=36021

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=airwave
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=airwave

# --- Auth / security --------------------------------------------------------
# 32+ char random secret:  openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Runtime user / timezone (Unraid = nobody:users) ------------------------
PUID=99
PGID=100
UMASK=022
TZ=UTC

# --- Storage on appdata (Unraid) --------------------------------------------
# Postgres data as a bind path; PGDATA points to an empty subdir so initdb is happy on the dataset root.
POSTGRES_DATA_VOLUME=/mnt/user/appdata/airwave/pgdata
PGDATA=/var/lib/postgresql/data/pgdata
# Bumper-music library (container path is fixed at /data/bumper-music; this picks the host side).
BUMPER_MUSIC_VOLUME=/mnt/user/appdata/airwave/bumper-music

# --- Optional: extra admin origins for CORS + auth --------------------------
# EXTRA_CORS_ORIGINS=http://CHANGE_ME_UNRAID_IP:36021

# --- Optional: TV web player (browser) --------------------------------------
# Uncomment all four to run the 10-foot app as a browser player.
# COMPOSE_PROFILES=tvweb
# TV_WEB_PUBLIC_URL=http://CHANGE_ME_UNRAID_IP:36022
# TV_WEB_PORT=36022
# TV_SERVER_URL=https://airwave-tv.example.com

# --- Optional: social OAuth (set BOTH id + secret to enable a provider) ------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Optional: stable Plex client identifier --------------------------------
# PLEX_CLIENT_IDENTIFIER=

# --- Optional: durable AI-lineup workflow engine ----------------------------
# WORKFLOW_ENABLED=1

# --- Optional: Cloud Service (Airwave Cloud remote access) -------------------
# AIRWAVE_CLOUD_SERVICE_ENABLED=1
# AIRWAVE_WEB_ORIGIN=http://web:3001
# AIRWAVE_TVWEB_ORIGIN=http://tvweb:3002
