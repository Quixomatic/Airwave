{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airwave Client",
  "version": "0.13.3",
  "identifier": "com.airwave.tvdesktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3003",
    "beforeDevCommand": "pnpm dev:vite",
    "beforeBuildCommand": "pnpm build:vite"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Airwave",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNjk0M0UyNjU5ODkzQkEKUldTNms1aGw0a05wVDVvbldCZ2V0aE9Kd2x0eGQ5dDg0aWN0alR2WDJUdVBtYXdyK1BqSnlKSlQK",
      "endpoints": [
        "https://github.com/Quixomatic/Airwave/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
