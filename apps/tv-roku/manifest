title=Airwave

# Version — kept in lockstep with the other apps/* (see /version-bump). Mirrors package.json 0.12.0.
major_version=0
minor_version=13
build_version=3

# Icons = branded logo mark on the radial gradient (home-screen tile). Splash = a FLAT #060a14 fill (Roku
# requires a splash image, but ours hands off seamlessly to the in-app animated LogoLockup, which fades the
# wordmark up from black). All generated by scripts/gen-channel-art.py from images/logo.png.
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
mm_icon_focus_fhd=pkg:/images/icon_focus_fhd.png
splash_screen_hd=pkg:/images/splash_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_color=#060A14
splash_min_time=500

# Design/render at FHD (1920x1080); Roku downscales to 720 on HD boxes.
ui_resolutions=fhd
supports_input_launch=1
supports_voice_roinput=1
# NOTE: Roku will require rsg_version=1.3 for channels from 2026-10-01, but it raises the minimum firmware
# to v15.1 (big reach cut), so we hold off. Add `rsg_version=1.3` here + set dashboard Min Firmware v15.1
# when that deadline forces it. Until then this is a non-blocking Static Analysis warning.

bs_const=DEBUG=false
