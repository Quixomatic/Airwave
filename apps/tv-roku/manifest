title=Airwave
subtitle=Live TV from your library

# Version — kept in lockstep with the other apps/* (see /version-bump). Mirrors package.json 0.10.60.
major_version=0
minor_version=10
build_version=60

# Icons + splash — branded art (logo mark / mark+wordmark on the radial gradient), generated by
# scripts/gen-channel-art.py from images/logo.png. Re-run that script to regenerate at the Roku sizes.
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
mm_icon_focus_fhd=pkg:/images/icon_focus_fhd.png
splash_screen_hd=pkg:/images/splash_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_color=#0B1020
splash_min_time=500

# Design/render at FHD (1920x1080); Roku downscales to 720 on HD boxes.
ui_resolutions=fhd
supports_input_launch=1

bs_const=DEBUG=false
