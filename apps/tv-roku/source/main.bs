' Airwave — Roku client entry point.
' Creates the SceneGraph screen, shows MainScene, and runs the event loop.
sub Main(args as object)
    print "[Airwave] booting Roku client"

    ' Dev-only: pre-seed the server URL on a sideloaded build (no-op on a store install) so a
    ' re-sideload doesn't force re-onboarding. See source/lib/dev.bs.
    Dev.seedRegistry()

    screen = CreateObject("roSGScreen")
    m.port = CreateObject("roMessagePort")
    screen.setMessagePort(m.port)

    ' UI navigation sounds. roAudioResource is a MAIN-thread-only object (it can't be created on the render
    ' or task threads), so we own the resources HERE and let the UI trigger them through a global field:
    ' the zone machine sets `uiSound` to "<name>|<seq>" (the seq makes every value unique so repeats fire),
    ' and we Trigger the matching system sound. A sound the device lacks is a silent no-op. Set up the global
    ' field BEFORE CreateScene (the scene reads m.global; the node is available now).
    gnode = screen.getGlobalNode()
    gnode.addFields({ uiSound: "" })
    gnode.observeField("uiSound", m.port)
    sfx = {
        nav: CreateObject("roAudioResource", "navsingle"),
        select: CreateObject("roAudioResource", "select"),
        dead: CreateObject("roAudioResource", "deadend")
    }

    scene = screen.CreateScene("MainScene")
    screen.show()

    ' Deep linking (Roku cert): channels must handle roInput events. The manifest declares
    ' supports_input_launch=1; here we route both the initial launch args and any subsequent roInput
    ' events to the scene's `deepLink` field so it can act on a channel target if one is present.
    handleDeepLink(scene, args)
    input = CreateObject("roInput")
    input.SetMessagePort(m.port)

    ' Memory monitoring (Roku cert warnings): register for the OS low-memory event and read the channel's
    ' memory budget so we can react before the OS reaps us. WRAPPED IN try/catch — several of these
    ' roDeviceInfo methods only exist on newer firmware, and a missing member hard-crashes launch (&hf4).
    ' The store floor is v11, where try/catch is available, so this degrades gracefully on any real device.
    devInfo = CreateObject("roDeviceInfo")
    devInfo.SetMessagePort(m.port)
    m.devInfo = devInfo
    try
        devInfo.EnableLowGeneralMemoryEvent(true)
        devInfo.EnableMemoryWarningEvent(true)
        print "[Airwave] memory limitPct="; devInfo.GetMemoryLimitPercent(); " channelLimit="; devInfo.GetChannelMemoryLimit(); " available="; devInfo.GetChannelAvailableMemory()
    catch e
        print "[Airwave] memory monitoring: some APIs unavailable on this firmware ("; e.message; ")"
    end try

    ' Standard SceneGraph render loop — exit when the screen closes.
    while true
        msg = wait(0, m.port)
        mt = type(msg)
        if mt = "roSGScreenEvent"
            if msg.isScreenClosed() then return
        else if mt = "roInputEvent"
            ' A deep link arrived while running (or a voice/ECP input). Route it to the scene.
            if msg.IsInput() then handleDeepLink(scene, msg.GetInfo())
        else if mt = "roDeviceInfoEvent"
            info = msg.GetInfo()
            if type(info) = "roAssociativeArray" then print "[Airwave] roDeviceInfo event: "; FormatJson(info)
        else if mt = "roSGNodeEvent"
            if msg.getField() = "uiSound"
                val = msg.getData()
                sep = Instr(1, val, "|")
                if sep > 1
                    name = Left(val, sep - 1)
                    snd = sfx[name]
                    if snd <> invalid then snd.Trigger(50)
                end if
            end if
        end if
    end while
end sub

' Pass a launch/roInput payload to the scene. Roku sends deep-link params as { contentId, mediaType }.
' We only surface a channel target; the scene decides what to do (tune it once the guide is up). A launch
' with no recognizable params is a normal cold start — a no-op here, which is the required graceful handling.
sub handleDeepLink(scene as object, params as object)
    if scene = invalid or type(params) <> "roAssociativeArray" then return
    cid = params.contentId
    if cid <> invalid and cid <> "" then scene.deepLink = cid
end sub
