' Airwave — Roku client entry point.
' Creates the SceneGraph screen, shows MainScene, and runs the event loop.
sub Main(args as object)
    print "[Airwave] booting Roku client"

    ' Dev-only: pre-seed the server URL on a sideloaded build (no-op on a store install) so a
    ' re-sideload doesn't force re-onboarding. See source/lib/dev.bs.
    ' TEMPORARILY OFF (2026-08-29) — the seed kept re-populating the stored server URL; re-enable
    ' when back to iterating against the dev server.
    ' Dev.seedRegistry()

    ' Dev-only: wipe the remembered login email each boot so the form starts empty while testing the
    ' sign-in flow. Uncomment to re-enable; leave commented to keep remember-email working.
    ' Dev.clearRememberedEmail()

    screen = CreateObject("roSGScreen")
    m.port = CreateObject("roMessagePort")
    screen.setMessagePort(m.port)

    ' UI navigation sounds. roAudioResource is a MAIN-thread-only object (it can't be created on the render
    ' or task threads), so we own the resources HERE and let the UI trigger them through a global field:
    ' the zone machine sets `uiSound` to "<name>|<seq>" (the seq makes every value unique so repeats fire),
    ' and we Trigger the matching system sound. A sound the device lacks is a silent no-op. Set up the global
    ' field BEFORE CreateScene (the scene reads m.global; the node is available now).
    gnode = screen.getGlobalNode()
    gnode.addFields({ uiSound: "" })
    gnode.observeField("uiSound", m.port)
    sfx = {
        nav: CreateObject("roAudioResource", "navsingle"),
        select: CreateObject("roAudioResource", "select"),
        dead: CreateObject("roAudioResource", "deadend")
    }

    scene = screen.CreateScene("MainScene")
    screen.show()

    ' Deep linking (Roku cert 5.2): pass the COLD-START launch params to the scene. The manifest declares
    ' supports_input_launch=1 (+ supports_voice_roinput=1); WHILE-RUNNING roInput events + memory monitoring
    ' are owned by components/tasks/InputTask (SceneGraph Task) — Roku's channel analyzer scans the
    ' components/ tree, not source/main.brs, so the roInput/roDeviceInfo usage has to live in a component.
    handleDeepLink(scene, args)

    ' Standard SceneGraph render loop — exit when the screen closes.
    while true
        msg = wait(0, m.port)
        mt = type(msg)
        if mt = "roSGScreenEvent"
            if msg.isScreenClosed() then return
        else if mt = "roSGNodeEvent"
            if msg.getField() = "uiSound"
                val = msg.getData()
                sep = Instr(1, val, "|")
                if sep > 1
                    name = Left(val, sep - 1)
                    snd = sfx[name]
                    if snd <> invalid then snd.Trigger(50)
                end if
            end if
        end if
    end while
end sub

' Pass a cold-start launch payload to the scene. Roku sends deep-link params as { contentId, mediaType }.
' We only surface a channel target; the scene tunes it once the guide is up. A launch with no recognizable
' params is a normal cold start — a no-op, which is the required graceful handling.
sub handleDeepLink(scene as object, params as object)
    if scene = invalid or type(params) <> "roAssociativeArray" then return
    cid = params.contentId
    if cid <> invalid and cid <> "" then scene.deepLink = cid
end sub
