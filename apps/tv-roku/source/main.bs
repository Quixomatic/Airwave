' Airwave — Roku client entry point.
' Creates the SceneGraph screen, shows MainScene, and runs the event loop.
sub Main()
    print "[Airwave] booting Roku client"

    ' Dev-only: pre-seed the server URL on a sideloaded build (no-op on a store install) so a
    ' re-sideload doesn't force re-onboarding. See source/lib/dev.bs.
    Dev.seedRegistry()

    screen = CreateObject("roSGScreen")
    m.port = CreateObject("roMessagePort")
    screen.setMessagePort(m.port)

    screen.CreateScene("MainScene")
    screen.show()

    ' Standard SceneGraph render loop — exit when the screen closes.
    while true
        msg = wait(0, m.port)
        if type(msg) = "roSGScreenEvent"
            if msg.isScreenClosed() then return
        end if
    end while
end sub
