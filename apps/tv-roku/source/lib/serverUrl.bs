import "pkg:/source/lib/registry.bs"

' Server URL helpers — direct port of tv-web lib/server-url.ts.
' The app talks to a self-hosted Airwave server at a per-user address, chosen once during
' onboarding, validated against /api/health, and stored in the registry.
namespace ServerUrl

    ' Coerce user input into a usable base URL: strip trailing slashes, add a scheme if missing.
    ' Scheme by host: LAN (localhost / IPv4 / *.local) -> http; a real domain -> https.
    ' Defaulting a domain to http is a silent trap: an http URL to an https server 301s, and a
    ' redirected POST becomes a GET, so POST-only auth endpoints 404 (health is a GET, so it
    ' survives and onboarding wrongly "connects"). See the webOS 404 debug (tv-web v0.10.16).
    function normalize(raw as string) as string
        u = raw.trim()
        u = CreateObject("roRegex", "/+$", "").replaceAll(u, "")
        if u = "" then return ""
        if CreateObject("roRegex", "^https?://", "i").isMatch(u) then return u

        host = ""
        hostMatch = CreateObject("roRegex", "^[^/:]+", "").match(u)
        if hostMatch.count() > 0 then host = LCase(hostMatch[0])

        isIp = CreateObject("roRegex", "^\d{1,3}(\.\d{1,3}){3}$", "").isMatch(host)
        isLocal = CreateObject("roRegex", "\.local$", "i").isMatch(host)
        if host = "localhost" or isIp or isLocal then return "http://" + u
        return "https://" + u
    end function

    function get() as string
        return CreateObject("roRegex", "/+$", "").replaceAll(Registry.read(RegKey.SERVER_URL), "")
    end function

    sub set(url as string)
        Registry.write(RegKey.SERVER_URL, normalize(url))
    end sub

    sub clear()
        Registry.delete(RegKey.SERVER_URL)
    end sub

    function has() as boolean
        return get() <> ""
    end function
end namespace
