{
  "name": "tv-roku",
  "version": "0.13.3",
  "private": true,
  "description": "Airwave Roku client (BrighterScript + SceneGraph). A direct port of tv-web/tv-native to Roku — strict visual + functional parity, its own separately-maintained codebase.",
  "scripts": {
    "build": "bsc",
    "presideload": "bsc",
    "sideload": "roku-deploy",
    "genkey": "bun run scripts/roku-genkey.ts",
    "package": "bsc && bun run scripts/package-roku.ts",
    "grab-screenshot": "bun run scripts/grab-screenshot.ts",
    "format": "bsfmt \"**/*.{bs,brs,xml}\" --write",
    "format:check": "bsfmt \"**/*.{bs,brs,xml}\" --check",
    "clean": "rimraf out"
  },
  "dependencies": {
    "@rokucommunity/bslib": "^0.1.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@rokucommunity/bslint": "^0.8.44",
    "brighterscript": "^0.73.0",
    "brighterscript-formatter": "^1.8.1",
    "bsc-plugin-auto-findnode": "^0.1.6",
    "lucide-static": "^1.31.0",
    "rimraf": "^6.0.1",
    "roku-deploy": "^3.18.2"
  }
}
