# =============================================================================
# Airwave — SIGN-OUT script  (Roku Channel Behavior Analysis)
# =============================================================================
# From the channel guide: open the sidebar (LEFT), go to the Account / User settings
# page, and Sign out (two-tap confirm). This returns the channel to its logged-out
# state for the next automated test run.
#
# Re-record if the guide sidebar / Settings UI changes. See apps/tv-roku/cert/README.md.
# =============================================================================
params:
  rasp_version: 1
  default_keypress_wait: 2
  channels:
    # "878438" = the published channel ID — Channel Behavior Analysis runs against this.
    # Change to "dev" to re-record/test against a locally SIDELOADED build.
    Airwave: "878438"
steps:
  - launch: Airwave
  - press: left
  - press: left
  - press: left
  - press: left
  - press: left
  - press: left
  - press: left
  - press: left
  - press: left
  - press: left
  - press: down
  - press: down
  - press: ok
  - press: ok
  - press: ok
