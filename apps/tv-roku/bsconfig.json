{
  "rootDir": "./",
  "files": [
    "manifest",
    "source/**/*.*",
    "components/**/*.*",
    "images/**/*.*",
    "locale/**/*.*"
  ],
  "stagingDir": "./out/staging",
  "retainStagingDir": true,
  "createPackage": false,
  "autoImportComponentScript": true,
  "sourceMap": true,
  "plugins": ["@rokucommunity/bslint"],
  "diagnosticFilters": [
    { "src": "source/vendor/**/*" },
    { "src": "components/vendor/**/*" }
  ]
}
