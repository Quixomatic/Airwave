' VirtualRowList code-behind. See the .xml header. Owns: the row pool, the scroll offset (m.scrollY), and
' the modulo-slot recycling. The owner sets content + geometry + focusIndex/focusProgramIndex/zone.

sub init()
    m.rows = []          ' the pooled row nodes (index = slot)
    m.rowAbs = []        ' the absolute channel index currently bound to each slot (-1 = unbound)
    m.scrollY = 0.0
    m.built = false
end sub

' Geometry / itemComponent arrived (or changed) — (re)build the pool once all are known.
sub onGeom()
    buildPool()
end sub

sub buildPool()
    if m.built then return
    rowH = m.top.rowHeight
    vpH = m.top.viewportHeight
    comp = m.top.itemComponent
    if rowH <= 0 or vpH <= 0 or comp = invalid or comp = "" then return

    clipW = m.top.clipWidth
    if clipW <= 0 then clipW = 1920
    m.viewport.clippingRect = [0, 0, clipW, vpH]

    poolN = Int(vpH / rowH) + 2
    for i = 0 to poolN - 1
        row = m.viewport.createChild(comp)
        m.rows.push(row)
        m.rowAbs.push(-1)
    end for
    m.built = true
    relayout()
end sub

' New content (a lens switch OR the 60s refresh). PRESERVE the scroll position — the 60s refresh must NOT
' yank the user to the top. Just force a re-bind + clamp to the new content. A lens change resets fc, so the
' owner's focusIndex change re-scrolls to the top via onFocusIndex; the refresh keeps fc, so we stay put.
sub onContentChange()
    for i = 0 to m.rowAbs.count() - 1
        m.rowAbs[i] = -1
    end for
    if not m.built
        buildPool()
        return
    end if
    clampScroll()
    relayout()
end sub

sub clampScroll()
    content = m.top.content
    if content = invalid then return
    maxScroll = content.getChildCount() * m.top.rowHeight - m.top.viewportHeight
    if maxScroll < 0 then maxScroll = 0
    if m.scrollY > maxScroll then m.scrollY = maxScroll
    if m.scrollY < 0 then m.scrollY = 0
end sub

' fc changed → scroll only if the focused row is off-screen (float-then-snap), then re-lay-out.
sub onFocusIndex()
    if not m.built then return
    content = m.top.content
    if content = invalid then return
    rowH = m.top.rowHeight
    vpH = m.top.viewportHeight
    count = content.getChildCount()
    maxScroll = count * rowH - vpH
    if maxScroll < 0 then maxScroll = 0

    fc = m.top.focusIndex
    top# = fc * rowH
    bottom# = top# + rowH
    if top# < m.scrollY
        m.scrollY = top#                       ' above the viewport → top-align
    else if bottom# > m.scrollY + vpH
        m.scrollY = bottom# - vpH               ' below the viewport → bottom-align
    end if
    if m.scrollY < 0 then m.scrollY = 0
    if m.scrollY > maxScroll then m.scrollY = maxScroll
    relayout()
end sub

' fp / zone / favVersion changed → just re-apply focus to the visible rows (no scroll, no re-bind).
sub forwardFocus()
    if not m.built then return
    relayout()
end sub

' Position + bind the pool over the window [first, first+poolN). Modulo slot mapping means a 1-row scroll
' re-binds exactly one slot; the rest only get a new translation + focus state.
sub relayout()
    content = m.top.content
    if content = invalid then return
    count = content.getChildCount()
    rowH = m.top.rowHeight
    poolN = m.rows.count()
    if poolN = 0 then return

    first = Int(m.scrollY / rowH)
    for k = 0 to poolN - 1
        abso = first + k
        slot = abso mod poolN
        row = m.rows[slot]
        if abso >= 0 and abso < count
            if m.rowAbs[slot] <> abso
                row.itemContent = content.getChild(abso)
                m.rowAbs[slot] = abso
            end if
            row.translation = [0, abso * rowH - m.scrollY]
            row.visible = true
            applyFocus(row, abso)
        else
            row.visible = false
            m.rowAbs[slot] = -1
        end if
    end for
end sub

' Push the focus/favorited state onto a bound row (the owner keeps fc/fp/zone; we translate them per row).
sub applyFocus(row as object, abso as integer)
    fc = m.top.focusIndex
    isF = (abso = fc)
    row.focused = isF
    row.railFocused = (isF and m.top.zone = "rail")
    ' The program focus ring shows ONLY in the grid zone — moving onto the rail (or sidebar) clears it.
    if isF and m.top.zone = "grid" then row.focusProgramIndex = m.top.focusProgramIndex else row.focusProgramIndex = -1

    fav = false
    favs = m.global.guideFavorites
    if favs <> invalid and row.itemContent <> invalid and row.itemContent.channel <> invalid
        id = row.itemContent.channel.id
        if id <> invalid and favs.doesExist(id) then fav = true
    end if
    row.favorited = fav
end sub
