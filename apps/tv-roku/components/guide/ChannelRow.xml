<?xml version="1.0" encoding="utf-8" ?>
<!--
  ChannelRow — one guide row: the channel rail (tinted icon circle + number + name) and the program lane
  (blocks positioned by time; the on-now block gets the 2-tone elapsed/remaining fill + accent bar).
  Ported from tv-web/tv-native aurora-grid Row. Driven by VirtualRowList (not MarkupList): itemContent
  carries { channel, accentHex }; the focus fields are set explicitly by the zone machine (not focusPercent).
  nowMs / T0Ms travel on m.global.
-->
<component name="ChannelRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <!-- This row is the focused channel (fc) → rail tint + accent bar. -->
        <field id="focused" type="boolean" onChange="onRailState" />
        <!-- zone == rail on the focused channel → the circle becomes the favorite heart + blue ring. -->
        <field id="railFocused" type="boolean" onChange="onRailState" />
        <!-- This channel is favorited → heart badge on the circle (or filled heart when rail-focused). -->
        <field id="favorited" type="boolean" onChange="onRailState" />
        <!-- The focused program cell (fp) on the focused row → blue focus ring; -1 = none. -->
        <field id="focusProgramIndex" type="integer" value="-1" onChange="onProgramFocus" />
    </interface>
</component>
