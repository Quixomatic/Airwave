import "pkg:/source/lib/guideLayout.bs"
import "pkg:/source/lib/tint.bs"

' GuideSidebar code-behind. See the .xml header. Builds the action circles (fixed) + a filter list (from the
' packages + lenses), handles the collapsed↔expanded swap, D-pad focus rings, and the filter-list snap-scroll.
' (m.<id> auto-injected: bg, rightBorder, actions, divider, collapsedFilter, filterClip, filters.)

const SB_SLIVER = 92
const SB_EXPANDED = 300
const SB_PADH = 18
const SB_PADV = 24
const SB_GAP = 14
const SB_CIRCLE = 54
const SB_RING_ROOM = 8    ' extra room inside the filter clip so focus rings aren't cut on the left/top/bottom

sub init()
    m.actionKeys = ["all", "settings", "account"]
    m.actionBtns = []
    m.filterBtns = []
    m.items = []
    m.filterScrollY = 0

    ' Action circles (fixed): Guide (= the "all" lens), Settings, Account.
    defs = [{ label: "Guide", icon: "lucide:Menu" }, { label: "Settings", icon: "lucide:Settings" }, { label: "Account", icon: "lucide:User" }]
    y = SB_PADV
    for each d in defs
        b = m.actions.createChild("GlassCircleButton")
        b.translation = [SB_PADH, y]
        b.iconId = d.icon
        b.label = d.label
        m.actionBtns.push(b)
        y = y + SB_CIRCLE + SB_GAP
    end for
    m.dividerY = y - SB_GAP + 12
    m.divider.translation = [SB_PADH, m.dividerY]

    ' Collapsed: a single Filters circle. Expanded: the filter list in filterClip.
    m.filtersCircle = m.collapsedFilter.createChild("GlassCircleButton")
    m.filtersCircle.translation = [SB_PADH, m.dividerY + 12]
    m.filtersCircle.iconId = "lucide:ListFilter"

    ' The filter list clips to its viewport, but extend the clip outward by RING_ROOM on the left/top/bottom
    ' (shift the clip origin, offset the content back) so the focus rings — drawn ~4px outside each circle —
    ' aren't cut on the left, or top/bottom for the first/last circle (matches tv-web/native).
    m.filterTop = m.dividerY + 12
    m.vpH = GuideLayout.STAGE_H - m.filterTop - SB_PADV
    m.filterClip.translation = [SB_PADH - SB_RING_ROOM, m.filterTop - SB_RING_ROOM]
    m.filterClip.clippingRect = [0, 0, SB_EXPANDED, m.vpH + 2 * SB_RING_ROOM]
    m.filters.translation = [SB_RING_ROOM, SB_RING_ROOM]

    refresh()
end sub

' Packages or lens changed → rebuild the filter list (Show All appears only when a filter is applied).
sub rebuild()
    while m.filters.getChildCount() > 0
        m.filters.removeChildIndex(0)
    end while
    m.filterBtns = []
    m.items = []
    for i = 0 to m.actionBtns.count() - 1
        m.items.push({ key: m.actionKeys[i], group: "action" })
    end for

    filtered = (m.top.lens <> "all" and m.top.lens <> "")
    fdefs = []
    if filtered then fdefs.push({ key: "all", label: "Show All", icon: "lucide:LayoutGrid", sub: invalid, accent: invalid })
    fdefs.push({ key: "favorites", label: "Favorites", icon: "lucide:Star", sub: invalid, accent: invalid })
    fdefs.push({ key: "recents", label: "Recents", icon: "lucide:History", sub: invalid, accent: invalid })
    pkgs = m.top.packages
    if pkgs <> invalid
        for each p in pkgs
            icon = p.icon
            if icon = invalid or icon = "" then icon = "lucide:Folder"
            cnt = p.channelCount
            if cnt = invalid then cnt = 0
            unit = " channels"
            if cnt = 1 then unit = " channel"
            accent = "0x3B82F6FF"
            if p.tint <> invalid and p.tint <> ""
                vivid = Tint.vividOf(p.tint)
                if vivid <> "" then accent = "0x" + vivid + "FF"
            end if
            fdefs.push({ key: "pkg:" + p.id, label: p.name, icon: icon, sub: Str(cnt).Trim() + unit, accent: accent })
        end for
    end if

    y = 0
    for each d in fdefs
        b = m.filters.createChild("GlassCircleButton")
        b.id = "fbtn" + Str(m.filterBtns.count()).Trim()   ' stable id so the stagger interpolators can target it
        b.translation = [0, y]
        b.iconId = d.icon
        b.label = d.label
        if d.sub <> invalid then b.sublabel = d.sub
        if d.accent <> invalid then b.accent = d.accent
        m.filterBtns.push(b)
        m.items.push({ key: d.key, group: "filter" })
        y = y + SB_CIRCLE + SB_GAP
    end for

    m.top.itemCount = m.items.count()
    refresh()
end sub

sub onLens()
    rebuild()
end sub

sub onExpand()
    ex = m.top.expanded
    if ex
        m.widthI.keyValue = [SB_SLIVER, SB_EXPANDED]
        m.borderI.keyValue = [[SB_SLIVER, 0], [SB_EXPANDED, 0]]
        m.scrimI.keyValue = [0.0, 0.55]
        m.dividerI.keyValue = [SB_SLIVER - 2 * SB_PADH, SB_EXPANDED - 2 * SB_PADH]
    else
        m.widthI.keyValue = [m.bg.width, SB_SLIVER]
        m.borderI.keyValue = [[m.bg.width, 0], [SB_SLIVER, 0]]
        m.scrimI.keyValue = [m.scrim.opacity, 0.0]
        m.dividerI.keyValue = [m.divider.width, SB_SLIVER - 2 * SB_PADH]
    end if
    m.expandAnim.control = "start"
    refresh()
    if ex then staggerFilters()
end sub

' Staggered reveal of the filter circles as the sidebar opens (tv-web/native): each fades in + slides up in
' turn. One Animation with per-button interpolators (targeting each circle by its id, offset key timing).
sub staggerFilters()
    anim = m.staggerAnim
    anim.control = "stop"
    while anim.getChildCount() > 0
        anim.removeChildIndex(0)
    end while
    n = m.filterBtns.count()
    if n = 0 then return

    stagger = 0.04                    ' seconds between successive circles
    span = 0.3                        ' each circle's own fade/slide span
    slide = GuideLayout.vw(10)        ' how far each circle rises into place
    total = span + stagger * (n - 1)
    anim.duration = total
    for i = 0 to n - 1
        b = m.filterBtns[i]
        b.opacity = 0
        t0 = (stagger * i) / total
        t1 = (stagger * i + span) / total
        if t1 > 1 then t1 = 1
        yRest = i * (SB_CIRCLE + SB_GAP)
        fade = anim.createChild("FloatFieldInterpolator")
        fade.fieldToInterp = b.id + ".opacity"
        fade.key = [t0, t1]
        fade.keyValue = [0.0, 1.0]
        rise = anim.createChild("Vector2DFieldInterpolator")
        rise.fieldToInterp = b.id + ".translation"
        rise.key = [t0, t1]
        rise.keyValue = [[0, yRest + slide], [0, yRest]]
    end for
    anim.control = "start"
end sub

sub onFocus()
    scrollFilters()
    refresh()
end sub

sub onSel()
    scrollFilters()
    refresh()
end sub

sub onActivate()
    if m.top.sel < 0 or m.top.sel >= m.items.count() then return
    m.top.activated = m.items[m.top.sel].key
end sub

' Apply expanded / active / focus state to every button + the collapsed swap.
sub refresh()
    ex = m.top.expanded
    lens = m.top.lens
    focused = m.top.focused
    sel = m.top.sel

    for i = 0 to m.actionBtns.count() - 1
        b = m.actionBtns[i]
        b.expanded = ex
        b.active = (m.actionKeys[i] = lens)
        b.focused = (focused and sel = i)
    end for
    base = m.actionBtns.count()
    for i = 0 to m.filterBtns.count() - 1
        b = m.filterBtns[i]
        b.expanded = ex
        b.active = (base + i < m.items.count() and m.items[base + i].key = lens)
        b.focused = (focused and sel = base + i)
    end for

    m.collapsedFilter.visible = not ex
    m.filterClip.visible = ex
    m.filtersCircle.active = (lens <> "all" and lens <> "")
    ' bg.width / rightBorder / divider.width are owned by the expand animation (onExpand), not set here.
end sub

' Snap-scroll the filter list so the selected filter circle stays on-screen (grid parity).
sub scrollFilters()
    if not m.top.focused then return
    base = m.actionBtns.count()
    fi = m.top.sel - base
    if fi < 0 then return
    rowH = SB_CIRCLE + SB_GAP
    top = fi * rowH
    bottom = top + SB_CIRCLE
    if top < m.filterScrollY
        m.filterScrollY = top
    else if bottom > m.filterScrollY + m.vpH
        m.filterScrollY = bottom - m.vpH
    end if
    if m.filterScrollY < 0 then m.filterScrollY = 0
    m.filters.translation = [SB_RING_ROOM, SB_RING_ROOM - m.filterScrollY]
end sub
