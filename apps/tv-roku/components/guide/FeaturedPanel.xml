<?xml version="1.0" encoding="utf-8" ?>
<!--
  FeaturedPanel — the now/next detail panel above the guide grid (port of tv-native aurora-grid
  FeaturedPanel, left text column; the right side is the mini-player dock in Phase 7). Shows the
  focused channel + program. Driven by `content` = a ContentNode carrying { channel, program,
  accentHex }. All sizes are fv() (FEATURE_SCALE 0.76). Fonts + positions applied in code.
-->
<component name="FeaturedPanel" extends="Group">
    <interface>
        <field id="content" type="node" onChange="onContent" />
        <!-- Width reserved on the RIGHT for the mini-player dock (Phase 7). 0 = text column uses the
             full width; when the mini docks, the text column shrinks by this much (tv-native flex:1). -->
        <field id="rightReserve" type="float" onChange="onReserve" />
    </interface>
    <children>
        <Poster id="circle" uri="pkg:/images/circle.png" />
        <Poster id="ring" uri="pkg:/images/circle-ring.png" />
        <Label id="glyph" />
        <Label id="chNum" />
        <Label id="chName" />
        <Label id="genre" />
        <Rectangle id="divider" color="0x94A3B824" height="1" />
        <Label id="title" />
        <!-- Plain Group (NOT LayoutGroup): the badge pills are positioned by hand so their height +
             vertical center are exactly what we set — a LayoutGroup re-centers children within bounds it
             computes itself, which threw the pills off (same fix as the diagnostic chips). -->
        <Group id="badges" />
        <Label id="meta" />
        <Label id="summary" wrap="true" maxLines="2" />
        <Label id="timeRange" />
        <Label id="status" horizAlign="right" />
        <!-- Progress bar = a thin (~4px) pill. fill-2 (2px radius = half the bar height) gives clean
             rounded ends; fill-8's 8px radius collapsed on a 4px bar. Matches tv-web/native borderRadius:999. -->
        <Poster id="progTrack" uri="pkg:/images/np/fill-2.9.png" blendColor="0x94A3B82E" />
        <Poster id="progFill" uri="pkg:/images/np/fill-2.9.png" blendColor="0x3B82F6FF" />
    </children>
</component>
