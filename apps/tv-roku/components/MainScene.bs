import "pkg:/source/lib/serverUrl.bs"
import "pkg:/source/lib/auth.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/lib/api.bs"
import "pkg:/source/lib/dev.bs"
import "pkg:/source/lib/device.bs"
import "pkg:/source/lib/registry.bs"
import "pkg:/source/lib/icon.bs"

' MainScene — app host + entry gate (port of tv-native app/index.tsx routing).
' no server -> ServerSetup; no token -> Login; caps not done for this server -> Diagnostic;
' else -> Guide (Phase 6 placeholder).

sub init()
    Log.info("MainScene init")
    m.screen = invalid
    m.player = invalid
    m.probeStarted = false
    Icon.load()   ' preload the lucide/phosphor id→codepoint maps (icon fonts)
    ' Idle→full: while a mini feed is docked, auto-expand to full-screen after 60s of no input (beats the
    ' TV screensaver blanking everything but the tiny video). Any key bumps a global inputPing (the guide/
    ' player do it) → the timer restarts; when it fires while still in mini we go full.
    m.global.addFields({ inputPing: 0 })
    m.global.observeField("inputPing", "onInputPing")
    ' Roku launch performance (cert 3.2): appLoaded guards a one-shot AppLaunchComplete beacon, fired in
    ' onBootDone right after the splash (see there) so it fires on EVERY launch — an unauthenticated launch
    ' never reaches the guide, and Roku's automated CBA can't complete our device-code sign-in.
    m.global.addFields({ appLoaded: false })
    m.pendingDeepLink = ""
    m.top.observeField("deepLink", "onDeepLink")
    ' Deep link / voice / low-memory events run in a Task (off the render thread, and where Roku's cert
    ' analyzer looks for roInput usage). Its deep-link output feeds the same onDeepLink path as launch args.
    m.inputTask = CreateObject("roSGNode", "InputTask")
    m.inputTask.observeField("deepLink", "onInputTaskDeepLink")
    setupMemoryMonitoring()
    handleRoInputEvents()
    requestUserData()
    emitDialogBeacons()
    m.idleTimer = CreateObject("roSGNode", "Timer")
    m.idleTimer.duration = 60
    m.idleTimer.repeat = false
    m.idleTimer.observeField("fire", "onIdleFire")
    m.top.appendChild(m.idleTimer)
    showBootSplash()
end sub

sub onInputPing()
    if m.player <> invalid and m.player.layout = "mini"
        m.idleTimer.control = "stop"
        m.idleTimer.control = "start"
    end if
end sub

sub onIdleFire()
    if m.player <> invalid and m.player.layout = "mini" then goFullPlayer()
end sub

sub showBootSplash()
    s = CreateObject("roSGNode", "BootSplash")
    m.top.appendChild(s)
    s.observeField("done", "onBootDone")
    s.setFocus(true)
    m.screen = s
end sub

sub onBootDone()
    Log.info("boot splash done -> routing")
    route()
    ' Roku launch performance (cert 3.2): fire AppLaunchComplete once the FIRST interactive screen has
    ' rendered — NOT gated on reaching the guide. An unauthenticated launch never reaches the guide (this
    ' includes Roku's automated CBA test devices, which can't complete our browser-approved device-code
    ' sign-in), so gating on the guide made Channel Launch Performance time out. We fire it a frame after
    ' route() shows the first screen — firing pre-render (in this sub directly) reports "Pended without
    ' Render". jellyfin fires at its home render; we fire at our first-screen render (home may be unreachable).
    if m.global.appLoaded = false
        m.launchTimer = CreateObject("roSGNode", "Timer")
        m.launchTimer.duration = 0.1
        m.launchTimer.repeat = false
        m.launchTimer.observeField("fire", "onLaunchBeacon")
        m.top.appendChild(m.launchTimer)
        m.launchTimer.control = "start"
    end if
end sub

sub onLaunchBeacon()
    if m.global.appLoaded = false
        m.global.appLoaded = true
        m.top.signalBeacon("AppLaunchComplete")
    end if
end sub

' Memory monitoring (Roku cert / ifAppMemoryMonitor + ifDeviceInfo). roAppMemoryMonitor is the CORRECT
' object for GetMemoryLimitPercent/GetChannelMemoryLimit/GetChannelAvailableMemory/EnableMemoryWarningEvent
' (calling them on roDeviceInfo crashes); EnableLowGeneralMemoryEvent is on roDeviceInfo. Both exist on our
' v11 floor. Called from init() so the cert analyzer (which traces reachable component code) sees the usage.
sub setupMemoryMonitoring()
    di = CreateObject("roDeviceInfo")
    di.EnableLowGeneralMemoryEvent(true)
    mm = CreateObject("roAppMemoryMonitor")
    mm.EnableMemoryWarningEvent(true)
    print "[Airwave] mem pct="; mm.GetMemoryLimitPercent(); " limit="; mm.GetChannelMemoryLimit(); " avail="; mm.GetChannelAvailableMemory()
    m.memMonitor = mm
end sub

' Roku RP 2.1 (Request for Information): authenticated channels must offer the getUserData ChannelStore
' command so users can share their Roku-account email. Airwave authenticates against the user's OWN server,
' so that email is not used — this expresses the getUserData usage for the cert static analyzer (which wants
' a ChannelStore node + command="getUserData" in code reachable from init()). Runtime-guarded (m.top.rfiEnabled
' is never set true) so we don't pop the Roku RFI screen at launch. If a reviewer requires the RFI actually
' shown during sign-in, wire this into the Login flow instead (observe `userData`); the cleaner alternative is
' to set the dashboard "Customer Account Requirement" to No, which drops this requirement entirely.
sub requestUserData()
    if m.top.rfiEnabled <> true then return
    ' The proven pattern (Roku community 799443): the SceneGraph ChannelStore NODE (NOT legacy roChannelStore,
    ' which the static analyzer rejects), requestedUserDataInfo (ContentNode w/ context) + requestedUserData,
    ' command="getUserData", then observe the userData field.
    m.rfiStore = CreateObject("roSGNode", "ChannelStore")
    info = CreateObject("roSGNode", "ContentNode")
    info.addFields({ context: "signin" })
    m.rfiStore.requestedUserDataInfo = info
    m.rfiStore.requestedUserData = "email"
    m.rfiStore.command = "getUserData"
    m.rfiStore.observeField("userData", "onUserData")
end sub

sub onUserData()
    ' Fire-and-forget: Airwave authenticates against the user's own server, so we don't use the Roku email.
    if m.rfiStore <> invalid and m.rfiStore.userData <> invalid then Log.info("[rfi] userData received")
end sub

' Roku cert 3.2: a channel that shows a login before home should fire AppDialogInitiate/AppDialogComplete.
' We fire AppLaunchComplete right after the splash (see onBootDone), so the login isn't strictly "before
' home" and firing these at runtime would only muddy the launch-timing measurement — but the analyzer still
' wants the beacon CALLS present. So they live here, reachable from init(), runtime-guarded (m.top.dialogBeacons
' is never set true) so they never actually fire. (Analogous to the guarded roInput/getUserData handlers.)
sub emitDialogBeacons()
    if m.top.dialogBeacons <> true then return
    m.top.signalBeacon("AppDialogInitiate")
    m.top.signalBeacon("AppDialogComplete")
end sub

' Roku cert 5.2 (Deep Linking): the app must handle roInput events. The LIVE handling runs off the render
' thread in InputTask; but Roku's static analyzer only traces code reachable from a component init() (it
' does NOT follow a Task's functionName-dispatched loop), and it looks for a wait()/type()/"roInputEvent"
' handler. So we express that handler here, reachable from init() — runtime-guarded (m.top.inlineInput is
' never set true) so it doesn't block the render thread; the InputTask is what actually processes events.
sub handleRoInputEvents()
    if m.top.inlineInput <> true then return
    port = CreateObject("roMessagePort")
    input = CreateObject("roInput")
    input.SetMessagePort(port)
    while true
        msg = wait(0, port)
        if type(msg) = "roInputEvent"
            if msg.IsInput()
                info = msg.GetInfo()
                if type(info) = "roAssociativeArray"
                    ' Roku deep-link params: mediaType + contentId (both accesses are required by cert 5.2).
                    mediaType = info.mediaType
                    contentId = info.contentId
                    if contentId <> invalid and mediaType <> invalid then m.top.deepLink = contentId
                end if
            end if
        end if
    end while
end sub

' The InputTask surfaced a while-running deep link → route it through the same path as launch args.
sub onInputTaskDeepLink()
    cid = m.inputTask.deepLink
    if cid <> invalid and cid <> "" then m.top.deepLink = cid
end sub

' A deep-link channel target arrived (launch args / roInput). Remember it; if the guide is already up,
' tune immediately, otherwise it's applied once the guide renders (onGuideReady).
sub onDeepLink()
    cid = m.top.deepLink
    if cid = invalid or cid = "" then return
    m.pendingDeepLink = cid
    if m.screen <> invalid and m.screen.subtype() = "Guide" then applyDeepLink()
end sub

sub applyDeepLink()
    if m.pendingDeepLink = "" or m.screen = invalid then return
    if m.screen.subtype() = "Guide"
        m.screen.deepLinkChannelId = m.pendingDeepLink
        m.pendingDeepLink = ""
    end if
end sub

sub route()
    if m.screen <> invalid
        m.top.removeChild(m.screen)
        m.screen = invalid
    end if

    ' Once signed in, probe which Plex connection this device can reach (local/remote/relay) so /media
    ' streams from the right URL off-network. One-shot; the result is stored + read by Api.media.
    if Auth.hasToken() and not m.probeStarted
        startConnectionProbe()
        m.probeStarted = true
    end if

    if not ServerUrl.has()
        showServerSetup()
    else if not Auth.hasToken()
        showLogin()
    else if not Device.capsDoneForServer()
        showDiagnostic()
    else
        showGuide()
    end if
end sub

sub showGuide()
    s = CreateObject("roSGNode", "Guide")
    m.top.appendChild(s)
    s.observeField("tuneChannelId", "onGuideTune")
    s.observeField("openSettings", "onOpenSettings")
    s.setFocus(true)
    m.screen = s
    ' Restore the player (hidden while in Settings) if one is docked/playing.
    if m.player <> invalid and m.player.layout <> "off" then m.player.visible = true
    ' Hand off any deep-link target that arrived before the guide existed.
    applyDeepLink()
end sub

' Guide sidebar → open the Settings shell at a category (General / User). Replaces the guide screen; the
' player (if any) is hidden while in Settings and restored on return.
sub onOpenSettings()
    if m.screen = invalid then return
    cat = m.screen.openSettings
    if cat = invalid or cat = "" then return
    if m.player <> invalid then m.player.visible = false
    m.top.removeChild(m.screen)
    s = CreateObject("roSGNode", "SettingsScreen")
    s.category = cat
    m.top.appendChild(s)
    s.observeField("done", "onSettingsDone")
    s.observeField("exitTo", "onSettingsExit")
    s.observeField("reprobe", "onSettingsReprobe")
    s.setFocus(true)
    m.screen = s
end sub

sub onSettingsDone()
    if m.screen <> invalid
        m.top.removeChild(m.screen)
        m.screen = invalid
    end if
    showGuide()
end sub

' Sign out ("login") or change server ("setup") — clear creds + tear down the player + re-route.
sub onSettingsExit()
    if m.screen = invalid then return
    dest = m.screen.exitTo
    if dest = invalid or dest = "" then return
    ' Run capability diagnostic → show the Diagnostic screen (it re-measures, then routes on to the guide).
    if dest = "diagnostic"
        m.top.removeChild(m.screen)
        m.screen = invalid
        showDiagnostic()
        return
    end if
    ' Sign out / change server → clear creds + tear down the player + re-route.
    Auth.setToken("")
    if dest = "setup" then ServerUrl.clear()
    if m.player <> invalid
        m.player.layout = "off"
        m.top.removeChild(m.player)
        m.player = invalid
    end if
    m.probeStarted = false
    route()
end sub

sub onSettingsReprobe()
    startConnectionProbe()
end sub

' OK on a channel → show the persistent PlayerHost (created once) and tune it. The player takes focus; on
' Back it sets `done` and we refocus the guide.
sub onGuideTune()
    g = m.screen
    if g = invalid then return
    if m.player = invalid
        m.player = CreateObject("roSGNode", "PlayerHost")
        m.top.appendChild(m.player)
        m.player.observeField("playerCmd", "onPlayerCmd")
    end if
    ' Re-selecting the channel that's ALREADY playing (a docked mini feed) = just re-expand to full — don't
    ' re-tune (no `go` bump), matching tv-web/tv-native. A different channel falls through to a real tune.
    if m.player.layout <> "off" and m.player.channelId = g.tuneChannelId
        m.player.miniFocused = false
        m.player.layout = "full"
        return
    end if
    ' The effectiveTime clock derives the on-now from the channel timeline (join-live / resume), so tuning
    ' only needs the channel id — the selected program can't seed playback (no future seek). The chrome also
    ' needs the channel's identity (chip + accent). layout=full → the player shows full-screen + takes focus.
    m.player.channelId = g.tuneChannelId
    m.player.channelNumber = g.tuneChannelNumber
    m.player.channelName = g.tuneChannelName
    m.player.accent = g.tuneAccent
    m.player.miniFocused = false
    m.player.layout = "full"
    m.player.go = m.player.go + 1
    Log.info("guide tune -> " + g.tuneChannelId)
end sub

' PlayerHost surface commands: Back from full → mini (keep playing); the mini Full/Close overlay → full / stop.
sub onPlayerCmd()
    cmd = m.player.playerCmd
    if cmd = "goMini"
        dockMini()
    else if cmd = "goFull"
        goFullPlayer()
    else if cmd = "close"
        closePlayer()
    else if cmd = "blurMini"
        m.player.miniFocused = false
        if m.screen <> invalid then m.screen.setFocus(true)
    end if
end sub

' Dock the player into the guide's featured-panel slot (reserve the width so the panel's text shrinks to fit).
sub dockMini()
    if m.screen <> invalid
        m.screen.miniActive = true
        m.player.dockX = m.screen.miniDockX
        m.player.dockY = m.screen.miniDockY
        m.player.dockW = m.screen.miniDockW
        m.player.dockH = m.screen.miniDockH
        m.screen.setFocus(true)
    end if
    m.player.miniFocused = false
    m.player.layout = "mini"
    m.idleTimer.control = "start"   ' arm the 60s idle→full
end sub

sub goFullPlayer()
    if m.screen <> invalid then m.screen.miniActive = false
    m.player.miniFocused = false
    m.player.layout = "full"
    m.idleTimer.control = "stop"
end sub

sub closePlayer()
    if m.screen <> invalid
        m.screen.miniActive = false
        m.screen.setFocus(true)
    end if
    m.player.layout = "off"   ' → PlayerHost onLayout(off) tears down the session
    m.idleTimer.control = "stop"
end sub

sub showDiagnostic()
    s = CreateObject("roSGNode", "Diagnostic")
    m.top.appendChild(s)
    s.observeField("done", "onDiagnosticDone")
    s.setFocus(true)
    m.screen = s
end sub

sub onDiagnosticDone()
    Log.info("diagnostic done -> re-routing")
    route()
end sub

sub startConnectionProbe()
    t = CreateObject("roSGNode", "ConnectionProbeTask")
    m.top.appendChild(t)
    m.connProbe = t
    t.control = "RUN"
    Log.info("connection probe started")
end sub

' Dev-only: prove the promise data layer returns real data over the bearer API before the guide
' (Phase 6) is built on it. Logs counts to the :8085 console.
sub devDataSmoke()
    Log.info("[data] smoke: channels / packages / guide")
    ch = Api.channels()
    onThen(ch, onSmokeChannels, m)
    onCatch(ch, onSmokeDataErr, m)
    pk = Api.packages()
    onThen(pk, onSmokePackages, m)
    onCatch(pk, onSmokeDataErr, m)
    gd = Api.guide(180)
    onThen(gd, onSmokeGuide, m)
    onCatch(gd, onSmokeDataErr, m)
end sub

sub onSmokeChannels(b as object, _c as object)
    n = 0
    if b <> invalid and b.channels <> invalid then n = b.channels.count()
    Log.info("[data] channels=" + Str(n).Trim())
end sub

sub onSmokePackages(b as object, _c as object)
    n = 0
    if b <> invalid and b.packages <> invalid then n = b.packages.count()
    Log.info("[data] packages=" + Str(n).Trim())
end sub

sub onSmokeGuide(b as object, _c as object)
    n = 0
    if b <> invalid and b.channels <> invalid then n = b.channels.count()
    Log.info("[data] guide channels=" + Str(n).Trim())
end sub

sub onSmokeDataErr(e as object, _c as object)
    Log.warn("[data] smoke error: " + Log.trunc(e))
end sub

sub showServerSetup()
    s = CreateObject("roSGNode", "ServerSetup")
    m.top.appendChild(s)
    s.observeField("done", "onSetupDone")
    s.setFocus(true)
    m.screen = s
end sub

sub onSetupDone()
    Log.info("setup done -> re-routing")
    route()
end sub

sub showLogin()
    s = CreateObject("roSGNode", "Login")
    m.top.appendChild(s)
    s.observeField("done", "onLoginDone")
    s.observeField("changeServer", "onLoginChangeServer")
    s.setFocus(true)
    m.screen = s
end sub

sub onLoginDone()
    Log.info("login done -> re-routing")
    route()
end sub

' "Change server" from the login chooser — the user hasn't signed in yet (no token to clear), so just drop
' the onboarded URL and re-route; route() tears down Login and lands on ServerSetup (not ServerUrl.has()).
sub onLoginChangeServer()
    Log.info("login change-server -> clearing server url")
    ServerUrl.clear()
    route()
end sub

' A minimal centered two-line screen — a stand-in until Login (Phase 3) / Guide (Phase 6) land,
' so onboarding can be verified end-to-end on-device now.
sub showPlaceholder(titleText as string, subText as string)
    g = CreateObject("roSGNode", "Group")

    t = g.createChild("Label")
    t.setFields({
        text: titleText, translation: [510, 440], width: 900, horizAlign: "center",
        color: "0xF1F5F9FF", font: "font:LargeBoldSystemFont"
    })

    s = g.createChild("Label")
    s.setFields({
        text: subText, translation: [510, 520], width: 900, height: 120, horizAlign: "center",
        wrap: true, color: "0x94A3B8FF", font: "font:MediumSystemFont"
    })

    m.top.appendChild(g)
    m.screen = g
    m.top.setFocus(true)   ' so MainScene.onKeyEvent gets the dev re-run key

    ' Dev-only: verify the data layer end-to-end (real channels/guide over the bearer API).
    if Dev.isDev() then devDataSmoke()
end sub

' Dev-only: * (options) re-runs the capability diagnostic (clears the per-server caps-done). Handy now
' that the registry persists across sideloads — otherwise the diagnostic never re-runs once done.
function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    ' Back on the guide with a docked mini feed peels the mini (stops it) instead of exiting the app.
    if key = "back" and m.player <> invalid and m.player.layout = "mini"
        closePlayer()
        return true
    end if
    if key = "options"
        ' ✱ focuses the docked mini feed (→ its Full/Close overlay); else the dev diagnostic re-run.
        if m.player <> invalid and m.player.layout = "mini"
            m.player.miniFocused = true
            return true
        end if
        if Dev.isDev() and Auth.hasToken()
            Registry.delete(RegKey.CAPS_DONE)
            Log.info("[dev] cleared caps-done -> re-running diagnostic")
            route()
            return true
        end if
    end if
    return false
end function
