import "pkg:/source/lib/guideLayout.bs"
import "pkg:/source/theme.bs"
import "pkg:/source/lib/tint.bs"
import "pkg:/source/lib/api.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/input/keys.bs"

' Guide scene — the Aurora grid + the zone machine (grid ↔ rail ↔ sidebar), ported from tv-web/tv-native
' aurora-grid. The scene holds focus and owns ALL navigation (onKeyEvent); the VirtualRowList + rows never
' take focus — we drive fc/fp/zone into them. Nav clicks come from the SoundEffect nodes (m.navSound etc.),
' since our custom focus loses MarkupList's built-in feedback.
'
' (m.<id> for every XML node is auto-injected by bsc-plugin-auto-findnode.)

sub init()
    ' (m.<id> for every XML node is auto-injected by bsc-plugin-auto-findnode.)
    m.soundSeq = 0
    m.refreshStarted = false
    m.refreshTimer.observeField("fire", "onRefreshTick")

    Theme.setFont(m.dayLabel, Theme.FONT_SEMI, GuideLayout.vw(32))
    Theme.setFont(m.msg, Theme.FONT_REG, 26)

    ' Flow the header + grid right below the featured panel (dynamic — the panel's height varies).
    m.gridTop = GuideLayout.gridTop()
    headerTop = GuideLayout.headerTop()
    m.dayLabel.translation = [92 + GuideLayout.vw(40), headerTop + GuideLayout.vw(6)]
    m.ticks.translation = [92 + GuideLayout.railPx(), headerTop]
    m.gridClip.translation = [92, m.gridTop]
    m.gridClip.clippingRect = [0, 0, GuideLayout.colW(), GuideLayout.STAGE_H - m.gridTop]

    ' Configure the virtualized list (geometry known now; content arrives in onGuide).
    m.list.rowHeight = GuideLayout.rowPx()
    m.list.viewportHeight = GuideLayout.STAGE_H - m.gridTop
    m.list.clipWidth = GuideLayout.colW()

    ' Zone state.
    m.zone = "grid"
    m.fc = 0
    m.fp = 0
    m.channels = []
    m.allChannels = []
    m.accents = []

    ' Sidebar (lens filtering + actions). Collapsed by default; the zone machine expands it on left-from-rail.
    m.lens = "all"
    m.sidebarSel = 0
    m.sidebar.lens = "all"
    m.sidebar.observeField("activated", "onSidebarActivated")

    ' Times travel to the rows as ISO strings on m.global (float fields can't hold epoch-ms); favorites as
    ' an assoc-array of channelId → true.
    if not m.global.hasField("guideServerTime")
        m.global.addFields({ guideServerTime: "", guideT0Iso: "", guideFavorites: {} })
    end if

    load()
    m.top.setFocus(true)
end sub

sub load()
    ' Show the ghost skeleton with a loading message while the first fetch is in flight (instead of a bare
    ' "Loading…" over the empty/broken featured panel).
    m.ghost.message = "Loading your guide…"
    m.ghost.sub = ""
    showEmpty(true)
    p = Api.guide(180)
    onThen(p, onGuide, m)
    onCatch(p, onGuideErr, m)
    ' Favorites (for the rail heart) — best-effort, parallel.
    fp = Api.favorites()
    onThen(fp, onFavorites, m)
    ' Packages (for the sidebar lens list) — best-effort, parallel.
    pk = Api.packages()
    onThen(pk, onPackages, m)
end sub

sub onPackages(data as object, _ctx as object)
    if data = invalid or data.packages = invalid then return
    m.sidebar.packages = data.packages
end sub

sub onFavorites(data as object, _ctx as object)
    if data = invalid or data.channelIds = invalid then return
    favs = {}
    for each id in data.channelIds
        favs[id] = true
    end for
    m.global.guideFavorites = favs
    m.list.favVersion = m.list.favVersion + 1
end sub

' Shared guide processing. resetFocus=true on first load / lens change (fc→0); false on the 60s refresh
' (preserve the user's fc/fp). Returns false if the payload was unusable.
function processGuide(data as object, resetFocus as boolean) as boolean
    if data = invalid or data.channels = invalid
        if resetFocus then onGuideErr({ message: "empty" }, invalid)
        return false
    end if
    raw = data.channels
    if raw.count() = 0
        if resetFocus
            m.ghost.message = lensEmptyTitle()
            m.ghost.sub = lensEmptySub()
            showEmpty(true)
        end if
        return false
    end if

    serverTime = data.serverTime
    m.nowMs = GuideLayout.parseIso(serverTime)
    t0Iso = computeT0Iso(m.nowMs)
    m.t0Ms = GuideLayout.parseIso(t0Iso)
    m.global.guideServerTime = serverTime
    m.global.guideT0Iso = t0Iso

    ' Cull each channel's programs to the visible window ONCE (matches tv-web/native) so fp indexes exactly
    ' the cells ChannelRow renders. Inline math (same predicate as ChannelRow.buildLane); the grid constants
    ' are computed ONCE here, not per-program.
    ppm = GuideLayout.ppm()
    laneW = GuideLayout.laneW()
    gap = GuideLayout.vw(6)
    winMin = GuideLayout.WINDOW_MIN
    minSliver = laneW * 0.02
    m.allChannels = []
    for each ch in raw
        culled = []
        if ch.programs <> invalid
            for each p in ch.programs
                startMin = (GuideLayout.parseIso(p.startsAt) - m.t0Ms) / 60000.0
                durMin = p.durationSeconds / 60.0
                endMin = startMin + durMin
                if endMin > 0 and startMin < winMin
                    w = minSliver
                    dw = durMin * ppm
                    if dw > w then w = dw
                    rawLeft = startMin * ppm
                    rawRight = rawLeft + w - gap
                    left = rawLeft
                    if left < 0 then left = gap
                    if (rawRight - left) >= 8 then culled.push(p)
                end if
            end for
        end if
        ch.programs = culled
        m.allChannels.push(ch)
    end for

    buildTicks()
    drawNowCaret()
    if resetFocus then m.zone = "grid"
    applyLens(resetFocus)
    return true
end function

' First-load callback: process, take focus, and start the 60s refresh timer.
sub onGuide(data as object, _ctx as object)
    if not processGuide(data, true) then return
    m.top.setFocus(true)
    if not m.refreshStarted
        m.refreshStarted = true
        m.refreshTimer.control = "start"
    end if
    Log.info("[guide] " + Str(m.allChannels.count()).Trim() + " channels loaded")
end sub

' 60s periodic re-fetch (tv-web/native refetchInterval) — advances now/on-now/progress, preserving fc/fp.
' Skipped while the sidebar is open (the grid is covered).
sub onRefreshTick()
    if m.zone = "sidebar" then return
    p = Api.guide(180)
    onThen(p, onGuideRefresh, m)
end sub

sub onGuideRefresh(data as object, _ctx as object)
    processGuide(data, false)
end sub

' Filter the (culled) channel list by the active lens → the rendered channels, then rebuild. resetFocus=true
' resets fc/fp to the top/on-now (first load, lens change); false preserves them (60s refresh).
sub applyLens(resetFocus = true as boolean)
    m.channels = []
    favs = m.global.guideFavorites
    for each ch in m.allChannels
        keep = false
        if m.lens = "all"
            keep = true
        else if m.lens = "favorites"
            keep = (favs <> invalid and favs.doesExist(ch.id))
        else if m.lens = "recents"
            keep = true   ' recents are server-side; kept simple (matches tv-web/native)
        else if Left(m.lens, 4) = "pkg:"
            pid = Mid(m.lens, 5)
            keep = (ch.package <> invalid and ch.package.id = pid)
        end if
        if keep then m.channels.push(ch)
    end for

    buildContent()
    if resetFocus then m.fc = 0
    n = m.channels.count()
    if n > 0
        showEmpty(false)
        if m.fc > n - 1 then m.fc = n - 1
        if m.fc < 0 then m.fc = 0
        if resetFocus
            m.fp = GuideLayout.liveProgramIndex(m.channels[m.fc].programs, m.nowMs)
        else
            ' Refresh: keep the user's fp, clamped to the (re-culled) focused channel's program count.
            pc = m.channels[m.fc].programs.count()
            if m.fp > pc - 1 then m.fp = pc - 1
            if m.fp < 0 then m.fp = 0
        end if
    else
        m.fc = 0
        m.fp = 0
        m.ghost.message = lensEmptyTitle()
        m.ghost.sub = lensEmptySub()
        showEmpty(true)
        m.featured.content = invalid
    end if
    applyFocus()
end sub

' Toggle the empty-lens ghost vs the real guide chrome (featured + grid + header + now-caret).
sub showEmpty(empty as boolean)
    m.msg.visible = false
    m.ghost.visible = empty
    m.featured.visible = not empty
    m.gridClip.visible = not empty
    m.dayLabel.visible = not empty
    m.ticks.visible = not empty
    if empty
        m.nowCaret.visible = false
    else
        drawNowCaret()
    end if
end sub

function lensEmptyTitle() as string
    if m.lens = "favorites" then return "No favorites yet"
    if Left(m.lens, 4) = "pkg:" then return "No channels in this filter"
    return "No channels yet"
end function

function lensEmptySub() as string
    if m.lens = "favorites" then return "Highlight a channel and add it to your favorites."
    if Left(m.lens, 4) = "pkg:" then return "Try another filter, or open the sidebar to clear it."
    return "Once channels are set up on your server, they'll appear here."
end function

sub onGuideErr(err as object, _ctx as object)
    m.ghost.message = "Couldn't load the guide"
    m.ghost.sub = "Check your connection and try again."
    showEmpty(true)
    Log.warn("[guide] load error: " + Log.trunc(err))
end sub

' T0 = now − 30min, snapped back to the nearest :31 / :01 half-hour boundary (matches tv-web/native).
function computeT0Iso(nowMs as double) as string
    baseSecs = Int(nowMs / 1000) - GuideLayout.LEAD_MIN * 60
    d = CreateObject("roDateTime")
    d.FromSeconds(baseSecs)
    mins = d.GetMinutes()
    secOfMin = d.GetSeconds()
    if mins >= 31
        target = 31
    else if mins >= 1
        target = 1
    else
        target = -29
    end if
    t0Secs = baseSecs - ((mins - target) * 60 + secOfMin)
    d.FromSeconds(t0Secs)
    return d.ToISOString()
end function

sub buildTicks()
    tk = m.ticks
    while tk.getChildCount() > 0
        tk.removeChildIndex(0)
    end while
    m.dayLabel.text = GuideLayout.fmtDay(m.t0Ms)
    ppm = GuideLayout.ppm()
    n = Int(GuideLayout.WINDOW_MIN / 30) + 1
    for i = 0 to n - 1
        tickMs = m.t0Ms + i * 30 * 60000.0
        lbl = tk.createChild("Label")
        lbl.translation = [Int(i * 30 * ppm), GuideLayout.vw(6)]
        lbl.color = "0xC3C9D4FF"
        Theme.setFont(lbl, Theme.FONT_SEMI, GuideLayout.vw(32))
        lbl.text = GuideLayout.fmtTime(tickMs)
    end for
end sub

sub buildContent()
    content = CreateObject("roSGNode", "ContentNode")
    m.accents = []
    i = 0
    for each ch in m.channels
        accent = Tint.forChannel(ch, i)
        m.accents.push(accent)
        node = content.createChild("ContentNode")
        node.addFields({ channel: ch, accentHex: accent })
        i = i + 1
    end for
    m.list.content = content
end sub

' Only the pulsing red caret marks "now" (the vertical line stays hidden) — matches tv-web/native.
sub drawNowCaret()
    nowMin = (m.nowMs - m.t0Ms) / 60000.0
    if nowMin < 0 or nowMin > GuideLayout.WINDOW_MIN
        m.nowCaret.visible = false
        return
    end if
    cw = GuideLayout.vw(20)
    chH = GuideLayout.vw(16)
    x = 92 + GuideLayout.railPx() + Int(nowMin * GuideLayout.ppm()) - Int(cw / 2)
    m.nowCaret.width = cw
    m.nowCaret.height = chH
    m.nowCaret.translation = [x, m.gridTop - chH]
    m.nowCaret.visible = true
    m.caretPulse.control = "start"
end sub

' ---- the zone machine ------------------------------------------------------------------------------

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    ' Sidebar zone — up/down move the selection, OK activates, right/back returns to the grid.
    if m.zone = "sidebar"
        n = m.sidebar.itemCount
        if key = Keys.UP
            if m.sidebarSel > 0
                m.sidebarSel = m.sidebarSel - 1
                m.sidebar.sel = m.sidebarSel
                playNav()
            else
                playDead()
            end if
        else if key = Keys.DOWN
            if m.sidebarSel < n - 1
                m.sidebarSel = m.sidebarSel + 1
                m.sidebar.sel = m.sidebarSel
                playNav()
            else
                playDead()
            end if
        else if key = Keys.OK
            m.sidebar.activate = m.sidebar.activate + 1
            playSelect()
        else if key = Keys.RIGHT or key = Keys.BACK
            exitSidebar()
            playNav()
        end if
        return true
    end if

    ' From here on the keys act on channels. If the current lens filtered to nothing, only left (→ sidebar,
    ' to change the filter) does anything.
    if m.channels = invalid or m.channels.count() = 0
        if key = Keys.LEFT
            enterSidebar()
            playNav()
        end if
        return true
    end if
    n = m.channels.count()

    ' Rail zone — favorite the channel; up/down still change channel; left → sidebar; right/back → grid.
    if m.zone = "rail"
        if key = Keys.LEFT
            enterSidebar()
            playNav()
        else if key = Keys.RIGHT or key = Keys.BACK
            setZone("grid")
            playNav()
        else if key = Keys.UP
            moveChannel(-1)
        else if key = Keys.DOWN
            moveChannel(1)
        else if key = Keys.OK
            toggleFavorite()
        end if
        return true
    end if

    ' Grid zone.
    if key = Keys.RIGHT
        maxP = focusedPrograms().count() - 1
        if m.fp < maxP
            m.fp = m.fp + 1
            applyFocus()
            playNav()
        else
            playDead()
        end if
        return true
    else if key = Keys.LEFT
        if m.fp = 0
            setZone("rail")
            playNav()
        else
            m.fp = m.fp - 1
            applyFocus()
            playNav()
        end if
        return true
    else if key = Keys.DOWN
        moveChannel(1)
        return true
    else if key = Keys.UP
        moveChannel(-1)
        return true
    else if key = Keys.OK
        tune()
        return true
    end if
    return false
end function

function focusedPrograms() as object
    ch = m.channels[m.fc]
    if ch = invalid or ch.programs = invalid then return []
    return ch.programs
end function

sub moveChannel(delta as integer)
    n = m.channels.count()
    nc = m.fc + delta
    if nc < 0 then nc = 0
    if nc > n - 1 then nc = n - 1
    if nc = m.fc
        playDead()
        return
    end if
    m.fc = nc
    ' Land fp on the on-now program of the new channel (tv-web/native).
    m.fp = GuideLayout.liveProgramIndex(m.channels[nc].programs, m.nowMs)
    applyFocus()
    playNav()
end sub

sub setZone(z as string)
    m.zone = z
    applyFocus()
end sub

' Enter the sidebar: expand + focus it, selection at the top. The grid never reflows (it always reserves the
' sliver); the expanded sidebar overlays it. applyFocus() clears the rail/program highlight (zone != grid/rail).
sub enterSidebar()
    m.zone = "sidebar"
    m.sidebarSel = 0
    m.sidebar.lens = m.lens
    m.sidebar.sel = 0
    m.sidebar.expanded = true
    m.sidebar.focused = true
    applyFocus()
end sub

sub exitSidebar()
    m.zone = "grid"
    m.sidebar.expanded = false
    m.sidebar.focused = false
    applyFocus()
end sub

' The sidebar emitted an activated item — apply the lens (toggling an active filter off → all), or run the
' Settings/Account action (stubbed until those screens exist). Then collapse back to the grid.
sub onSidebarActivated()
    key = m.sidebar.activated
    if key = invalid or key = "" then return
    if key = "settings" or key = "account"
        Log.info("[guide] sidebar action (todo): " + key)
        exitSidebar()
        return
    end if
    if key = m.lens and key <> "all"
        m.lens = "all"
    else
        m.lens = key
    end if
    m.sidebar.lens = m.lens
    applyLens()
    exitSidebar()
end sub

' Push fc/fp/zone into the list (which scrolls + re-lays-out rows) and refresh the featured panel.
sub applyFocus()
    m.list.zone = m.zone
    m.list.focusProgramIndex = m.fp
    m.list.focusIndex = m.fc
    updateFeatured()
end sub

sub updateFeatured()
    ch = m.channels[m.fc]
    if ch = invalid then return
    progs = ch.programs
    if progs = invalid or progs.count() = 0 then return
    fpi = m.fp
    if fpi < 0 then fpi = 0
    if fpi > progs.count() - 1 then fpi = progs.count() - 1
    fc = CreateObject("roSGNode", "ContentNode")
    fc.addFields({ channel: ch, program: progs[fpi], accentHex: m.accents[m.fc] })
    m.featured.content = fc
end sub

sub tune()
    ch = m.channels[m.fc]
    if ch = invalid then return
    playSelect()
    ' Tune to the channel's LIVE program (not the focused fp) — the on-now ratingKey + its live offset. The
    ' effectiveTime clock (Phase 8) will own this; the first-slice player just plays it.
    li = GuideLayout.liveProgramIndex(ch.programs, m.nowMs)
    rk = ""
    off = 0
    if ch.programs <> invalid and ch.programs.count() > li
        p = ch.programs[li]
        if p.ratingKey <> invalid then rk = p.ratingKey
        off = Int((m.nowMs - GuideLayout.parseIso(p.startsAt)) / 1000)
        if off < 0 then off = 0
    end if
    m.top.tuneRatingKey = rk
    m.top.tuneOffset = off
    Log.info("[guide] tune -> " + ch.id + " rk=" + rk + " off=" + Str(off).Trim())
    m.top.tuneChannelId = ch.id
end sub

sub toggleFavorite()
    ch = m.channels[m.fc]
    if ch = invalid then return
    favs = m.global.guideFavorites
    if favs = invalid then favs = {}
    id = ch.id
    desired = not favs.doesExist(id)
    if desired
        favs[id] = true
    else
        favs.delete(id)
    end if
    m.global.guideFavorites = favs
    m.list.favVersion = m.list.favVersion + 1
    p = Api.setFavorite(id, desired)
    onCatch(p, onFavoriteErr, m)
    playSelect()
end sub

sub onFavoriteErr(err as object, _ctx as object)
    Log.warn("[guide] setFavorite error: " + Log.trunc(err))
end sub

' ---- nav sounds ------------------------------------------------------------------------------------

' Nav sounds run on the main thread (roAudioResource is main-thread-only) — see main.bs. We trigger by
' setting the global `uiSound` to "<name>|<seq>"; the seq makes each write unique so repeats still fire.
sub playNav()
    triggerSound("nav")
end sub

sub playSelect()
    triggerSound("select")
end sub

sub playDead()
    triggerSound("dead")
end sub

sub triggerSound(name as string)
    m.soundSeq = m.soundSeq + 1
    m.global.uiSound = name + "|" + Str(m.soundSeq).Trim()
end sub
