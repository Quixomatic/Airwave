import "pkg:/source/lib/serverUrl.bs"
import "pkg:/source/lib/auth.bs"
import "pkg:/source/lib/api.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/lib/registry.bs"
import "pkg:/source/input/keys.bs"
import "pkg:/source/theme.bs"

' Login code-behind. On-device email/password is PRIMARY (the Roku Channel Store forbids off-device sign-in);
' the two device-code flows (Plex PIN, better-auth code) are kept as SECONDARY, behind "More sign-in options".
' See .plans/roku.md Phase 13. Three modes: "form" | "chooser" | "pending".

sub init()
    m.serverLabel.text = "Server: " + ServerUrl.get()

    ' Fonts via the mutation path (custom TTFs render blank via <Font role> / new Font node on Roku).
    Theme.setFont(m.subtitle, Theme.FONT_REG, 18)
    Theme.setFont(m.emailCap, Theme.FONT_REG, 14)
    Theme.setFont(m.pwCap, Theme.FONT_REG, 14)
    Theme.setFont(m.pHeading, Theme.FONT_SEMI, 26)
    Theme.setFont(m.pInstruction, Theme.FONT_REG, 18)
    Theme.setFont(m.pCode, Theme.FONT_MONO, 40)
    Theme.setFont(m.error, Theme.FONT_REG, 18)
    Theme.setFont(m.serverLabel, Theme.FONT_REG, 14)

    m.mode = "form"         ' "form" | "chooser" | "pending"
    m.sel = 0
    m.items = []

    ' Form state
    m.email = Registry.read(RegKey.EMAIL)   ' remember the last email
    m.password = ""
    m.showPw = false
    m.kbd = invalid
    m.kbdFor = ""

    ' Secondary-flow poll state
    m.pollType = ""         ' "plex" | "device"
    m.pinId = ""
    m.deviceCode = ""
    m.pollCount = 0
    m.timer = CreateObject("roSGNode", "Timer")
    m.timer.repeat = true
    m.timer.observeField("fire", "onPollTick")
    m.top.appendChild(m.timer)

    renderFields()
    showForm()
    m.top.setFocus(true)
end sub

' ---- view state ---------------------------------------------------------------

sub showForm()
    m.mode = "form"
    m.timer.control = "stop"
    m.form.visible = true
    m.chooser.visible = false
    m.pending.visible = false
    m.error.text = ""
    buildFormItems()
    setSel(0)
end sub

sub showChooser()
    m.mode = "chooser"
    m.timer.control = "stop"
    m.form.visible = false
    m.chooser.visible = true
    m.pending.visible = false
    m.error.text = ""
    buildChooserItems()
    setSel(0)
end sub

sub showPending(heading as string, instruction as string, code as string, qrValue as string)
    m.mode = "pending"
    m.form.visible = false
    m.chooser.visible = false
    m.pending.visible = true
    m.pHeading.text = heading
    m.pInstruction.text = instruction
    m.pCode.text = code
    m.qr.text = qrValue     ' QRCode extends Poster — setting text renders the QR to itself
    m.error.text = ""
    buildPendingItems()
    setSel(0)
end sub

' ---- focus / nav (item-list pattern, like ServerSetup) ------------------------

sub buildFormItems()
    items = []
    items.push({ node: m.emailField, action: "email" })
    items.push({ node: m.pwField, action: "password" })
    items.push({ node: m.showBtn, action: "toggleShow" })
    items.push({ node: m.signInBtn, action: "signin" })
    items.push({ node: m.moreBtn, action: "more" })
    items.push({ node: m.changeBtn, action: "change" })
    m.items = items
end sub

sub buildChooserItems()
    items = []
    items.push({ node: m.plexBtn, action: "plex" })
    items.push({ node: m.codeBtn, action: "device" })
    items.push({ node: m.backToFormBtn, action: "backToForm" })
    items.push({ node: m.changeBtn, action: "change" })   ' reachable here too (it's always visible)
    m.items = items
end sub

sub buildPendingItems()
    ' While waiting on a QR/code approval: Back (to the chooser) + Change server (both below the panel).
    items = []
    items.push({ node: m.backBtn, action: "backToChooser" })
    items.push({ node: m.changeBtn, action: "change" })
    m.items = items
end sub

sub setSel(i as integer)
    if i < 0 then i = 0
    if i > m.items.count() - 1 then i = m.items.count() - 1
    m.sel = i
    idx = 0
    for each it in m.items
        it.node.focused = (idx = i)
        idx = idx + 1
    end for
end sub

' ---- input --------------------------------------------------------------------

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.mode = "pending"
        if key = Keys.BACK
            showChooser()
            return true
        else if key = Keys.UP
            setSel(m.sel - 1)
            return true
        else if key = Keys.DOWN
            setSel(m.sel + 1)
            return true
        else if key = Keys.OK
            dispatch()
            return true
        end if
        return false
    end if

    if key = Keys.UP
        setSel(m.sel - 1)
        return true
    else if key = Keys.DOWN
        setSel(m.sel + 1)
        return true
    else if key = Keys.OK
        dispatch()
        return true
    else if key = Keys.BACK
        ' From the secondary chooser, Back returns to the primary form; on the form, let it bubble.
        if m.mode = "chooser"
            showForm()
            return true
        end if
    end if
    return false
end function

sub dispatch()
    if m.sel < 0 or m.sel > m.items.count() - 1 then return
    a = m.items[m.sel].action
    if a = "email"
        openKbd("email")
    else if a = "password"
        openKbd("password")
    else if a = "toggleShow"
        toggleShow()
    else if a = "signin"
        doLogin()
    else if a = "more"
        showChooser()
    else if a = "change"
        Log.info("change server requested")
        m.timer.control = "stop"   ' pending flow may be polling; stop before we leave the scene
        m.top.changeServer = true
    else if a = "backToChooser"
        showChooser()
    else if a = "plex"
        startPlex()
    else if a = "device"
        startDevice()
    else if a = "backToForm"
        showForm()
    end if
end sub

' ---- form: fields, keyboard, show-toggle, sign-in -----------------------------

sub renderFields()
    if m.email <> ""
        m.emailField.text = m.email
    else
        m.emailField.text = "Email"
    end if

    if m.password = ""
        m.pwField.text = "Password"
    else if m.showPw
        m.pwField.text = m.password
    else
        m.pwField.text = maskOf(m.password)
    end if
end sub

function maskOf(s as string) as string
    out = ""
    for i = 1 to Len(s)
        out = out + "•"
    end for
    return out
end function

' The keyboard CAPTURES into the field only — signing in is the explicit Sign-in button. On OK we auto-advance
' focus (email → password → Sign in) so remote entry flows without hunting for the next control.
sub openKbd(which as string)
    dlg = CreateObject("roSGNode", "StandardKeyboardDialog")
    m.kbdFor = which
    if which = "email"
        dlg.title = "Enter your email"
        if m.email <> "" then dlg.text = m.email
    else
        dlg.title = "Enter your password"
        if m.password <> "" then dlg.text = m.password
    end if
    dlg.buttons = ["OK", "Cancel"]
    dlg.palette = CreateObject("roSGNode", "RSGPalette")
    m.kbd = dlg
    dlg.observeField("buttonSelected", "onKbdButton")
    dlg.observeField("wasClosed", "onKbdClosed")   ' catch a raw Back-dismiss too
    m.top.getScene().dialog = dlg
end sub

sub onKbdButton()
    if m.kbd = invalid then return
    okPressed = (m.kbd.buttonSelected = 0)
    captureKbd(m.kbd.text, okPressed)
    closeKeyboard()
end sub

sub onKbdClosed()
    if m.kbd = invalid then return   ' already handled by the button press
    captureKbd(m.kbd.text, false)
    closeKeyboard()
end sub

sub captureKbd(text as string, advance as boolean)
    if m.kbdFor = "email"
        if text <> "" then m.email = text
        if m.email <> "" then Registry.write(RegKey.EMAIL, m.email)
        renderFields()
        if advance then setSel(1)      ' → password
    else if m.kbdFor = "password"
        m.password = text
        renderFields()
        if advance then setSel(3)      ' → Sign in
    end if
end sub

sub closeKeyboard()
    if m.kbd <> invalid then m.kbd.close = true
    m.kbd = invalid
    m.kbdFor = ""
    m.top.setFocus(true)
end sub

sub toggleShow()
    m.showPw = not m.showPw
    if m.showPw
        m.showBtn.text = "Hide"
    else
        m.showBtn.text = "Show"
    end if
    renderFields()
end sub

sub doLogin()
    if m.email = "" or m.password = ""
        m.error.text = "Enter your email and password."
        return
    end if
    m.error.text = ""
    m.signInBtn.text = "Signing in…"
    Log.info("password login for " + Log.trunc(m.email))
    p = Api.passwordLogin(m.email, m.password)
    onThen(p, onLoginOk, m)
    onCatch(p, onLoginErr, m)
end sub

sub onLoginOk(b as object, _ctx as object)
    m.signInBtn.text = "Sign in"
    if b <> invalid and b.status = "ok" and b.token <> invalid
        finishLogin(b.token)
    else
        m.error.text = "Invalid email or password."
    end if
end sub

sub onLoginErr(err as object, _ctx as object)
    m.signInBtn.text = "Sign in"
    st = 0
    if err <> invalid and err.status <> invalid then st = err.status
    ' 401 (invalid creds) / 400 (missing) → credential message; anything else → a reachability message.
    if st = 401 or st = 400
        m.error.text = "Invalid email or password."
    else
        m.error.text = "Could not reach the server."
    end if
    Log.warn("password login failed http=" + Str(st).Trim())
end sub

' ---- secondary flows: Plex PIN + better-auth device code ----------------------

sub startPlex()
    m.error.text = ""
    Log.info("start plex")
    p = Api.plexStart()
    onThen(p, onPlexStart, m)
    onCatch(p, onStartError, m)
end sub

sub startDevice()
    m.error.text = ""
    Log.info("start device")
    p = Api.deviceCode()
    onThen(p, onDeviceStart, m)
    onCatch(p, onStartError, m)
end sub

sub onPlexStart(b as object, _ctx as object)
    m.pollType = "plex"
    m.pinId = b.pinId
    Log.info("plex start ok — pinId=" + Log.trunc(m.pinId) + " code=" + Log.trunc(b.code))
    showPending("Log in with Plex", "Go to " + b.verificationUrl + " and enter this code, or scan:", b.code, b.verificationUrl)
    m.timer.duration = 2
    m.pollCount = 0
    m.timer.control = "start"
    Log.info("poll timer started — every 2s (plex)")
end sub

sub onDeviceStart(b as object, _ctx as object)
    m.pollType = "device"
    m.deviceCode = b.device_code
    iv = b.interval
    if iv = invalid then iv = 5
    qrValue = b.verification_uri_complete
    if qrValue = invalid then qrValue = b.verification_uri
    Log.info("device start ok — code=" + Log.trunc(b.user_code) + " interval=" + Str(iv).Trim())
    showPending("Log in with a code", "Go to " + b.verification_uri + " and enter this code, or scan:", b.user_code, qrValue)
    m.timer.duration = iv
    m.pollCount = 0
    m.timer.control = "start"
    Log.info("poll timer started — every " + Str(iv).Trim() + "s (device)")
end sub

sub onStartError(err as object, _ctx as object)
    st = 0
    if err <> invalid and err.status <> invalid then st = err.status
    Log.warn("start failed http=" + Str(st).Trim() + " — " + Log.trunc(err))
    m.error.text = "Could not reach the server."
end sub

sub onPollTick()
    m.pollCount = m.pollCount + 1
    Log.info("poll #" + Str(m.pollCount).Trim() + " " + m.pollType)
    if m.pollType = "plex"
        p = Api.plexPoll(m.pinId)
    else
        p = Api.deviceToken(m.deviceCode)
    end if
    onThen(p, onPollResult, m)
    onCatch(p, onPollError, m)
end sub

' A resolved poll (HTTP 2xx). The Plex flow returns 200 with a `status` for every state (incl. pending);
' the device flow returns 200 only once it carries an access_token.
sub onPollResult(b as object, _ctx as object)
    st = "?"
    if b <> invalid and b.status <> invalid then st = b.status
    Log.info("poll resp status=" + st + " body=" + Log.trunc(b))
    if b = invalid then return

    if m.pollType = "plex"
        if b.status = "ok"
            finishLogin(b.token)
        else if b.status = "expired"
            resetToChooser("That code expired — try again.")
        else if b.status = "unregistered"
            resetToChooser("No Airwave account for " + b.email + ". Ask an admin to import you.")
        end if
    else
        if b.access_token <> invalid
            finishLogin(b.access_token)
        end if
    end if
end sub

' A rejected poll (non-2xx). EXPECTED for the device flow while unclaimed (better-auth returns 400
' authorization_pending) — treat as "keep waiting". Only a terminal error stops the loop.
sub onPollError(err as object, _ctx as object)
    st = 0
    body = invalid
    if err <> invalid
        if err.status <> invalid then st = err.status
        body = err.body
    end if
    if body <> invalid and type(body) = "roAssociativeArray" and body.error <> invalid
        if body.error = "expired_token" or body.error = "access_denied"
            resetToChooser("That code expired or was denied — try again.")
            return
        end if
    end if
    Log.info("poll pending (http=" + Str(st).Trim() + ")")
end sub

sub finishLogin(token as string)
    m.timer.control = "stop"
    Auth.setToken(token)
    Log.info("signed in — token len=" + Str(Len(token)).Trim())
    m.top.done = true
end sub

sub resetToChooser(msg as string)
    Log.warn("reset to chooser: " + msg)
    showChooser()
    m.error.text = msg
end sub
