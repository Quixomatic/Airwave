import "pkg:/source/lib/serverUrl.bs"
import "pkg:/source/lib/api.bs"
import "pkg:/source/lib/device.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/input/keys.bs"
import "pkg:/source/theme.bs"

' Diagnostic code-behind — parity port of tv-web/tv-native features/diagnostic. Runs the server's
' capability matrix: for each clip it PLAYS it in the centered Video box (visual parity + honest
' confirmation) while the authoritative Roku decode API (Device.*) decides the recorded verdict.
' Sequential run driven by the Video `state` + settle/hardCap timers (a state machine, since Roku
' playback is event-based and BrightScript has no promises for node events).

sub init()

    Theme.setFont(m.title, Theme.FONT_BOLD, 34)
    Theme.setFont(m.subtitle, Theme.FONT_REG, 18)
    Theme.setFont(m.diag, Theme.FONT_SEMI, 22)
    Theme.setFont(m.countLeft, Theme.FONT_REG, 14)
    Theme.setFont(m.countRight, Theme.FONT_REG, 14)
    Theme.setFont(m.doneCheck, Theme.FONT_BOLD, 60)

    m.tests = invalid
    m.idx = 0
    m.pass = 0
    m.fail = 0
    m.done = false
    m.finished = false

    m.settle.observeField("fire", "onSettle")
    m.hardCap.observeField("fire", "onHardCap")
    m.continueDelay.observeField("fire", "onContinueDelay")
    m.clip.observeField("state", "onClipState")

    ' Report this device (fire-and-forget), then fetch + run the matrix.
    onCatch(Api.reportDevice(Device.report()), onReportErr, m)
    p = Api.capsManifest()
    onThen(p, onManifest, m)
    onCatch(p, onManifestErr, m)

    m.top.setFocus(true)
end sub

sub onReportErr(err as object, _ctx as object)
    Log.warn("device report failed: " + Log.trunc(err))
end sub

sub onManifest(r as object, _ctx as object)
    if r = invalid or r.tests = invalid or r.tests.count() = 0
        onManifestErr({ message: "empty manifest" }, invalid)
        return
    end if
    m.tests = r.tests
    Log.info("[caps] manifest loaded — " + Str(r.tests.count()).Trim() + " tests")
    startTest(0)
end sub

sub onManifestErr(err as object, _ctx as object)
    Log.warn("[caps] manifest error: " + Log.trunc(err))
    ' Don't nag on every login if the matrix can't load — mark done + route on.
    Device.markCapsDone()
    m.top.done = true
end sub

' ---- per-test run -------------------------------------------------------------

sub startTest(i as integer)
    m.finished = false
    m.idx = i
    cur = m.tests[i]
    Log.info("[caps] " + Str(i + 1).Trim() + "/" + Str(m.tests.count()).Trim() + " " + cur.id + " — " + Log.trunc(cur.container) + "/" + Log.trunc(cur.video) + "/" + Log.trunc(cur.audio))

    m.diag.text = cur.diagnostic
    buildChips(cur)
    animateIn()
    updateProgress()

    ' Play the clip for real (honest failures shown); the API is the verdict.
    cn = CreateObject("roSGNode", "ContentNode")
    cn.url = ServerUrl.get() + cur.url
    cn.streamFormat = streamFormatFor(cur.container)
    m.clip.content = cn
    m.clip.control = "play"
    m.hardCap.control = "start"
end sub

sub onClipState()
    if m.finished then return
    st = m.clip.state
    if st = "playing"
        m.settle.control = "start"    ' show it briefly, then record
    else if st = "error"
        finishTest(false, "video error")
    else if st = "finished"
        finishTest(true, "")
    end if
end sub

sub onSettle()
    finishTest(true, "")
end sub

sub onHardCap()
    finishTest(false, "timeout (no frame)")
end sub

' Record the hybrid verdict for the current test + advance. `playbackOk` only decides the CONTAINER
' axis (does the Video node demux it) — combined with the API so a supported container (e.g. mkv) is
' never wrongly excluded on a playback hiccup. All other axes are the authoritative API answer.
sub finishTest(playbackOk as boolean, err as string)
    if m.finished then return
    m.finished = true
    m.settle.control = "stop"
    m.hardCap.control = "stop"
    m.clip.control = "stop"

    cur = m.tests[m.idx]
    cat = cur.category
    videoOk = Device.videoVerdict(cur.video, cur.container)
    decoded = videoOk
    audioOk = invalid
    hdrOk = invalid

    if cat = "container"
        apiContainer = Device.canDecodeVideo("h264", invalid, invalid, Device.rokuContainer(cur.container))
        decoded = (playbackOk or apiContainer)
    else if cat = "audio"
        audioOk = Device.audioVerdict(cur.audio, cur.container)
    else if cat = "hdr"
        hdrOk = Device.hdrVerdict(cur.feature)
    else if cat = "perf"
        decoded = Device.perfVerdict(cur.feature)
    end if

    recordResult(cur, decoded, audioOk, hdrOk, err)
    if decoded then m.pass = m.pass + 1 else m.fail = m.fail + 1

    m.idx = m.idx + 1
    if m.idx >= m.tests.count()
        finishRun()
    else
        startTest(m.idx)
    end if
end sub

sub recordResult(cur as object, decoded as boolean, audioOk as dynamic, hdrOk as dynamic, err as string)
    pairs = [
        ["deviceId", Device.id()],
        ["testId", cur.id],
        ["container", cur.container],
        ["video", cur.video],
        ["audio", cur.audio],
        ["decoded", decoded]
    ]
    if cur.feature <> invalid then pairs.push(["feature", cur.feature])
    if cur.subtitle <> invalid then pairs.push(["subtitle", cur.subtitle])
    if audioOk <> invalid then pairs.push(["audioOk", audioOk])
    if hdrOk <> invalid then pairs.push(["hdrOk", hdrOk])
    if err <> "" then pairs.push(["error", err])
    onCatch(Api.capsResult(pairs), onRecordErr, m)
end sub

sub onRecordErr(err as object, _ctx as object)
    Log.warn("[caps] result post failed: " + Log.trunc(err))
end sub

sub finishRun()
    m.done = true
    Device.markCapsDone()
    m.clip.control = "stop"
    m.title.text = "Setup complete"
    m.subtitle.text = "We've measured exactly what your TV plays natively."
    m.testGroup.visible = false
    updateProgress()

    ' Check disc springs in (outBack pop), then the Continue button rises in after a 0.2s delay.
    m.doneMark.visible = true
    m.doneAnim.control = "start"
    m.continueBtn.visible = true
    m.continueBtn.focused = true
    m.continueDelay.control = "start"
    Log.info("[caps] done — " + Str(m.pass).Trim() + " native / " + Str(m.fail).Trim() + " transcode")
end sub

sub onContinueDelay()
    m.continueAnim.control = "start"
end sub

' ---- ui helpers ---------------------------------------------------------------

sub updateProgress()
    total = m.tests.count()
    doneCount = m.done ? total : m.idx
    curNum = m.done ? total : (m.idx + 1)
    m.progFill.width = Int(720.0 * doneCount / total)
    m.countLeft.text = Str(curNum).Trim() + " of " + Str(total).Trim()
    m.countRight.text = Str(m.pass).Trim() + " native · " + Str(m.fail).Trim() + " transcode"
end sub

sub animateIn()
    m.testGroup.opacity = 0
    m.testGroup.translation = [656, 690]
    m.testAnim.control = "start"
end sub

' Chips = the non-"none" of [container, video, audio, feature, subtitle] as uppercase pills, centered.
' Widths are heuristic (13px SemiBold) so we can center without a measure pass.
sub buildChips(cur as object)
    ch = m.chips
    while ch.getChildCount() > 0
        ch.removeChildIndex(0)
    end while
    vals = []
    for each k in [cur.container, cur.video, cur.audio, cur.feature, cur.subtitle]
        if k <> invalid and k <> "" and k <> "none" then vals.push(k)
    end for
    ' We set each pill's width explicitly, so the exact row width is known — compute the centered start
    ' x and lay the pills out left-to-right from there. No LayoutGroup / boundingRect measurement.
    widths = []
    total = 0
    for each v in vals
        w = Len(UCase(v)) * 9 + 24
        widths.push(w)
        total = total + w
    end for
    if vals.count() > 1 then total = total + (vals.count() - 1) * 8

    x = Int((720 - total) / 2)   ' center within the 720-wide testGroup (chips Group sits at [0,40])
    for i = 0 to vals.count() - 1
        w = widths[i]
        g = ch.createChild("Group")
        g.translation = [x, 0]
        p = g.createChild("Poster")
        p.uri = Theme.npFill(12)
        p.width = w
        p.height = 26
        p.blendColor = "0x94A3B824"
        lbl = g.createChild("Label")
        lbl.text = UCase(vals[i])
        lbl.width = w
        lbl.height = 26
        lbl.horizAlign = "center"
        lbl.vertAlign = "center"
        lbl.color = "0xCBD5E1FF"
        Theme.setFont(lbl, Theme.FONT_SEMI, 13)
        x = x + w + 8
    end for
end sub

' Best-effort streamFormat for a raw test clip. Playback correctness isn't critical (the API is the
' verdict); this just decides what the box shows. Unknown/unsupported containers fail honestly.
function streamFormatFor(container as string) as string
    if container = "ts" then return "ts"
    if container = "hls" then return "hls"
    if container = "dash" then return "dash"
    return "mp4"   ' mp4/mov/mkv/webm/avi/flv — try mp4; honest failure otherwise
end function

' ---- input --------------------------------------------------------------------

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = Keys.BACK
        exitDiag()
        return true
    else if key = Keys.OK and m.done
        exitDiag()
        return true
    end if
    return false
end function

sub exitDiag()
    Device.markCapsDone()
    m.clip.control = "stop"
    m.top.done = true
end sub
