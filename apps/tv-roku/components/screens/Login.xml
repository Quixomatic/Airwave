<?xml version="1.0" encoding="utf-8" ?>
<!--
  Login — port of tv-web features/auth/login.tsx, styled to match: dark bg, Inter type, amber Plex
  button + outlined code button (12px rounded), and a pending panel (16px rounded, translucent) with a
  vertical divider — heading/instruction/Back on the left, white QR card + mono code on the right.
-->
<component name="Login" extends="Group">
    <interface>
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x060A14FF" />

        <Label id="title" text="Airwave" translation="[510,290]" width="900" horizAlign="center"
            color="0x8AB4F8FF">
            <Font role="font" uri="pkg:/fonts/Inter-Bold.ttf" size="48" />
        </Label>
        <Label id="subtitle" text="Sign in to start watching." translation="[510,364]" width="900"
            horizAlign="center" color="0xA1A1AAFF">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="18" />
        </Label>

        <!-- Chooser -->
        <Group id="chooser">
            <RoundedButton id="plexBtn" translation="[700,470]" w="520" h="84" radius="12"
                fillColor="0xF59E0BFF" textColor="0x000000FF"
                focusFill="0xFBBF24FF" focusInk="0x000000FF"
                fontUri="pkg:/fonts/Inter-SemiBold.ttf" fontSize="22" text="Log in with Plex" />
            <RoundedButton id="codeBtn" translation="[700,574]" w="520" h="84" radius="12" outlined="true"
                fillColor="0x3F3F46FF" textColor="0xE4E4E7FF"
                focusFill="0x27272AFF" focusInk="0xE4E4E7FF"
                fontUri="pkg:/fonts/Inter-SemiBold.ttf" fontSize="22" text="Log in with a code" />
        </Group>

        <!-- Pending (hidden until a flow starts) -->
        <Group id="pending" visible="false">
            <Poster id="panelBg" translation="[420,300]" width="1080" height="450"
                uri="pkg:/images/np/fill-16.9.png" blendColor="0x181B24E6" />
            <Poster id="panelBorder" translation="[420,300]" width="1080" height="450"
                uri="pkg:/images/np/border-16.9.png" blendColor="0x27272AFF" />

            <Rectangle translation="[940,350]" width="2" height="360" color="0xFFFFFF1A" />

            <!-- Left column -->
            <Label id="pHeading" translation="[490,360]" width="420" wrap="true" color="0xF1F5F9FF">
                <Font role="font" uri="pkg:/fonts/Inter-SemiBold.ttf" size="26" />
            </Label>
            <Label id="pInstruction" translation="[490,440]" width="420" height="180" wrap="true"
                color="0xA1A1AAFF">
                <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="18" />
            </Label>
            <RoundedButton id="backBtn" translation="[490,648]" w="180" h="56" radius="8"
                fillColor="0x181B24E6" textColor="0xA1A1AAFF"
                focusFill="0x3F3F46FF" focusInk="0xE4E4E7FF"
                fontUri="pkg:/fonts/Inter-Medium.ttf" fontSize="16" text="← Back" />

            <!-- Right column: white QR card + mono code -->
            <Poster id="qrCard" translation="[1010,360]" width="260" height="260"
                uri="pkg:/images/np/fill-12.9.png" blendColor="0xFFFFFFFF" />
            <QRCode id="qr" translation="[1029,379]" width="222" height="222" loadDisplayMode="scaleToFit"
                ecl="MEDIUM" pixel="6" border="2" />
            <Label id="pCode" translation="[990,644]" width="300" horizAlign="center" color="0x8AB4F8FF">
                <Font role="font" uri="pkg:/fonts/JetBrainsMono-Medium.ttf" size="34" />
            </Label>
        </Group>

        <Label id="error" translation="[510,860]" width="900" height="40" horizAlign="center"
            color="0xF87171FF">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="18" />
        </Label>
        <Label id="serverLabel" translation="[510,972]" width="900" horizAlign="center" color="0x52525BFF">
            <Font role="font" uri="pkg:/fonts/Inter-Regular.ttf" size="14" />
        </Label>
    </children>
</component>
