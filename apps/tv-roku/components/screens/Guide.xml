<?xml version="1.0" encoding="utf-8" ?>
<!--
  Guide — the Aurora guide grid. Featured now/next panel (top) + a virtualized channel grid + the zone
  machine (grid ↔ rail ↔ sidebar). The Guide scene holds focus and owns all navigation in onKeyEvent
  (VirtualRowList/rows never take focus) — the port of tv-web/tv-native aurora-grid. Nav sounds via the
  SoundEffect nodes (the click we lose by not using MarkupList's built-in focus).
-->
<component name="Guide" extends="Group">
    <interface>
        <field id="tuneChannelId" type="string" alwaysNotify="true" />
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x060A14FF" />

        <!-- Featured now/next panel for the focused channel + program (fc/fp). -->
        <FeaturedPanel id="featured" translation="[92,0]" />

        <!-- Time header -->
        <Label id="dayLabel" translation="[122,498]" color="0xE6EAF1FF" />
        <Group id="ticks" translation="[243,492]" />

        <!-- Grid viewport — our own virtualized list, scrolled + focused by the zone machine. -->
        <Group id="gridClip" translation="[92,546]">
            <VirtualRowList id="list" itemComponent="ChannelRow" />
        </Group>

        <!-- Now-marker: only the pulsing red caret shows (the vertical line stays hidden). -->
        <Poster id="nowCaret" uri="pkg:/images/caret-down.png" blendColor="0xEF4444FF" visible="false" />
        <Animation id="caretPulse" duration="2" repeat="true" easeFunction="linear">
            <FloatFieldInterpolator key="[0.0,0.5,1.0]" keyValue="[1.0,0.55,1.0]"
                fieldToInterp="nowCaret.opacity" />
        </Animation>

        <Label id="msg" translation="[510,500]" width="900" horizAlign="center" color="0x94A3B8FF"
            text="Loading…" />

        <!-- Empty-lens placeholder (faint skeleton + centered message), in the guide column. -->
        <GuideGhost id="ghost" translation="[92,0]" visible="false" />

        <!-- 60s guide re-fetch (tv-web/native refetchInterval) — advances now/on-now/progress. -->
        <Timer id="refreshTimer" repeat="true" duration="60" />

        <!-- Left sidebar — overlays the grid's left edge (grid always reserves the 92px sliver). Last child
             = highest z, so the expanded overlay draws above the featured panel + grid. Owns its own dim
             scrim (first child) so the expand/collapse slide + scrim fade animate together. -->
        <GuideSidebar id="sidebar" />
    </children>
</component>
