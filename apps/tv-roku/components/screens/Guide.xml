<?xml version="1.0" encoding="utf-8" ?>
<!--
  Guide — the Aurora guide grid (6a foundation: time header + channel rows + 2-tone on-now cells +
  now-line). Fetches the cross-channel grid via Api.guide and renders a MarkupList of ChannelRow.
  Featured panel (top reserve), sidebar, and the full zone machine land in 6b/6c. Ported from
  tv-web/tv-native features/guide.
-->
<component name="Guide" extends="Group">
    <interface>
        <field id="tuneChannelId" type="string" alwaysNotify="true" />
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x060A14FF" />

        <!-- Featured now/next panel for the focused channel (the top area above the grid). -->
        <FeaturedPanel id="featured" translation="[92,0]" />

        <!-- Time header -->
        <Label id="dayLabel" translation="[122,498]" color="0xE6EAF1FF" />
        <Group id="ticks" translation="[243,492]" />

        <!-- Grid viewport. floatingFocus = the focus moves through the visible rows and only
             snap-scrolls when the focused row would fall off the top/bottom edge (tv-web/native feel). -->
        <Group id="gridClip" translation="[92,546]">
            <MarkupList id="list" translation="[0,0]" drawFocusFeedback="false"
                vertFocusAnimationStyle="fixedFocusWrap" />
        </Group>

        <!-- Now-marker: only the pulsing red caret shows (the vertical line stays hidden), matching
             tv-web/tv-native. -->
        <Poster id="nowCaret" uri="pkg:/images/caret-down.png" blendColor="0xEF4444FF" visible="false" />
        <Animation id="caretPulse" duration="2" repeat="true" easeFunction="linear">
            <FloatFieldInterpolator key="[0.0,0.5,1.0]" keyValue="[1.0,0.55,1.0]"
                fieldToInterp="nowCaret.opacity" />
        </Animation>

        <Label id="msg" translation="[510,500]" width="900" horizAlign="center" color="0x94A3B8FF"
            text="Loading…" />
    </children>
</component>
