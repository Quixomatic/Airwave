<?xml version="1.0" encoding="utf-8" ?>
<!--
  PlayerHost — Phase 7 first slice: a single, never-unmounted full-screen Video node. The owner (MainScene)
  sets channelId/ratingKey/offset then bumps `go` to tune; PlayerHost resolves /media and plays. Back →
  stop + set `done` (MainScene returns to the guide). The effectiveTime DVR clock / rollover / chrome are
  Phase 8/9 — this slice just proves the Video node + direct-play/HDR on the real library.
-->
<component name="PlayerHost" extends="Group">
    <interface>
        <field id="channelId" type="string" />
        <field id="ratingKey" type="string" />
        <field id="offset" type="integer" />
        <field id="go" type="integer" value="0" alwaysNotify="true" onChange="onGo" />
        <!-- MainScene observes this to hide the player + refocus the guide. -->
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" />
        <!-- Debug readout (bottom) — mode/format while tuning; cleared once playing. -->
        <Label id="status" translation="[80,984]" width="1760" color="0x94A3B8FF" />
    </children>
</component>
