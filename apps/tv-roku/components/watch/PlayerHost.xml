<?xml version="1.0" encoding="utf-8" ?>
<!--
  PlayerHost — the effectiveTime DVR clock (Phase 8 core), ported from tv-web/tv-native `use-tv-player`.
  ONE persistent Video node driven by a single clock over the whole channel timeline: derive the current
  slot + offset from real playback position, roll at boundaries (program → bumper → next), never seek past
  live, and rewind OUT of the current program through the bumper into the previous one (goTo(anyTime) →
  (ratingKey, offset)). MainScene sets `channelId` then bumps `go` to tune; the clock bootstraps at
  resume-or-live. Back → teardown + `done` (MainScene returns to the guide).

  Increment A = the clock only (full-screen, chrome-less). Media remote keys (Play/Rewind/FF/Replay) drive
  the DVR so it's testable before the FeaturePanel chrome (Increment C). Layout modes (mini/full) = Incr B.
-->
<component name="PlayerHost" extends="Group">
    <interface>
        <field id="channelId" type="string" />
        <!-- Channel identity for the chrome's channel chip (set by MainScene from the guide). -->
        <field id="channelNumber" type="integer" />
        <field id="channelName" type="string" />
        <field id="accent" type="string" value="0x3B82F6FF" />
        <field id="go" type="integer" value="0" alwaysNotify="true" onChange="onGo" />
        <!-- Surface layout: off | mini (docked in the guide) | full. miniFocused shows the Full/Close overlay. -->
        <field id="layout" type="string" value="off" onChange="onLayout" />
        <field id="miniFocused" type="boolean" onChange="onLayout" />
        <!-- The mini-feed dock rect (set by MainScene from the guide's featured-panel slot). -->
        <field id="dockX" type="integer" value="1216" />
        <field id="dockY" type="integer" value="96" />
        <field id="dockW" type="integer" value="624" />
        <field id="dockH" type="integer" value="351" />
        <!-- PlayerHost → MainScene surface commands: goMini | goFull | close | blurMini. -->
        <field id="playerCmd" type="string" alwaysNotify="true" />
        <!-- MainScene observes this to hide the player + refocus the guide. -->
        <field id="done" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
        <!-- ONE media pipeline: this Video node plays the program AND (audio-only) the bumper-music bed. -->
        <Video id="video" width="1920" height="1080" />
        <!-- Debug readout (bottom) — the clock's state/position/rollover while chrome-less (Incr A). -->
        <Label id="status" translation="[80,984]" width="1760" color="0x94A3B8FF" />
        <!-- The effectiveTime tick (rollover + status), the session heartbeat, and the 120s timeline refetch. -->
        <Timer id="tickTimer" repeat="true" duration="0.5" />
        <Timer id="heartbeatTimer" repeat="true" duration="10" />
        <Timer id="timelineTimer" repeat="true" duration="120" />
        <!-- One-shot backstop: log a PlaybackLog row as "not_decoding" if a load never reaches playing/error. -->
        <Timer id="logTimer" repeat="false" duration="9" />
    </children>
</component>
