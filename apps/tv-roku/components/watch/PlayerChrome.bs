import "pkg:/source/theme.bs"
import "pkg:/source/lib/icon.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/input/keys.bs"

' PlayerChrome code-behind — see the .xml header. Builds the chip + panel + scrubber + control row in code,
' renders from the pushed `playerStatus`, and drives the player via the `command` output field.

' Layout (FHD, ~1:1 with tv-web's watch chrome at 1920). Panel occupies the bottom band.
const PANEL_TOP = 700
const PAD_X = 56
const SCRUB_W = 1808          ' 1920 − 2*PAD_X
const SCRUB_Y = 876           ' bar centreline within the panel
const CTL_Y = 928
const CTL_H = 54
const SEG_POOL = 24

' Colors (ARGB).
const C_TEXT = "0xF1F5F9FF"
const C_SUB = "0xC3C9D4FF"
const C_PANEL = "0x060A14E6"
const C_GLASS = "0x121826A6"      ' rgba(18,24,38,0.65)
const C_GLASS_BORDER = "0xFFFFFF1F"
const C_SEG_PROG = "0xFFFFFF2E"   ' rgba(255,255,255,0.18)
const C_SEG_BUMP = "0x94A3B84D"   ' rgba(148,163,184,0.30)
const C_LIVE = "0xEF4444FF"
const C_MUTED = "0x94A3B8FF"

sub init()
    m.open = false
    m.row = 0
    m.col = 0
    m.status = invalid
    m.hideTimer.observeField("fire", "onHideFire")
    buildChip()
    buildPanel()
    m.top.visible = false
end sub

' ---- build (once) -----------------------------------------------------------

sub buildChip()
    g = m.top.createChild("Group")
    g.id = "chip"
    g.visible = false
    bg = g.createChild("Rectangle")
    bg.id = "chipBg"
    bg.color = C_GLASS
    bg.height = 56
    bg.translation = [0, 0]
    num = g.createChild("Label")
    num.id = "chipNum"
    Theme.setFont(num, Theme.FONT_BOLD, 22)
    num.translation = [18, 14]
    nm = g.createChild("Label")
    nm.id = "chipName"
    Theme.setFont(nm, Theme.FONT_SEMI, 22)
    nm.color = C_TEXT
    nm.translation = [0, 14]
    m.chip = g
    m.chipBg = bg
    m.chipNum = num
    m.chipName = nm
end sub

sub buildPanel()
    p = m.top.createChild("Group")
    p.id = "panel"
    p.visible = false

    bg = p.createChild("Rectangle")
    bg.color = C_PANEL
    bg.width = 1920
    bg.height = 1080 - PANEL_TOP
    bg.translation = [0, PANEL_TOP]

    title = p.createChild("Label")
    Theme.setFont(title, Theme.FONT_BOLD, 40)
    title.color = C_TEXT
    title.translation = [PAD_X, 740]
    title.width = 1500
    title.maxLines = 1
    m.title = title

    subLbl = p.createChild("Label")
    Theme.setFont(subLbl, Theme.FONT_REG, 20)
    subLbl.color = C_SUB
    subLbl.translation = [PAD_X, 792]
    subLbl.width = 1500
    m.subTitle = subLbl

    ' Scrubber — a pool of segment bars (+ per-segment accent fill), a thumb, a live marker, and the
    ' position / LIVE labels. All positioned in renderScrubber.
    scrub = p.createChild("Group")
    scrub.translation = [PAD_X, SCRUB_Y]
    m.segBg = []
    m.segFill = []
    for i = 0 to SEG_POOL - 1
        b = scrub.createChild("Rectangle")
        b.height = 8
        b.color = C_SEG_PROG
        b.visible = false
        m.segBg.push(b)
        f = scrub.createChild("Rectangle")
        f.height = 8
        f.color = m.top.accent
        f.visible = false
        m.segFill.push(f)
    end for
    live = scrub.createChild("Rectangle")
    live.width = 2
    live.height = 16
    live.color = C_LIVE
    live.translation = [0, -4]
    live.visible = false
    m.liveMark = live
    thumb = scrub.createChild("Rectangle")
    thumb.width = 16
    thumb.height = 16
    thumb.color = "0xFFFFFFFF"
    thumb.translation = [0, -4]
    m.thumb = thumb

    posLbl = p.createChild("Label")
    Theme.setFont(posLbl, Theme.FONT_MED, 17)
    posLbl.color = C_SUB
    posLbl.translation = [PAD_X, SCRUB_Y + 20]
    m.posLbl = posLbl

    liveLbl = p.createChild("Label")
    Theme.setFont(liveLbl, Theme.FONT_BOLD, 15)
    liveLbl.horizAlign = "right"
    liveLbl.width = SCRUB_W
    liveLbl.translation = [PAD_X, SCRUB_Y + 20]
    m.liveLbl = liveLbl

    buildControls(p)
    m.panel = p
end sub

' Controls: 5 text pills (Pause/Restart/Surf/Info/Live) left-aligned, then 3 circle selectors right-aligned.
' Fixed pill widths (labels are known) — exact text-fit is a later polish pass.
sub buildControls(parent as object)
    m.ctl = []
    m.ctlMeta = [
        { icon: "lucide:Pause", label: "Pause", w: 150, circle: false },
        { icon: "lucide:RotateCcw", label: "Restart", w: 150, circle: false },
        { icon: "lucide:Tv", label: "Channel Surf", w: 205, circle: false },
        { icon: "lucide:Info", label: "Info", w: 120, circle: false },
        { icon: "lucide:Radio", label: "Jump to Live", w: 210, circle: false },
        { icon: "lucide:AudioLines", label: "", w: 54, circle: true },
        { icon: "lucide:Captions", label: "", w: 54, circle: true },
        { icon: "lucide:SlidersHorizontal", label: "", w: 54, circle: true }
    ]
    ' left cluster (pills)
    x = PAD_X
    for i = 0 to 4
        meta = m.ctlMeta[i]
        m.ctl.push(buildButton(parent, meta, x))
        x = x + meta.w + 12
    end for
    ' right cluster (circles), right-aligned at the panel's right padding
    rx = 1920 - PAD_X - (54 * 3 + 12 * 2)
    for i = 5 to 7
        meta = m.ctlMeta[i]
        m.ctl.push(buildButton(parent, meta, rx))
        rx = rx + 54 + 12
    end for
end sub

function buildButton(parent as object, meta as object, x as integer) as object
    g = parent.createChild("Group")
    g.translation = [x, CTL_Y]
    bg = g.createChild("Rectangle")
    bg.width = meta.w
    bg.height = CTL_H
    bg.color = C_GLASS
    iconLbl = g.createChild("Label")
    iconSize = 22
    if meta.circle
        Icon.apply(iconLbl, meta.icon, iconSize, C_TEXT)
        iconLbl.translation = [Int(meta.w / 2) - 11, Int((CTL_H - 26) / 2)]
    else
        Icon.apply(iconLbl, meta.icon, iconSize, C_TEXT)
        iconLbl.translation = [20, Int((CTL_H - 26) / 2)]
        txt = g.createChild("Label")
        Theme.setFont(txt, Theme.FONT_SEMI, 17)
        txt.color = C_TEXT
        txt.text = meta.label
        txt.translation = [52, Int((CTL_H - 22) / 2)]
    end if
    return { group: g, bg: bg, icon: iconLbl, meta: meta }
end function

' ---- activation / focus ------------------------------------------------------

sub onActive()
    if m.top.active
        m.open = false
        m.row = 0
        m.col = 0
        m.top.visible = true
        showPanel(false)
        m.top.setFocus(true)
    else
        m.top.visible = false
        m.hideTimer.control = "stop"
    end if
end sub

sub showPanel(vis as boolean)
    m.open = vis
    m.panel.visible = vis
    m.chip.visible = vis
    if vis
        m.row = 0
        m.col = 0
        armHide()
        render()
    else
        m.hideTimer.control = "stop"
    end if
end sub

sub armHide()
    m.hideTimer.control = "stop"
    m.hideTimer.control = "start"
end sub

sub onHideFire()
    showPanel(false)
end sub

' ---- render ------------------------------------------------------------------

sub onStatus()
    m.status = m.top.playerStatus
    if m.open then render()
end sub

sub render()
    st = m.status
    if st = invalid then return
    renderChip()

    g = st.guide
    isEpisode = (g <> invalid and g.showTitle <> invalid and g.showTitle <> "" and g.season <> invalid and g.episode <> invalid)
    if isEpisode
        m.title.text = g.showTitle
        sfx = "S" + Str(g.season).Trim() + ", E" + Str(g.episode).Trim()
        if g.title <> invalid and g.title <> "" then sfx = sfx + " · " + g.title
        m.subTitle.text = sfx
        m.subTitle.visible = true
    else
        if g <> invalid and g.title <> invalid then m.title.text = g.title else m.title.text = ""
        m.subTitle.visible = false
    end if

    renderScrubber()
    renderControls()
end sub

sub renderChip()
    m.chipNum.color = m.top.accent
    m.chipNum.text = Str(m.top.channelNumber).Trim()
    m.chipName.text = m.top.channelName
    ' width = number + gap + name + padding; right-align the whole chip at x = 1880.
    numW = Len(m.chipNum.text) * 15
    nameW = Len(m.chipName.text) * 13
    w = 18 + numW + 12 + nameW + 22
    m.chipNum.translation = [18, 14]
    m.chipName.translation = [18 + numW + 12, 14]
    m.chipBg.width = w
    m.chip.translation = [1880 - w, 28]
end sub

sub renderScrubber()
    sc = m.status.scrubber
    scrubFocused = (m.row = 0)
    if sc = invalid
        for each b in m.segBg
            b.visible = false
        end for
        for each f in m.segFill
            f.visible = false
        end for
        return
    end if
    segs = sc.segments
    n = segs.count()
    for i = 0 to SEG_POOL - 1
        if i < n
            seg = segs[i]
            left = Int(seg.leftPct / 100.0 * SCRUB_W) + 2
            wide = Int(seg.widthPct / 100.0 * SCRUB_W) - 4
            if wide < 1 then wide = 1
            b = m.segBg[i]
            b.translation = [left, 0]
            b.width = wide
            if seg.kind = "BUMPER" then b.color = C_SEG_BUMP else b.color = C_SEG_PROG
            b.visible = true
            f = m.segFill[i]
            if seg.fillPct > 0
                f.translation = [left, 0]
                f.width = Int(seg.fillPct / 100.0 * wide)
                f.color = m.top.accent
                f.visible = true
            else
                f.visible = false
            end if
        else
            m.segBg[i].visible = false
            m.segFill[i].visible = false
        end if
    end for

    ' thumb
    tx = Int(sc.thumbPct / 100.0 * SCRUB_W)
    sz = 16
    if scrubFocused then sz = 24
    m.thumb.width = sz
    m.thumb.height = sz
    m.thumb.translation = [tx - Int(sz / 2), 4 - Int(sz / 2)]

    ' live marker
    if sc.liveVisible
        m.liveMark.translation = [Int(sc.livePct / 100.0 * SCRUB_W) - 1, -4]
        m.liveMark.visible = true
    else
        m.liveMark.visible = false
    end if

    ' position + LIVE labels
    m.posLbl.text = fmtDur(sc.slotPositionS)
    m.posLbl.translation = [PAD_X + tx - 20, SCRUB_Y + 20]
    if scrubFocused then m.posLbl.color = C_TEXT else m.posLbl.color = C_SUB
    if sc.atLive
        m.liveLbl.text = "● LIVE"
        m.liveLbl.color = C_LIVE
    else
        m.liveLbl.text = "-" + fmtDur(sc.behindS)
        m.liveLbl.color = C_MUTED
    end if
end sub

sub renderControls()
    st = m.status
    paused = (st.paused = true)
    atLive = true
    if st.scrubber <> invalid then atLive = st.scrubber.atLive

    ' focus fill
    for i = 0 to m.ctl.count() - 1
        if m.open and m.row = 1 and m.col = i
            m.ctl[i].bg.color = withAlpha(m.top.accent, 0.28)
        else
            m.ctl[i].bg.color = C_GLASS
        end if
    end for

    ' Pause⇄Play (icon + label)
    if paused then Icon.apply(m.ctl[0].icon, "lucide:Play", 22, C_TEXT) else Icon.apply(m.ctl[0].icon, "lucide:Pause", 22, C_TEXT)
    setPillText(0, paused ? "Play" : "Pause")
    ' Live⇄Continue (icon + label)
    if atLive then Icon.apply(m.ctl[4].icon, "lucide:Clapperboard", 22, C_TEXT) else Icon.apply(m.ctl[4].icon, "lucide:Radio", 22, C_TEXT)
    setPillText(4, atLive ? "Jump to Live" : "Continue Watching")
end sub

' Update a pill's text child (group children: bg=0, icon=1, text=2).
sub setPillText(idx as integer, label as string)
    g = m.ctl[idx].group
    if g.getChildCount() >= 3 then g.getChild(2).text = label
end sub

' ---- keys --------------------------------------------------------------------

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if not m.top.active then return false

    if not m.open
        ' Panel closed: OK/▲/▼ opens it; Back → guide; ◄► → surf (Incr D).
        if key = Keys.OK or key = Keys.UP or key = Keys.DOWN
            showPanel(true)
            return true
        else if key = Keys.BACK
            fire("back", "")
            return true
        else if key = Keys.LEFT or key = Keys.RIGHT
            fire("surf", "")
            return true
        end if
        return false
    end if

    ' Panel open.
    armHide()
    if key = Keys.BACK
        showPanel(false)
        return true
    end if
    if m.row = 0
        if key = Keys.LEFT
            fire("seekBack", "")
        else if key = Keys.RIGHT
            fire("seekFwd", "")
        else if key = Keys.OK
            fire("pause", "")
        else if key = Keys.DOWN
            m.row = 1
            m.col = 0
            renderControls()
            renderScrubber()
        end if
        return true
    end if
    ' row 1 — controls
    if key = Keys.LEFT
        if m.col > 0 then m.col = m.col - 1
        renderControls()
    else if key = Keys.RIGHT
        if m.col < m.ctl.count() - 1 then m.col = m.col + 1
        renderControls()
    else if key = Keys.UP
        m.row = 0
        renderControls()
        renderScrubber()
    else if key = Keys.OK
        activate(m.col)
    end if
    return true
end function

sub activate(col as integer)
    if col = 0
        fire("pause", "")
    else if col = 1
        fire("restart", "")
    else if col = 2
        fire("surf", "")
    else if col = 3
        Log.info("[chrome] Info (Incr C2)")
    else if col = 4
        fire("live", "")
    else
        Log.info("[chrome] picker (Incr C2)")
    end if
end sub

sub fire(cmd as string, arg as string)
    m.top.commandArg = arg
    m.top.command = cmd
end sub

' ---- helpers ----------------------------------------------------------------

' "0xRRGGBBAA" + alpha(0–1) → "0xRRGGBB" + alpha byte.
function withAlpha(argb as string, a as double) as string
    base = Left(argb, 8)   ' "0xRRGGBB"
    v = Int(a * 255.0)
    if v < 0 then v = 0
    if v > 255 then v = 255
    hexd = "0123456789ABCDEF"
    hi = Mid(hexd, (v \ 16) + 1, 1)
    lo = Mid(hexd, (v mod 16) + 1, 1)
    return base + hi + lo
end function

function fmtDur(total as double) as string
    s = Int(total)
    if s < 0 then s = 0
    h = s \ 3600
    mn = (s mod 3600) \ 60
    sec = s mod 60
    ss = sec.toStr()
    if sec < 10 then ss = "0" + ss
    if h > 0
        mm = mn.toStr()
        if mn < 10 then mm = "0" + mm
        return h.toStr() + ":" + mm + ":" + ss
    end if
    return mn.toStr() + ":" + ss
end function
