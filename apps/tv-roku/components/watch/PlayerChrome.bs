import "pkg:/source/theme.bs"
import "pkg:/source/lib/icon.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/input/keys.bs"

' PlayerChrome code-behind — see the .xml header. Builds the chip + panel + scrubber + control row from
' 9-patch/circle assets (tinted white masters), renders from the pushed `playerStatus`, animates in
' (chip drops from the top, panel rises from the bottom — tv-web parity), and drives the player via the
' `command` output field.

' Layout (FHD, ~1:1 with tv-web's 1920 watch chrome).
const PANEL_TOP = 700
const PAD_X = 56
const SCRUB_W = 1808
const SCRUB_Y = 878
const CTL_Y = 928
const CTL_H = 54

const SEG_POOL = 24
const PICKER_POOL = 12
const CARD_W = 520
const ROW_H = 50

' Assets.
const A_PILL = "pkg:/images/pill-fill.9.png"
const A_PILL_RING = "pkg:/images/pill-ring.9.png"
const A_PILL_FOCUS = "pkg:/images/pill-focus.9.png"
const A_BAR = "pkg:/images/bar-fill.9.png"
const A_SCRIM = "pkg:/images/scrim-player.png"
const A_C36 = "pkg:/images/circle-36.png"
const A_C54 = "pkg:/images/circle-54.png"
const A_RING54 = "pkg:/images/ring-54.png"
const A_RING62 = "pkg:/images/ring-62.png"
const A_THUMB = "pkg:/images/circle-24.png"
const A_THUMB_SM = "pkg:/images/circle-16.png"
const A_HALO = "pkg:/images/circle-34.png"
const A_CARD = "pkg:/images/card.9.png"
const A_CHIP = "pkg:/images/chip.9.png"

' Colors (ARGB) — the control-row FOCUS is a fixed blue (tv-web), NOT the channel accent; the accent is for
' the scrubber fill/thumb-halo + the chip.
const BLUE = "0x3B82F6"
const C_TEXT = "0xF1F5F9FF"
const C_SUB = "0xC3C9D4FF"
const C_NAME = "0xE6EAF1FF"
const C_GLASS = "0x121826D9"        ' rgba(18,24,38,0.55)-ish bg fill (blendColor a white pill)
const C_BORDER = "0xFFFFFF1F"       ' white @0.12
const C_BORDER_FOCUS = "0xFFFFFF66" ' white @0.4
const C_FOCUS_BG = "0x3B82F647"     ' blue @0.28
const C_FOCUS_RING = "0x3B82F6B3"   ' blue @0.7
const C_SEG_PROG = "0xFFFFFF2E"     ' white @0.18
const C_SEG_BUMP = "0x94A3B84D"     ' slate @0.30
const C_LIVE = "0xEF4444FF"
const C_MUTED = "0x94A3B8FF"
const C_DETAIL = "0xDFE4ECFF"
const C_HINT = "0x64748BFF"
const C_MODAL = "0x0F1523F2"        ' picker card fill (dark glass, ~0.95 — no live blur so a touch more opaque)
const C_DIM = "0x04060C99"          ' full-screen dim behind the modal
const C_MODAL_TITLE = "0xFFFFFF9E"  ' rgba(255,255,255,0.62)

sub init()
    m.open = false
    m.row = 0
    m.col = 0
    m.status = invalid
    m.infoMode = false
    m.picker = invalid          ' invalid | "audio" | "subtitle" | "quality"
    m.pickerSel = 0
    m.pickerItems = []
    m.selQuality = "original"
    m.selAudio = ""
    m.selSub = "off"
    m.hideTimer.observeField("fire", "onHideFire")
    buildChip()
    buildPanel()
    buildPicker()
    buildAnims()
    m.top.visible = false
end sub

' ---- build (once) -----------------------------------------------------------

sub buildChip()
    wrap = m.top.createChild("Group")   ' positioned by renderChip (right-aligned)
    inner = wrap.createChild("Group")   ' the animated one (slide + fade)
    inner.id = "chipInner"

    bg = inner.createChild("Poster")
    bg.uri = A_PILL
    bg.blendColor = C_GLASS
    bg.height = 56
    ring = inner.createChild("Poster")
    ring.uri = A_PILL_RING
    ring.blendColor = C_BORDER
    ring.height = 56

    iconC = inner.createChild("Poster")
    iconC.uri = A_C36
    iconC.width = 36
    iconC.height = 36
    iconC.translation = [10, 10]
    iconG = inner.createChild("Label")
    Icon.apply(iconG, "lucide:Tv", 20, C_TEXT)
    iconG.translation = [18, 15]

    num = inner.createChild("Label")
    Theme.setFont(num, Theme.FONT_BOLD, 22)
    nm = inner.createChild("Label")
    Theme.setFont(nm, Theme.FONT_SEMI, 22)
    nm.color = C_NAME

    m.chipWrap = wrap
    m.chipInner = inner
    m.chipBg = bg
    m.chipRing = ring
    m.chipIconC = iconC
    m.chipIconG = iconG
    m.chipNum = num
    m.chipName = nm
end sub

sub buildPanel()
    p = m.top.createChild("Group")
    p.id = "panelGrp"

    scrim = p.createChild("Poster")
    scrim.uri = A_SCRIM
    scrim.width = 1920
    scrim.height = 1080 - PANEL_TOP
    scrim.translation = [0, PANEL_TOP]
    m.scrim = scrim

    title = p.createChild("Label")
    Theme.setFont(title, Theme.FONT_BOLD, 40)
    title.color = C_TEXT
    title.translation = [PAD_X, 744]
    title.width = 1500
    title.maxLines = 1
    m.title = title

    subLbl = p.createChild("Label")
    Theme.setFont(subLbl, Theme.FONT_REG, 20)
    subLbl.color = C_SUB
    subLbl.translation = [PAD_X, 796]
    subLbl.width = 1500
    m.subTitle = subLbl

    ' body = scrubber + controls (hidden in Info mode; the title/sub stay). Info content is a sibling.
    body = p.createChild("Group")
    m.body = body

    ' Scrubber pool — rounded bar posters (bg + accent fill), a circular thumb + focus halo, a live marker.
    scrub = body.createChild("Group")
    scrub.translation = [PAD_X, SCRUB_Y]
    m.segBg = []
    m.segFill = []
    for i = 0 to SEG_POOL - 1
        b = scrub.createChild("Poster")
        b.uri = A_BAR
        b.height = 8
        b.visible = false
        m.segBg.push(b)
        f = scrub.createChild("Poster")
        f.uri = A_BAR
        f.height = 8
        f.blendColor = m.top.accent
        f.visible = false
        m.segFill.push(f)
    end for
    live = scrub.createChild("Rectangle")
    live.width = 2
    live.height = 16
    live.color = C_LIVE
    live.translation = [0, -4]
    live.visible = false
    m.liveMark = live
    halo = scrub.createChild("Poster")
    halo.uri = A_HALO
    halo.width = 34
    halo.height = 34
    halo.visible = false
    m.thumbHalo = halo
    thumb = scrub.createChild("Poster")
    thumb.uri = A_THUMB
    thumb.width = 16
    thumb.height = 16
    thumb.blendColor = "0xFFFFFFFF"
    m.thumb = thumb

    posLbl = body.createChild("Label")
    Theme.setFont(posLbl, Theme.FONT_MED, 17)
    posLbl.color = C_SUB
    m.posLbl = posLbl

    liveDot = body.createChild("Poster")
    liveDot.uri = A_THUMB_SM
    liveDot.width = 9
    liveDot.height = 9
    liveDot.blendColor = C_LIVE
    m.liveDot = liveDot
    liveLbl = body.createChild("Label")
    Theme.setFont(liveLbl, Theme.FONT_BOLD, 15)
    liveLbl.horizAlign = "right"
    liveLbl.width = SCRUB_W - 20
    liveLbl.translation = [PAD_X, SCRUB_Y + 20]
    m.liveLbl = liveLbl

    buildControls(body)
    buildInfo(p)
    m.panel = p
end sub

sub buildControls(parent as object)
    m.ctl = []
    m.ctlMeta = [
        { icon: "lucide:Pause", label: "Pause", w: 150, circle: false },
        { icon: "lucide:RotateCcw", label: "Restart", w: 150, circle: false },
        { icon: "lucide:Tv", label: "Channel Surf", w: 205, circle: false },
        { icon: "lucide:Info", label: "Info", w: 120, circle: false },
        { icon: "lucide:Radio", label: "Jump to Live", w: 215, circle: false },
        { icon: "lucide:AudioLines", label: "", w: 54, circle: true },
        { icon: "lucide:Captions", label: "", w: 54, circle: true },
        { icon: "lucide:SlidersHorizontal", label: "", w: 54, circle: true }
    ]
    x = PAD_X
    for i = 0 to 4
        m.ctl.push(buildButton(parent, m.ctlMeta[i], x))
        x = x + m.ctlMeta[i].w + 12
    end for
    rx = 1920 - PAD_X - (54 * 3 + 12 * 2)
    for i = 5 to 7
        m.ctl.push(buildButton(parent, m.ctlMeta[i], rx))
        rx = rx + 54 + 12
    end for
end sub

function buildButton(parent as object, meta as object, x as integer) as object
    g = parent.createChild("Group")
    g.translation = [x, CTL_Y]
    if meta.circle
        focusRing = g.createChild("Poster")
        focusRing.uri = A_RING62
        focusRing.width = 62
        focusRing.height = 62
        focusRing.translation = [-4, -4]
        focusRing.blendColor = C_FOCUS_RING
        focusRing.visible = false
        bg = g.createChild("Poster")
        bg.uri = A_C54
        bg.width = 54
        bg.height = 54
        bg.blendColor = C_GLASS
        ring = g.createChild("Poster")
        ring.uri = A_RING54
        ring.width = 54
        ring.height = 54
        ring.blendColor = C_BORDER
        iconLbl = g.createChild("Label")
        Icon.apply(iconLbl, meta.icon, 22, C_TEXT)
        iconLbl.translation = [16, 14]
        return { group: g, bg: bg, ring: ring, focusRing: focusRing, icon: iconLbl, meta: meta }
    end if
    focusRing = g.createChild("Poster")
    focusRing.uri = A_PILL_FOCUS
    focusRing.height = CTL_H + 4
    focusRing.width = meta.w + 4
    focusRing.translation = [-2, -2]
    focusRing.blendColor = C_FOCUS_RING
    focusRing.visible = false
    bg = g.createChild("Poster")
    bg.uri = A_PILL
    bg.width = meta.w
    bg.height = CTL_H
    bg.blendColor = C_GLASS
    ring = g.createChild("Poster")
    ring.uri = A_PILL_RING
    ring.width = meta.w
    ring.height = CTL_H
    ring.blendColor = C_BORDER
    iconLbl = g.createChild("Label")
    Icon.apply(iconLbl, meta.icon, 22, C_TEXT)
    iconLbl.translation = [20, 14]
    txt = g.createChild("Label")
    Theme.setFont(txt, Theme.FONT_SEMI, 17)
    txt.color = C_TEXT
    txt.text = meta.label
    txt.translation = [52, 16]
    return { group: g, bg: bg, ring: ring, focusRing: focusRing, icon: iconLbl, txt: txt, meta: meta }
end function

' In: chip drops from the top (y −30 → 0 + fade), panel rises from the bottom (y 48 → 0 + fade). Out: the
' reverse (tv-web's exit transition). On the out-animation finishing, the nodes are hidden.
sub buildAnims()
    m.chipIn = mkAnim("chipInner", [0, -30], [0, 0], 0.0, 1.0)
    m.chipOut = mkAnim("chipInner", [0, 0], [0, -30], 1.0, 0.0)
    m.panelIn = mkAnim("panelGrp", [0, 48], [0, 0], 0.0, 1.0)
    m.panelOut = mkAnim("panelGrp", [0, 0], [0, 48], 1.0, 0.0)
    m.panelOut.observeField("state", "onOutDone")
end sub

function mkAnim(nodeId as string, fromXY as object, toXY as object, fromO as double, toO as double) as object
    a = m.top.createChild("Animation")
    a.duration = 0.22
    a.easeFunction = "outQuad"
    v = a.createChild("Vector2DFieldInterpolator")
    v.fieldToInterp = nodeId + ".translation"
    v.key = [0.0, 1.0]
    v.keyValue = [fromXY, toXY]
    o = a.createChild("FloatFieldInterpolator")
    o.fieldToInterp = nodeId + ".opacity"
    o.key = [0.0, 1.0]
    o.keyValue = [fromO, toO]
    return a
end function

' The out-animation finished → hide the panel/chip (unless a reopen already happened).
sub onOutDone()
    if m.panelOut.state = "stopped" and not m.open
        m.panel.visible = false
        m.chipWrap.visible = false
    end if
end sub

' ---- activation / focus ------------------------------------------------------

sub onActive()
    if m.top.active
        m.top.visible = true
        openPanel(true)   ' open on tune; the hide timer waits for playback (below), then the 8s timeout runs
        m.top.setFocus(true)
    else
        m.top.visible = false
        m.open = false
        m.hideTimer.control = "stop"
    end if
end sub

' Open the panel + play the in-animation. `loading` = opened at tune-time (before playback) → the 8s
' auto-hide waits until the first real status arrives (onStatus), matching tv-web/native.
sub onRetune()
    if m.top.active then openPanel(true)   ' a (re)tune resets the panel (clear scrubber, show Tuning)
end sub

sub openPanel(loading as boolean)
    wasOpen = m.open
    m.open = true
    m.row = 0
    m.col = 0
    m.awaitingPlay = loading
    ' A reopened panel starts clean: Info + any picker closed, body (scrubber+controls) shown.
    m.infoMode = false
    m.picker = invalid
    m.infoGroup.visible = false
    m.pickerDim.visible = false
    m.pickerGroup.visible = false
    m.body.visible = true
    ' restore the scrubber-mode title/scrim (Info mode had raised them)
    m.title.translation = [PAD_X, 744]
    m.subTitle.translation = [PAD_X, 796]
    m.scrim.translation = [0, PANEL_TOP]
    m.scrim.height = 1080 - PANEL_TOP
    m.panel.visible = true
    m.chipWrap.visible = true
    if loading
        m.status = invalid       ' drop any stale (previous-channel) status so no old thumb/scrubber shows
        clearScrubber()
    end if
    render()
    if loading then m.title.text = "Tuning…"
    if not wasOpen   ' only (re)play the slide-in when the panel wasn't already open (re-tune keeps it up)
        m.chipOut.control = "stop"
        m.panelOut.control = "stop"
        m.chipIn.control = "start"
        m.panelIn.control = "start"
    end if
    if not loading then armHide()
end sub

sub closePanel()
    m.open = false
    ' Clear Info/picker state so a closed panel's stale mode-branches don't eat OK/▲ on reopen.
    m.infoMode = false
    m.picker = invalid
    m.hideTimer.control = "stop"
    m.chipIn.control = "stop"
    m.panelIn.control = "stop"
    m.chipOut.control = "start"
    m.panelOut.control = "start"
end sub

sub armHide()
    m.hideTimer.control = "stop"
    m.hideTimer.control = "start"
end sub

sub onHideFire()
    closePanel()
end sub

' ---- render ------------------------------------------------------------------

sub onStatus()
    m.status = m.top.playerStatus
    if not m.open then return
    render()
    ' First real status after a tune → playback has started → begin the 8s auto-hide (tv-web parity).
    if m.awaitingPlay and m.status <> invalid and m.status.state <> "off" and m.status.loading <> true
        m.awaitingPlay = false
        armHide()
    end if
end sub

sub render()
    renderChip()   ' the chip only needs channel identity — render it even while still loading
    st = m.status
    if st = invalid then return

    g = st.guide
    isEpisode = (g <> invalid and g.showTitle <> invalid and g.showTitle <> "" and g.season <> invalid and g.episode <> invalid)
    if isEpisode
        m.title.text = g.showTitle
        sfx = "S" + Str(g.season).Trim() + ", E" + Str(g.episode).Trim()
        if g.title <> invalid and g.title <> "" then sfx = sfx + " · " + g.title
        m.subTitle.text = sfx
        m.subTitle.visible = true
    else
        if g <> invalid and g.title <> invalid then m.title.text = g.title else m.title.text = ""
        m.subTitle.visible = false
    end if

    renderScrubber()
    renderControls()
end sub

sub renderChip()
    m.chipIconC.blendColor = withAlpha(m.top.accent, 0.2)
    Icon.apply(m.chipIconG, "lucide:Tv", 20, m.top.accent)
    m.chipNum.color = m.top.accent
    m.chipNum.text = Str(m.top.channelNumber).Trim()
    m.chipName.text = m.top.channelName
    ' widths: icon circle (36 + 10 left) → number → name → right pad
    numX = 56
    m.chipNum.translation = [numX, 14]   ' vertically centred in the 56px chip (was sitting low)
    numW = measureW(m.chipNum, Len(m.chipNum.text) * 15)
    nameX = numX + numW + 12
    m.chipName.translation = [nameX, 14]
    nameW = measureW(m.chipName, Len(m.chipName.text) * 13)
    total = nameX + nameW + 22
    m.chipBg.width = total
    m.chipRing.width = total
    m.chipWrap.translation = [1880 - total, 28]
end sub

' Hide the whole scrubber (used while a tune is loading, so no previous-channel thumb/segments linger).
sub clearScrubber()
    for each b in m.segBg
        b.visible = false
    end for
    for each f in m.segFill
        f.visible = false
    end for
    m.thumb.visible = false
    m.thumbHalo.visible = false
    m.liveMark.visible = false
    m.liveDot.visible = false
    m.posLbl.text = ""
    m.liveLbl.text = ""
end sub

sub renderScrubber()
    sc = m.status.scrubber
    scrubFocused = (m.row = 0)
    if sc = invalid
        clearScrubber()
        return
    end if
    m.thumb.visible = true
    m.liveDot.visible = true
    segs = sc.segments
    n = segs.count()
    for i = 0 to SEG_POOL - 1
        if i < n
            seg = segs[i]
            left = Int(seg.leftPct / 100.0 * SCRUB_W) + 2
            wide = Int(seg.widthPct / 100.0 * SCRUB_W) - 4
            if wide < 2 then wide = 2
            b = m.segBg[i]
            b.translation = [left, 0]
            b.width = wide
            if seg.kind = "BUMPER" then b.blendColor = C_SEG_BUMP else b.blendColor = C_SEG_PROG
            b.visible = true
            f = m.segFill[i]
            if seg.fillPct > 0
                fw = Int(seg.fillPct / 100.0 * wide)
                if fw < 2 then fw = 2
                f.translation = [left, 0]
                f.width = fw
                f.blendColor = m.top.accent
                f.visible = true
            else
                f.visible = false
            end if
        else
            m.segBg[i].visible = false
            m.segFill[i].visible = false
        end if
    end for

    ' circular thumb (+ focus halo)
    tx = Int(sc.thumbPct / 100.0 * SCRUB_W)
    if scrubFocused
        m.thumb.uri = A_THUMB
        m.thumb.width = 24
        m.thumb.height = 24
        m.thumb.translation = [tx - 12, 4 - 12]
        m.thumbHalo.translation = [tx - 17, 4 - 17]
        m.thumbHalo.blendColor = withAlpha(m.top.accent, 0.4)
        m.thumbHalo.visible = true
    else
        m.thumb.uri = A_THUMB_SM
        m.thumb.width = 16
        m.thumb.height = 16
        m.thumb.translation = [tx - 8, 4 - 8]
        m.thumbHalo.visible = false
    end if

    if sc.liveVisible
        m.liveMark.translation = [Int(sc.livePct / 100.0 * SCRUB_W) - 1, -4]
        m.liveMark.visible = true
    else
        m.liveMark.visible = false
    end if

    m.posLbl.text = fmtDur(sc.slotPositionS)
    m.posLbl.translation = [PAD_X + tx - 20, SCRUB_Y + 20]
    if scrubFocused then m.posLbl.color = C_TEXT else m.posLbl.color = C_SUB

    ' LIVE dot + label, right-aligned
    if sc.atLive
        m.liveLbl.text = "LIVE"
        m.liveLbl.color = C_LIVE
        m.liveDot.blendColor = C_LIVE
    else
        m.liveLbl.text = "-" + fmtDur(sc.behindS)
        m.liveLbl.color = C_MUTED
        m.liveDot.blendColor = "0x64748BFF"
    end if
    ' dot sits just left of the right-aligned label
    lblW = Len(m.liveLbl.text) * 10
    m.liveDot.translation = [PAD_X + SCRUB_W - 20 - lblW - 16, SCRUB_Y + 24]
end sub

sub renderControls()
    st = m.status
    paused = (st.paused = true)
    atLive = true
    if st.scrubber <> invalid then atLive = st.scrubber.atLive

    for i = 0 to m.ctl.count() - 1
        btn = m.ctl[i]
        focused = (m.open and m.row = 1 and m.col = i)
        if focused
            btn.bg.blendColor = C_FOCUS_BG
            btn.ring.blendColor = C_BORDER_FOCUS
            btn.focusRing.visible = true
        else
            btn.bg.blendColor = C_GLASS
            btn.ring.blendColor = C_BORDER
            btn.focusRing.visible = false
        end if
    end for

    if paused then Icon.apply(m.ctl[0].icon, "lucide:Play", 22, C_TEXT) else Icon.apply(m.ctl[0].icon, "lucide:Pause", 22, C_TEXT)
    setPillText(0, paused ? "Play" : "Pause")
    if atLive then Icon.apply(m.ctl[4].icon, "lucide:Clapperboard", 22, C_TEXT) else Icon.apply(m.ctl[4].icon, "lucide:Radio", 22, C_TEXT)
    setPillText(4, atLive ? "Jump to Live" : "Continue Watching")
    relayoutControls()
end sub

' Size each text pill to fit its actual rendered text (icon + gap + text + padding), and reflow the left
' cluster. The circle selectors (right cluster) are fixed at 54. Measured, not char-count-estimated.
sub relayoutControls()
    x = PAD_X
    for i = 0 to 4
        btn = m.ctl[i]
        tw = measureW(btn.txt, btn.meta.w - 72)
        pw = 52 + tw + 20
        btn.bg.width = pw
        btn.ring.width = pw
        btn.focusRing.width = pw + 4
        btn.group.translation = [x, CTL_Y]
        x = x + pw + 12
    end for
end sub

' Real rendered text width via boundingRect (valid after first render); fall back to an estimate on frame 0.
function measureW(lbl as object, fallback as integer) as integer
    r = lbl.boundingRect()
    if r <> invalid and r.width > 0 then return Int(r.width)
    return fallback
end function

sub setPillText(idx as integer, label as string)
    btn = m.ctl[idx]
    if btn.txt <> invalid then btn.txt.text = label
end sub

' ---- Info view (C2) ---------------------------------------------------------

' The Info view (tv-web/native parity): the panel GROWS UPWARD (title+scrim move up), a badge meta row
' (year · rating chip · ★critic · duration), the summary, Genres/Cast/Director/Studio COLUMNS, and the
' PLAYBACK delivery chips. Positions flow with measured widths.
const INFO_TITLE_Y = 512
const INFO_META_Y = 620
const INFO_SUMMARY_Y = 664
const INFO_COLS_Y = 838
const INFO_DL_Y = 942
const INFO_HINT_Y = 1030

sub buildInfo(parent as object)
    g = parent.createChild("Group")
    g.visible = false
    ' meta row (badges), positioned in renderInfo
    m.mYear = mkLabel(g, Theme.FONT_REG, 20, C_SUB, [0, 0], 120, 1)
    m.ratingChip = mkChip(g, 18)
    m.mStar = mkLabel(g, Theme.FONT_REG, 18, "0xF0A92AFF", [0, 0], 40, 1)
    m.mCritic = mkLabel(g, Theme.FONT_MED, 20, C_SUB, [0, 0], 80, 1)
    m.mDur = mkLabel(g, Theme.FONT_REG, 20, C_SUB, [0, 0], 140, 1)
    ' summary
    m.infoSummary = mkLabel(g, Theme.FONT_REG, 22, C_DETAIL, [PAD_X, INFO_SUMMARY_Y], 1300, 4)
    ' detail columns (label over value)
    m.cols = []
    for i = 0 to 3
        c = g.createChild("Group")
        cl = mkLabel(c, Theme.FONT_SEMI, 13, C_HINT, [0, 0], 360, 1)
        cv = mkLabel(c, Theme.FONT_REG, 18, C_DETAIL, [0, 26], 360, 2)
        m.cols.push({ group: c, label: cl, value: cv })
    end for
    ' delivery
    m.dlLabel = mkLabel(g, Theme.FONT_SEMI, 13, C_HINT, [PAD_X, INFO_DL_Y], 300, 1)
    m.dlLabel.text = "PLAYBACK"
    m.dlChips = []
    for i = 0 to 5
        m.dlChips.push(mkChip(g, 15))
    end for
    m.infoHint = mkLabel(g, Theme.FONT_REG, 15, C_HINT, [PAD_X, INFO_HINT_Y], 500, 1)
    m.infoHint.text = "Press Back to return"
    m.infoGroup = g
end sub

function mkLabel(parent as object, font as string, size as integer, color as string, xy as object, w as integer, maxlines as integer) as object
    l = parent.createChild("Label")
    Theme.setFont(l, font, size)
    l.color = color
    l.translation = xy
    l.width = w
    if maxlines > 1
        l.wrap = true
        l.maxLines = maxlines
    end if
    return l
end function

' A small rounded badge (chip.9 bg + a label), sized to its text in renderInfo.
function mkChip(parent as object, fontSize as integer) as object
    grp = parent.createChild("Group")
    bg = grp.createChild("Poster")
    bg.uri = A_CHIP
    bg.height = 30
    lbl = grp.createChild("Label")
    Theme.setFont(lbl, Theme.FONT_MED, fontSize)
    lbl.translation = [12, 4]
    return { group: grp, bg: bg, label: lbl }
end function

sub setInfoMode(on as boolean)
    m.infoMode = on
    m.body.visible = not on
    m.infoGroup.visible = on
    if on
        ' Grow the panel upward: raise the title/sub + extend the scrim (parity with tv-web/native).
        m.title.translation = [PAD_X, INFO_TITLE_Y]
        m.subTitle.translation = [PAD_X, INFO_TITLE_Y + 52]
        m.scrim.translation = [0, INFO_TITLE_Y - 44]
        m.scrim.height = 1080 - (INFO_TITLE_Y - 44)
        renderInfo()
    end if
    armHide()   ' the Info view still auto-hides on the 8s timer, like tv-web/native
end sub

sub renderInfo()
    g = m.status.guide
    if g = invalid then return

    ' meta row — year · rating chip · ★ critic · duration (flow with measured widths)
    x = PAD_X
    if g.year <> invalid
        m.mYear.text = Str(g.year).Trim()
        m.mYear.translation = [x, INFO_META_Y]
        m.mYear.visible = true
        x = x + measureW(m.mYear, 60) + 16
    else
        m.mYear.visible = false
    end if
    if g.contentRating <> invalid and g.contentRating <> ""
        m.ratingChip.label.text = g.contentRating
        m.ratingChip.label.color = C_SUB
        tw = measureW(m.ratingChip.label, 40)
        m.ratingChip.bg.width = tw + 24
        m.ratingChip.bg.blendColor = "0x94A3B82E"
        m.ratingChip.group.translation = [x, INFO_META_Y - 4]
        m.ratingChip.group.visible = true
        x = x + tw + 24 + 16
    else
        m.ratingChip.group.visible = false
    end if
    if g.criticRating <> invalid
        Icon.apply(m.mStar, "lucide:Star", 18, "0xF0A92AFF")
        m.mStar.translation = [x, INFO_META_Y + 2]
        m.mStar.visible = true
        x = x + 26
        m.mCritic.text = fmtRating(g.criticRating)
        m.mCritic.translation = [x, INFO_META_Y]
        m.mCritic.visible = true
        x = x + measureW(m.mCritic, 40) + 16
    else
        m.mStar.visible = false
        m.mCritic.visible = false
    end if
    if g.durationMs <> invalid
        m.mDur.text = Str(Int(g.durationMs / 60000)).Trim() + " min"
        m.mDur.translation = [x, INFO_META_Y]
        m.mDur.visible = true
    else
        m.mDur.visible = false
    end if

    if g.summary <> invalid then m.infoSummary.text = g.summary else m.infoSummary.text = ""

    ' detail columns
    colDefs = [
        { label: "GENRES", value: joinOr(g.genres) },
        { label: "CAST", value: joinOr(g.cast) },
        { label: "DIRECTOR", value: joinOr(g.directors) },
        { label: "STUDIO", value: strOr(g.studio) }
    ]
    cx = PAD_X
    for i = 0 to 3
        c = m.cols[i]
        v = colDefs[i].value
        if v <> ""
            c.label.text = colDefs[i].label
            c.value.text = v
            c.group.translation = [cx, INFO_COLS_Y]
            c.group.visible = true
            w = measureW(c.value, 200)
            if w > 340 then w = 340
            cx = cx + w + 44
        else
            c.group.visible = false
        end if
    end for

    ' delivery chips
    d = m.status.delivery
    chipDefs = []
    if d <> invalid
        chipDefs.push({ text: UCase(deliveryModeLabel(d.mode)), accent: true })
        if d.container <> invalid then chipDefs.push({ text: UCase(d.container), accent: false })
        if d.videoCodec <> invalid then chipDefs.push({ text: UCase(d.videoCodec), accent: false })
        if d.audioCodec <> invalid then chipDefs.push({ text: UCase(d.audioCodec), accent: false })
        if d.connection <> invalid then chipDefs.push({ text: UCase(d.connection), accent: (d.connection <> "local") })
    end if
    dx = PAD_X
    for i = 0 to 5
        chip = m.dlChips[i]
        if i < chipDefs.count()
            cd = chipDefs[i]
            chip.label.text = cd.text
            tw = measureW(chip.label, 60)
            chip.bg.width = tw + 24
            if cd.accent
                chip.bg.blendColor = withAlpha(m.top.accent, 0.14)
                chip.label.color = m.top.accent
            else
                chip.bg.blendColor = "0x94A3B824"
                chip.label.color = C_DETAIL
            end if
            chip.group.translation = [dx, INFO_DL_Y + 24]
            chip.group.visible = true
            dx = dx + tw + 24 + 10
        else
            chip.group.visible = false
        end if
    end for
end sub

function joinOr(arr as dynamic) as string
    if arr = invalid or arr.count() = 0 then return ""
    return joinParts(arr, ", ")
end function

function strOr(v as dynamic) as string
    if v = invalid then return ""
    return v
end function

' ---- picker modal (C2) — the tv-native centered glass dialog -----------------

sub buildPicker()
    dimBg = m.top.createChild("Rectangle")
    dimBg.width = 1920
    dimBg.height = 1080
    dimBg.color = C_DIM
    dimBg.visible = false
    m.pickerDim = dimBg

    grp = m.top.createChild("Group")
    grp.visible = false
    m.pickerGroup = grp

    card = grp.createChild("Poster")
    card.uri = A_CARD
    card.blendColor = C_MODAL
    m.pickerCard = card

    ttl = grp.createChild("Label")
    Theme.setFont(ttl, Theme.FONT_BOLD, 15)
    ttl.color = C_MODAL_TITLE
    ttl.translation = [30, 26]
    m.pickerTitle = ttl

    m.pickerRows = []
    for i = 0 to PICKER_POOL - 1
        row = grp.createChild("Group")
        rbg = row.createChild("Poster")
        rbg.uri = A_CARD
        rbg.height = 44
        rbg.visible = false
        chk = row.createChild("Label")
        Icon.apply(chk, "lucide:Check", 20, C_TEXT)
        chk.translation = [18, 11]
        chk.visible = false
        lbl = row.createChild("Label")
        Theme.setFont(lbl, Theme.FONT_SEMI, 18)
        lbl.color = C_TEXT
        lbl.translation = [54, 10]
        row.visible = false
        m.pickerRows.push({ group: row, bg: rbg, check: chk, label: lbl })
    end for

    foot = grp.createChild("Label")
    Theme.setFont(foot, Theme.FONT_REG, 13)
    foot.color = "0xFFFFFF66"
    foot.translation = [30, 0]
    foot.text = "OK to select · Back to cancel"
    m.pickerFoot = foot
end sub

sub openPicker(kind as string)
    m.picker = kind
    items = []
    cur = ""
    if kind = "audio"
        m.pickerTitleText = "Audio"
        items.push({ value: "", label: "Default" })
        tr = m.top.tracks
        if tr <> invalid and tr.audio <> invalid
            for each t in tr.audio
                items.push({ value: t.id, label: t.label })
            end for
        end if
        cur = m.selAudio
    else if kind = "subtitle"
        m.pickerTitleText = "Subtitles"
        items.push({ value: "off", label: "Off" })
        tr = m.top.tracks
        if tr <> invalid and tr.subtitle <> invalid
            for each t in tr.subtitle
                items.push({ value: t.id, label: t.label })
            end for
        end if
        cur = m.selSub
    else
        m.pickerTitleText = "Quality"
        q = m.top.qualities
        if q <> invalid
            for each it in q
                items.push({ value: it.id, label: it.label })
            end for
        end if
        cur = m.selQuality
    end if
    m.pickerItems = items
    m.pickerCurrent = cur
    sel = 0
    for i = 0 to items.count() - 1
        if items[i].value = cur then sel = i
    end for
    m.pickerSel = sel
    m.hideTimer.control = "stop"
    renderPicker()
    m.pickerDim.visible = true
    m.pickerGroup.visible = true
end sub

sub closePicker()
    m.picker = invalid
    m.pickerDim.visible = false
    m.pickerGroup.visible = false
    armHide()
end sub

sub renderPicker()
    items = m.pickerItems
    n = items.count()
    visN = n
    if visN > PICKER_POOL then visN = PICKER_POOL
    if visN < 1 then visN = 1
    cardH = 72 + visN * ROW_H + 42
    m.pickerGroup.translation = [Int((1920 - CARD_W) / 2), Int((1080 - cardH) / 2)]
    m.pickerCard.width = CARD_W
    m.pickerCard.height = cardH
    m.pickerTitle.text = UCase(m.pickerTitleText)

    for i = 0 to PICKER_POOL - 1
        row = m.pickerRows[i]
        if i < visN
            it = items[i]
            isSel = (it.value = m.pickerCurrent)
            isFocus = (i = m.pickerSel)
            row.group.translation = [14, 72 + i * ROW_H]
            row.group.visible = true
            if isFocus
                row.bg.width = CARD_W - 28
                row.bg.blendColor = m.top.accent
                row.bg.visible = true
            else if isSel
                row.bg.width = CARD_W - 28
                row.bg.blendColor = withAlpha(m.top.accent, 0.16)
                row.bg.visible = true
            else
                row.bg.visible = false
            end if
            row.check.visible = isSel
            if isSel
                if isFocus then Icon.apply(row.check, "lucide:Check", 20, "0x04060CFF") else Icon.apply(row.check, "lucide:Check", 20, m.top.accent)
            end if
            row.label.text = it.label
            if isFocus
                row.label.color = "0x04060CFF"
            else if isSel
                row.label.color = m.top.accent
            else
                row.label.color = C_TEXT
            end if
        else
            row.group.visible = false
        end if
    end for
    m.pickerFoot.translation = [30, cardH - 30]
end sub

sub applyPick(value as string)
    if m.picker = "audio"
        m.selAudio = value
        fire("selectAudio", value)
    else if m.picker = "subtitle"
        m.selSub = value
        fire("selectSub", value)
    else if m.picker = "quality"
        m.selQuality = value
        fire("selectQuality", value)
    end if
    closePicker()
end sub

function joinParts(arr as object, sep as string) as string
    out = ""
    first = true
    for each v in arr
        if not first then out = out + sep
        out = out + v
        first = false
    end for
    return out
end function

function fmtRating(r as dynamic) as string
    x = Int(r * 10.0 + 0.5)
    return Str(x \ 10).Trim() + "." + Str(x mod 10).Trim()
end function

function deliveryModeLabel(mode as dynamic) as string
    if mode = "direct" then return "Direct Play"
    if mode = "http" then return "Progressive Transcode"
    if mode = "hls" then return "HLS Transcode"
    return "Playing"
end function

' ---- keys --------------------------------------------------------------------

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if not m.top.active then return false

    ' Picker modal owns all keys while open.
    if m.picker <> invalid
        if key = Keys.UP
            if m.pickerSel > 0 then m.pickerSel = m.pickerSel - 1
            renderPicker()
        else if key = Keys.DOWN
            if m.pickerSel < m.pickerItems.count() - 1 then m.pickerSel = m.pickerSel + 1
            renderPicker()
        else if key = Keys.OK
            it = m.pickerItems[m.pickerSel]
            if it <> invalid then applyPick(it.value)
        else if key = Keys.BACK
            closePicker()
        end if
        return true
    end if
    ' Info view — Back exits it; any key re-arms the auto-hide (parity: Info still times out).
    if m.infoMode
        armHide()
        if key = Keys.BACK then setInfoMode(false)
        return true
    end if

    if not m.open
        if key = Keys.OK or key = Keys.UP or key = Keys.DOWN
            openPanel(false)
            return true
        else if key = Keys.BACK
            fire("back", "")
            return true
        else if key = Keys.LEFT or key = Keys.RIGHT
            fire("surf", "")
            return true
        end if
        return false
    end if

    armHide()
    if key = Keys.BACK
        closePanel()
        return true
    end if
    if m.row = 0
        if key = Keys.LEFT
            fire("seekBack", "")
        else if key = Keys.RIGHT
            fire("seekFwd", "")
        else if key = Keys.OK
            fire("pause", "")
        else if key = Keys.DOWN
            m.row = 1
            m.col = 0
            renderControls()
            renderScrubber()
        end if
        return true
    end if
    if key = Keys.LEFT
        if m.col > 0 then m.col = m.col - 1
        renderControls()
    else if key = Keys.RIGHT
        if m.col < m.ctl.count() - 1 then m.col = m.col + 1
        renderControls()
    else if key = Keys.UP
        m.row = 0
        renderControls()
        renderScrubber()
    else if key = Keys.OK
        activate(m.col)
    end if
    return true
end function

sub activate(col as integer)
    if col = 0
        fire("pause", "")
    else if col = 1
        fire("restart", "")
    else if col = 2
        closePanel()
        fire("surf", "")
    else if col = 3
        setInfoMode(true)
    else if col = 4
        fire("live", "")
    else if col = 5
        openPicker("audio")
    else if col = 6
        openPicker("subtitle")
    else if col = 7
        openPicker("quality")
    end if
end sub

sub fire(cmd as string, arg as string)
    m.top.commandArg = arg
    m.top.command = cmd
end sub

' ---- helpers ----------------------------------------------------------------

function withAlpha(argb as string, a as double) as string
    base = Left(argb, 8)
    v = Int(a * 255.0)
    if v < 0 then v = 0
    if v > 255 then v = 255
    hexd = "0123456789ABCDEF"
    return base + Mid(hexd, (v \ 16) + 1, 1) + Mid(hexd, (v mod 16) + 1, 1)
end function

function fmtDur(total as double) as string
    s = Int(total)
    if s < 0 then s = 0
    h = s \ 3600
    mn = (s mod 3600) \ 60
    sec = s mod 60
    ss = sec.toStr()
    if sec < 10 then ss = "0" + ss
    if h > 0
        mm = mn.toStr()
        if mn < 10 then mm = "0" + mm
        return h.toStr() + ":" + mm + ":" + ss
    end if
    return mn.toStr() + ":" + ss
end function
