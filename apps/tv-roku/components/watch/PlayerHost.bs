import "pkg:/source/lib/api.bs"
import "pkg:/source/lib/device.bs"
import "pkg:/source/lib/log.bs"
import "pkg:/source/theme.bs"
import "pkg:/source/lib/registry.bs"
import "pkg:/source/lib/guideLayout.bs"
import "pkg:/source/lib/icon.bs"
import "pkg:/source/input/keys.bs"
' NOTE: the clock's core is named `seekTo` (not `goTo`) — `goTo` case-folds to the reserved `goto` keyword.
' Wall-clock/server-clock helpers are `wallMs`/`clockSec` — a plain `nowMs` collides with GuideLayout's param.

' PlayerHost code-behind — THE effectiveTime DVR clock, ported EXACTLY from tv-web/tv-native
' `use-tv-player.ts`. See the .xml header. One clock over the channel timeline drives the Video node:
' `seekTo(target)` maps any instant → the containing slot → (ratingKey, offset) → /media → play; a 500ms
' tick derives the effective time and rolls at boundaries (program → bumper → next); no future seek;
' rewind runs back OUT of the program, through the bumper, into the previous one. Resume + heartbeat.
'
' ⚠️ Roku translations of the web model:
'   • `videoPos` = the Video node's `position` field (seconds); baseline anchored on Video state="playing".
'   • NO hls.js — the Video node plays HLS natively (streamFormat="hls").
'   • Resume shape uses SECONDS (positionAtSec/savedAtSec), not tv-web's ms — epoch-ms overflows a 32-bit
'     BrightScript Integer (the parseIso trap); resume is device-local so the shape needn't match tv-web.
'   • `sameMedia` (same resolved URL) = a DVR seek within the loaded file / roll-back into a paused program,
'     NOT a reload (tv-native's lesson) — direct seeks in place; a transcode's offset is baked so a new
'     offset yields a new URL → a fresh load anyway.

const LIVE_THRESHOLD = 5.0
const RESUME_MAX_AGE_S = 21600.0   ' 6h
' Scrubber layout (tv-web parity): the focus program is the expanded middle; a fixed sliver of timeline
' before/after it is compressed into the left/right "peeks" so the thumb never collides with the LIVE edge.
const PEEK_L = 0.14
const PEEK_R = 0.14
const LOOKBACK_S = 360.0
const LOOKAHEAD_S = 360.0

sub init()
    m.top.visible = false   ' hidden until the first tune sets layout=full
    ' Suppress Roku's BUILT-IN trick-play UI (the native progress bar that pops up on rewind/ff/play). We
    ' draw our own chrome (Incr C), and focus lives on the PlayerHost Group — never the Video node — so the
    ' transport keys reach onKeyEvent instead of the Video's own trick-play handler.
    m.video.enableTrickPlay = false
    ' Our subs are server-burn-in; the Video must never render its own text track. `globalCaptionMode = "Off"`
    ' is the app-level override (jellyfin's method) that beats the SYSTEM caption setting; subtitleTrack="" alone
    ' doesn't — the Video re-selects an embedded track on load/seek per the global caption mode.
    m.video.globalCaptionMode = "Off"
    m.video.subtitleTrack = ""
    m.video.observeField("state", "onVideoState")
    m.tickTimer.observeField("fire", "onTick")
    m.heartbeatTimer.observeField("fire", "onHeartbeat")
    m.timelineTimer.observeField("fire", "onTimelineRefresh")
    Theme.setFont(m.status, Theme.FONT_REG, 22)
    m.status.visible = false   ' the chrome renders real state now; keep the label only as a silent scratch
    ' Per-channel playback options (the pickers drive these in Incr C2).
    m.quality = "original"
    m.audioStreamId = invalid
    m.subtitleStreamId = invalid
    ' The "Coming up next" bumper interstitial — created BELOW the chrome (over the video), shown on a bumper.
    m.bumper = CreateObject("roSGNode", "BumperCard")
    m.top.appendChild(m.bumper)
    ' The full-screen chrome (channel chip + DVR scrubber + controls) — created once, fed the clock's status.
    m.chrome = CreateObject("roSGNode", "PlayerChrome")
    m.top.appendChild(m.chrome)
    m.chrome.observeField("command", "onChromeCommand")
    buildMiniOverlay()
    onThen(Api.qualities(), onQualities, m)
    resetClock()
end sub

' ---- surface layout: off | mini (docked in the guide) | full ----------------

sub onLayout()
    lay = m.top.layout
    if lay = "full"
        setVideoRect(0, 0, 1920, 1080)
        m.chrome.active = true
        m.chrome.setFocus(true)
        m.miniOverlay.visible = false
        m.top.visible = true
    else if lay = "mini"
        setVideoRect(m.top.dockX, m.top.dockY, m.top.dockW, m.top.dockH)
        m.chrome.active = false
        m.top.visible = true
        if m.top.miniFocused then m.miniSel = 0
        renderMiniOverlay()
        if m.top.miniFocused then m.top.setFocus(true)
    else
        m.top.visible = false
        m.chrome.active = false
        teardown()
    end if
    renderMiniHint()
end sub

sub setVideoRect(x as integer, y as integer, w as integer, h as integer)
    m.bg.translation = [x, y]
    m.bg.width = w
    m.bg.height = h
    m.video.translation = [x, y]
    m.video.width = w
    m.video.height = h
end sub

sub buildMiniOverlay()
    g = m.top.createChild("Group")
    g.visible = false
    dimBg = g.createChild("Rectangle")
    dimBg.color = "0x060A148C"   ' rgba(6,10,20,0.55)
    m.miniDim = dimBg
    m.miniBtns = []
    icons = ["lucide:Maximize2", "lucide:X"]
    labels = ["Full screen", "Close"]
    for i = 0 to 1
        b = g.createChild("Group")
        circ = b.createChild("Poster")
        circ.uri = "pkg:/images/circle-54.png"
        circ.width = 54
        circ.height = 54
        ico = b.createChild("Label")
        Icon.apply(ico, icons[i], 26, "0x06121FFF")
        ico.translation = [14, 12]
        lbl = b.createChild("Label")
        Theme.setFont(lbl, Theme.FONT_SEMI, 15)
        lbl.horizAlign = "center"
        lbl.width = 130
        lbl.translation = [-38, 62]
        lbl.text = labels[i]
        m.miniBtns.push({ group: b, circ: circ, icon: ico, label: lbl, iconId: icons[i] })
    end for
    m.miniOverlay = g
    m.miniSel = 0

    ' Footer hint (shown when the mini feed is docked but NOT focused): ✱ focuses it.
    hint = m.top.createChild("Group")
    hint.visible = false
    hbg = hint.createChild("Rectangle")
    hbg.color = "0x060A14D9"
    hico = hint.createChild("Label")
    Icon.apply(hico, "lucide:Asterisk", 22, "0xF1F5F9FF")
    htxt = hint.createChild("Label")
    Theme.setFont(htxt, Theme.FONT_SEMI, 16)
    htxt.color = "0xE6EAF1FF"
    htxt.text = "to focus"
    m.miniHint = hint
    m.miniHintBg = hbg
    m.miniHintIco = hico
    m.miniHintTxt = htxt
end sub

sub renderMiniHint()
    if m.top.layout <> "mini" or m.top.miniFocused
        m.miniHint.visible = false
        return
    end if
    dw = m.top.dockW
    stripH = 36
    m.miniHint.translation = [m.top.dockX, m.top.dockY + m.top.dockH - stripH]
    m.miniHintBg.width = dw
    m.miniHintBg.height = stripH
    startX = Int(dw / 2) - 55
    m.miniHintIco.translation = [startX, 6]
    m.miniHintTxt.translation = [startX + 28, 8]
    m.miniHint.visible = true
end sub

sub renderMiniOverlay()
    if m.top.layout <> "mini" or not m.top.miniFocused
        m.miniOverlay.visible = false
        return
    end if
    dw = m.top.dockW
    dh = m.top.dockH
    m.miniOverlay.translation = [m.top.dockX, m.top.dockY]
    m.miniDim.width = dw
    m.miniDim.height = dh
    gap = 44
    totalW = 54 * 2 + gap
    startX = Int((dw - totalW) / 2)
    cy = Int((dh - 54) / 2) - 8
    for i = 0 to 1
        b = m.miniBtns[i]
        b.group.translation = [startX + i * (54 + gap), cy]
        if i = m.miniSel
            b.circ.blendColor = m.top.accent
            Icon.apply(b.icon, b.iconId, 26, "0x06121FFF")
            b.label.color = "0xF1F5F9FF"
        else
            b.circ.blendColor = "0x1E293BD9"
            Icon.apply(b.icon, b.iconId, 26, "0xDFE4ECFF")
            b.label.color = "0x94A3B8FF"
        end if
    end for
    m.miniOverlay.visible = true
end sub

sub fireCmd(cmd as string)
    m.top.playerCmd = cmd
end sub

sub onQualities(data as object, _m as object)
    if data <> invalid and data.qualities <> invalid and m.chrome <> invalid then m.chrome.qualities = data.qualities
end sub

' The chrome fires a one-word command (+ commandArg for the pickers); dispatch it to the clock.
sub onChromeCommand()
    cmd = m.chrome.command
    if cmd = "" then return
    if cmd = "seekBack"
        seekBy(-10.0)
    else if cmd = "seekFwd"
        seekBy(10.0)
    else if cmd = "pause"
        togglePause()
    else if cmd = "live"
        jumpToLive()
    else if cmd = "restart"
        restart()
    else if cmd = "back"
        fireCmd("goMini")   ' Back from full → drop to the mini feed (keep playing); MainScene refocuses the guide
    else if cmd = "surf"
        openSurf()
    else if cmd = "selectQuality"
        m.quality = m.chrome.commandArg
        reResolve()
    else if cmd = "selectAudio"
        a = m.chrome.commandArg
        if a = "" then m.audioStreamId = invalid else m.audioStreamId = a
        reResolve()
    else if cmd = "selectSub"
        s = m.chrome.commandArg
        if s = "" or s = "off" then m.subtitleStreamId = invalid else m.subtitleStreamId = s
        reResolve()
    end if
end sub

' Re-resolve the current program at the same spot (a quality/audio/sub change).
sub reResolve()
    if m.current <> invalid and m.current.kind = "PROGRAM" then seekTo(currentEffective(), false, 0)
end sub

' A key over the current quality/audio/sub options — stamped on the loaded program so the seekTo no-op guard
' re-resolves when a picker changes one (parity with tv-web's paramsKey).
function paramsKeyOf() as string
    a = ""
    if m.audioStreamId <> invalid then a = m.audioStreamId
    s = ""
    if m.subtitleStreamId <> invalid then s = m.subtitleStreamId
    return m.quality + "|" + a + "|" + s
end function

' ---- channel surf -----------------------------------------------------------

sub openSurf()
    if m.surf = invalid
        m.surf = CreateObject("roSGNode", "ChannelSurf")
        m.top.appendChild(m.surf)
        m.surf.observeField("tuned", "onSurfTuned")
        m.surf.observeField("closed", "onSurfClosed")
    end if
    m.surf.currentChannelId = m.top.channelId
    m.surf.open = true
end sub

sub onSurfTuned()
    t = m.surf.tuned
    m.surf.open = false
    if t <> invalid and t.id <> invalid then reTune(t)
    if m.chrome <> invalid then m.chrome.setFocus(true)
end sub

sub onSurfClosed()
    m.surf.open = false
    if m.chrome <> invalid then m.chrome.setFocus(true)
end sub

' Re-tune the (full) player to a new channel from surf: swap identity + re-run the clock; the chrome resets
' via onGo's retune bump.
sub reTune(t as object)
    m.top.channelId = t.id
    m.top.channelNumber = t.number
    m.top.channelName = t.name
    m.top.accent = t.accent
    m.top.go = m.top.go + 1
end sub

' ---- clock ------------------------------------------------------------------

sub resetClock()
    ' Stop any running timers (a re-tune re-enters onGo without a Back/teardown in between — Incr B).
    m.tickTimer.control = "stop"
    m.heartbeatTimer.control = "stop"
    m.timelineTimer.control = "stop"
    m.clockOffset = 0.0        ' serverMs − localMs (double)
    m.slots = []               ' [{ kind, ratingKey, guide, startS, endS }] (seconds)
    m.current = invalid        ' the playing slot (see seekTo)
    m.bumperEff = 0.0          ' the bumper's effective time (wall-advanced)
    m.paused = false
    m.lastTickMs = wallMs()
    if m.gen = invalid then m.gen = 0   ' monotonic across re-tunes (a stale load's captured gen must not match)
    m.transitioning = false    ' re-entrancy guard across the async resolve
    m.currentUrl = ""          ' last loaded URL — same-URL seekTo = seek-in-place
    m.pending = invalid        ' stashed load context for onMedia
    m.pendingBootstrap = false
    m.logCtx = invalid
end sub

' Local wall-clock epoch ms (double — force past the 32-bit float quantization, the parseIso trap).
function wallMs() as double
    dt = CreateObject("roDateTime")
    ms# = dt.AsSeconds()
    ms# = ms# * 1000.0 + dt.GetMilliseconds()
    return ms#
end function

' The server-synced clock, in seconds.
function clockSec() as double
    return (wallMs() + m.clockOffset) / 1000.0
end function

' ---- tune / timeline --------------------------------------------------------

' MainScene set channelId then bumped `go`.
sub onGo()
    if m.top.channelId = invalid or m.top.channelId = "" then return
    resetClock()
    m.status.text = "Tuning…"
    ' Feed the chrome this channel's identity + hand it focus (it owns the player keys; the Video node never
    ' holds focus → no native trick-play bar). The chrome opens on OK.
    if m.chrome <> invalid
        m.chrome.accent = m.top.accent
        m.chrome.channelNumber = m.top.channelNumber
        m.chrome.channelName = m.top.channelName
        m.chrome.retune = m.chrome.retune + 1   ' reset the chrome (clear old scrubber, show Tuning) on (re)tune
    end if
    m.pendingBootstrap = true
    loadTimeline()
end sub

sub loadTimeline()
    p = Api.timeline(m.top.channelId, 360, 180)
    onThen(p, onTimeline, m)
    onCatch(p, onTimelineErr, m)
end sub

sub onTimeline(data as object, _m as object)
    if data = invalid then return
    m.clockOffset = GuideLayout.parseIso(data.serverTime) - wallMs()
    slots = []
    if data.slots <> invalid
        for each s in data.slots
            startS# = GuideLayout.parseIso(s.startsAt) / 1000.0
            slots.push({ kind: s.kind, ratingKey: s.ratingKey, guide: s.guide, startS: startS#, endS: startS# + s.durationSeconds })
        end for
    end if
    m.slots = slots
    m.timelineTimer.control = "start"

    if m.pendingBootstrap and m.current = invalid and slots.count() > 0
        m.pendingBootstrap = false
        m.tickTimer.control = "start"
        m.heartbeatTimer.control = "start"
        seekTo(resumePosition(), false, 0)
    else if m.current <> invalid
        reconcileCurrentIndex()   ' a refresh may have shifted slot indices
    end if
end sub

sub onTimelineErr(err as object, _m as object)
    m.status.text = "Timeline failed."
    Log.warn("[player] timeline error: " + Log.trunc(err))
end sub

sub onTimelineRefresh()
    m.pendingBootstrap = false
    loadTimeline()
end sub

' After a 120s refetch, re-point m.current.index at the slot it still represents (by start time).
sub reconcileCurrentIndex()
    i = 0
    for each s in m.slots
        if Abs(s.startS - m.current.startS) < 1.0
            m.current.index = i
            return
        end if
        i = i + 1
    end for
end sub

' The resume position for THIS channel: the saved spot IF same channel, not at live, fresh (<6h), and in
' range; else live. (cg-tv-resume, seconds shape — see the header.)
function resumePosition() as double
    live# = clockSec()
    raw = Registry.read(RegKey.RESUME)
    if raw = "" then return live#
    r = ParseJson(raw)
    if r = invalid then return live#
    if r.channelId <> m.top.channelId then return live#
    if r.atLiveEdge = true then return live#
    savedAt# = 0.0
    if r.savedAtSec <> invalid then savedAt# = r.savedAtSec
    if (wallMs() / 1000.0) - savedAt# >= RESUME_MAX_AGE_S then return live#
    pos# = 0.0
    if r.positionAtSec <> invalid then pos# = r.positionAtSec
    earliest# = m.slots[0].startS
    if pos# >= earliest# and pos# < live# then return pos#
    return live#
end function

' ---- seekTo — the core --------------------------------------------------------

sub seekTo(target as double, forceHls as boolean, audioCandidate as integer)
    if m.slots.count() = 0 then return
    if m.transitioning then return
    m.transitioning = true

    ' clamp to [firstSlotStart, now] — NEVER seek past live.
    clamped# = target
    minT# = m.slots[0].startS
    if clamped# < minT# then clamped# = minT#
    live# = clockSec()
    if clamped# > live# then clamped# = live#

    idx = findSlot(clamped#)
    prevSession = invalid
    if m.current <> invalid then prevSession = m.current.session

    ' off air — no slot contains this instant.
    if idx < 0
        m.gen = m.gen + 1
        stopSession(prevSession)
        stopMedia()
        m.current = invalid
        m.status.text = "Off air"
        m.transitioning = false
        return
    end if

    entry = m.slots[idx]

    ' No-op guard: already playing this exact program near this position (skip on a forced-hls retry).
    if not forceHls and audioCandidate = 0 and entry.kind = "PROGRAM" and entry.ratingKey <> invalid and m.current <> invalid and m.current.kind = "PROGRAM"
        curEff# = currentEffective()
        ' ...AND the same quality/audio/sub params — a picker change flips paramsKey so this re-resolves.
        ' (⚠️ this makes pickers re-resolve → a transcode whose video+burned-subs play but audio is silent on
        ' Roku — the open HLS-transcode-audio issue; see §0.5. Kept ON per James.)
        if m.current.index = idx and Abs(clamped# - curEff#) < 2.0 and m.current.paramsKey = paramsKeyOf()
            m.transitioning = false
            return
        end if
    end if

    ' BUMPER (or a program with no ratingKey) — no media. Pause-and-hold the program (keep it loaded so a
    ' DVR seek-back resolves sameMedia → resume-in-place); the BumperCard covers the frozen frame (Incr E).
    if entry.kind = "BUMPER" or entry.ratingKey = invalid
        m.gen = m.gen + 1
        m.current = { index: idx, kind: "BUMPER", startS: entry.startS, endS: entry.endS, ratingKey: invalid, guide: entry.guide, mode: invalid, session: invalid, offset: 0, playStartCurrentTime: 0.0, baselineReady: true, retried: false, delivery: invalid }
        m.bumperEff = clamped#
        m.paused = false
        ' Pause-and-HOLD the program (keep it loaded — a DVR seek-back resumes in place; the BumperCard covers
        ' the frozen frame). Bumper music is DEFERRED: Roku has ONE media pipeline (same lesson as the tvOS
        ' mpv-hybrid — two engines can't both hold the audio); revisit later via the video node playing the
        ' audio-only bed and swapping back to the program.
        m.video.control = "pause"
        m.transitioning = false
        return
    end if

    ' PROGRAM — resolve the playable URL (async). Stash the context; onMedia finishes + clears transitioning.
    m.gen = m.gen + 1
    offset = Int(clamped# - entry.startS)
    if offset < 0 then offset = 0
    m.status.text = "Loading…"
    pending = { gen: m.gen, idx: idx, entry: entry, offset: offset, forceHls: forceHls, prevSession: prevSession }
    p = Api.media(m.top.channelId, entry.ratingKey, offset, { deviceId: Device.id(), forceHls: forceHls, quality: m.quality, audioStreamId: m.audioStreamId, subtitleStreamId: m.subtitleStreamId })
    onThen(p, onMedia, pending)
    onCatch(p, onMediaErr, pending)
end sub

sub onMedia(info as object, pend as object)
    if pend = invalid
        m.transitioning = false
        return
    end if
    if pend.gen <> m.gen        ' a newer seekTo superseded this load
        m.transitioning = false
        return
    end if
    if info = invalid or info.url = invalid
        m.status.text = "No playable media."
        m.transitioning = false
        return
    end if

    entry = pend.entry
    offset = pend.offset
    fmt = mapFormat(info.mode, info.container)

    if pend.prevSession <> invalid and pend.prevSession <> info.session then stopSession(pend.prevSession)

    m.current = {
        index: pend.idx, kind: "PROGRAM", startS: entry.startS, endS: entry.endS,
        ratingKey: entry.ratingKey, guide: entry.guide, mode: info.mode, session: info.session,
        offset: offset, playStartCurrentTime: 0.0, baselineReady: false, retried: pend.forceHls,
        delivery: buildDelivery(info), paramsKey: paramsKeyOf()
    }
    m.paused = false
    if m.chrome <> invalid
        atracks = info.audioTracks
        if atracks = invalid then atracks = []
        stracks = info.subtitleTracks
        if stracks = invalid then stracks = []
        m.chrome.tracks = { audio: atracks, subtitle: stracks }
    end if

    sameMedia = (info.url = m.currentUrl)
    m.currentUrl = info.url

    if sameMedia
        ' DVR seek within the already-loaded file / roll-back into the program we paused for a bumper.
        if info.mode = "direct"
            ' A raw file's URL is offset-independent → seek to the new spot; its position IS the media
            ' offset, so the baseline can be anchored inline.
            m.current.playStartCurrentTime = offset
            m.current.baselineReady = true
            m.video.seek = offset
        end if
        m.video.control = "resume"
    else
        node = CreateObject("roSGNode", "ContentNode")
        node.url = info.url
        node.streamFormat = fmt
        ' direct (raw file) opens AT the offset; a transcode (http/hls) bakes the offset server-side → from 0.
        if info.mode = "direct" and offset > 0 then node.PlayStart = offset
        m.video.content = node
        m.video.control = "play"
        ' Anchor the baseline to the KNOWN offset immediately for direct-play (its position IS absolute media
        ' time — the same anchor the proven seek path uses). Anchoring on "playing" instead let a premature
        ' position (0, before the PlayStart seek settled) stick, then the position jumped to the offset → the
        ' clock ran ~offset AHEAD of live (invisible at a live join, obvious on a large resume offset).
        if info.mode = "direct"
            m.current.playStartCurrentTime = offset
            m.current.baselineReady = true
        end if
    end if

    m.status.text = "mode=" + info.mode + " fmt=" + fmt + " off=" + Str(offset).Trim()
    Log.info("[player] seekTo slot=" + Str(pend.idx).Trim() + " off=" + Str(offset).Trim() + " mode=" + info.mode + " same=" + sameMedia.toStr() + " url=" + Log.trunc(info.url))
    m.transitioning = false
end sub

sub onMediaErr(err as object, _m as object)
    m.status.text = "Playback failed."
    Log.warn("[player] media error: " + Log.trunc(err))
    m.transitioning = false
end sub

' Where we are on the timeline right now. PROGRAM: startS + offset + (videoPos − baseline); before the
' baseline is anchored (first "playing"), the target itself. BUMPER: the wall-advanced bumper clock.
function currentEffective() as double
    cur = m.current
    if cur = invalid then return clockSec()
    if cur.kind = "PROGRAM"
        if not cur.baselineReady then return cur.startS + cur.offset
        pos# = m.video.position
        return cur.startS + cur.offset + (pos# - cur.playStartCurrentTime)
    end if
    return m.bumperEff
end function

' ---- the 500ms tick — derive effective, roll at boundaries, publish -----------

sub onTick()
    t# = clockSec()
    nowWall# = wallMs()
    wallDt# = (nowWall# - m.lastTickMs) / 1000.0
    m.lastTickMs = nowWall#
    cur = m.current
    if cur = invalid then return

    effective# = 0.0
    if cur.kind = "PROGRAM"
        effective# = currentEffective()
        if effective# >= cur.endS - 0.25
            seekTo(cur.endS, false, 0)   ' ROLLOVER → next slot (may be a bumper → then next program)
            return
        end if
    else
        if not m.paused then m.bumperEff = m.bumperEff + wallDt#
        effective# = m.bumperEff
        if effective# >= cur.endS
            seekTo(cur.endS, false, 0)
            return
        end if
    end if

    publishStatus(cur, effective#, t#)
end sub

' ---- heartbeat + resume (10s) ------------------------------------------------

sub onHeartbeat()
    cur = m.current
    if cur = invalid then return
    eff# = currentEffective()
    t# = clockSec()
    saveResume(eff#, t#)   ' on the 10s cadence, not the 500ms tick — registry writes hit flash

    st = "program"
    if cur.kind = "BUMPER" then st = "bumper"
    delay# = t# - eff#
    if delay# < 0 then delay# = 0
    Api.heartbeat([
        ["channelId", m.top.channelId],
        ["state", st],
        ["ratingKey", cur.ratingKey],
        ["title", titleOf(cur.guide)],
        ["delaySeconds", Int(delay#)],
        ["positionAt", isoOf(eff#)],
        ["transcodeSession", cur.session]
    ])
end sub

sub saveResume(effective as double, t as double)
    if m.current = invalid then return
    delay# = t - effective
    b = Api.obj()
    b.channelId = m.top.channelId
    b.positionAtSec = Int(effective)
    b.atLiveEdge = (delay# < LIVE_THRESHOLD)
    b.savedAtSec = Int(wallMs() / 1000.0)
    Registry.write(RegKey.RESUME, FormatJson(b))
end sub

' ---- Video node events -------------------------------------------------------

sub onVideoState()
    st = m.video.state
    Log.info("[player] video state=" + st)
    cur = m.current
    if st = "playing"
        m.status.text = ""
        m.video.globalCaptionMode = "Off"   ' the Video re-selects a sub track on load/seek — force captions off
        m.video.subtitleTrack = ""
        ' Anchor the baseline on the first real playback of a fresh program load (the same-media seek path
        ' already anchored inline, guarded here by baselineReady).
        if cur <> invalid and cur.kind = "PROGRAM" and not cur.baselineReady
            cur.playStartCurrentTime = m.video.position
            cur.baselineReady = true
        end if
    else if st = "finished"
        ' keep-open EOF backstop: mpv/Video can stall on the last frame just shy of the slot boundary and
        ' never cross the 0.25s rollover threshold — roll to the next slot on EOF within 2s of the end.
        if cur <> invalid and cur.kind = "PROGRAM" and currentEffective() >= cur.endS - 2.0 then seekTo(cur.endS, false, 0)
    else if st = "error"
        m.status.text = "Video error"
        ' native-first safety-catch: a decode error on a non-hls program → force an HLS transcode retry.
        if cur <> invalid and cur.kind = "PROGRAM" and cur.mode <> "hls" and not cur.retried then seekTo(currentEffective(), true, 0)
    end if
end sub

' ---- controls (media remote keys in Incr A; the FeaturePanel drives these in Incr C) -----

sub togglePause()
    cur = m.current
    if cur = invalid then return
    if cur.kind = "PROGRAM"
        if m.paused
            m.video.control = "resume"
            m.paused = false
        else
            m.video.control = "pause"
            m.paused = true
        end if
    else
        m.paused = not m.paused
    end if
end sub

sub seekBy(seconds as double)
    seekTo(currentEffective() + seconds, false, 0)
end sub

sub jumpToLive()
    seekTo(clockSec(), false, 0)
end sub

sub restart()
    cur = m.current
    if cur = invalid then return
    if cur.kind = "BUMPER" then seekTo(clockSec(), false, 0) else seekTo(cur.startS, false, 0)
end sub

' ---- teardown ---------------------------------------------------------------

sub teardown()
    m.tickTimer.control = "stop"
    m.heartbeatTimer.control = "stop"
    m.timelineTimer.control = "stop"
    if m.current <> invalid
        saveResume(currentEffective(), clockSec())
        stopSession(m.current.session)
    end if
    Api.endSession()
    stopMedia()
end sub

' ---- helpers ----------------------------------------------------------------

function findSlot(t as double) as integer
    i = 0
    for each s in m.slots
        if t >= s.startS and t < s.endS then return i
        i = i + 1
    end for
    return -1
end function

sub stopMedia()
    m.video.control = "stop"
    m.video.content = invalid
    m.currentUrl = ""
end sub

sub stopSession(session as dynamic)
    if session <> invalid and session <> "" then Api.stop(m.top.channelId, session)
end sub

' /media mode + container → Roku Video streamFormat (jellyfin's approach: transcode → hls; direct/http →
' the raw container, which Roku accepts as a streamFormat: mkv/mp4/mov/…).
function mapFormat(mode as string, container as dynamic) as string
    if mode = "hls" then return "hls"
    if container <> invalid and container <> "" then return LCase(container)
    return "mp4"
end function

' The delivery readout (mode / container / codecs / connection) for the Info view (consumed in Incr C).
function buildDelivery(info as object) as object
    cont = invalid
    if info.decision <> invalid and info.decision.container <> invalid then cont = info.decision.container else cont = info.container
    vcodec = info.videoCodec
    if vcodec = invalid and info.decision <> invalid then vcodec = info.decision.videoCodec
    acodec = info.audioCodec
    if acodec = invalid and info.decision <> invalid then acodec = info.decision.audioCodec
    vdec = invalid
    adec = invalid
    if info.decision <> invalid
        vdec = info.decision.videoDecision
        adec = info.decision.audioDecision
    end if
    return { mode: info.mode, container: cont, videoCodec: vcodec, audioCodec: acodec, videoDecision: vdec, audioDecision: adec, connection: info.connection }
end function

function titleOf(g as dynamic) as string
    if g = invalid then return ""
    if g.showTitle <> invalid and g.showTitle <> "" then return g.showTitle + " — " + g.title
    if g.title = invalid then return ""
    return g.title
end function

function isoOf(sec as double) as string
    d = CreateObject("roDateTime")
    d.FromSeconds(Int(sec))
    return d.ToISOString()
end function

' m:ss (or h:mm:ss) from a seconds duration.
function fmtDur(total as double) as string
    s = Int(total)
    if s < 0 then s = 0
    h = s \ 3600
    mn = (s mod 3600) \ 60
    sec = s mod 60
    ss = sec.toStr()
    if sec < 10 then ss = "0" + ss
    if h > 0
        mm = mn.toStr()
        if mn < 10 then mm = "0" + mm
        return h.toStr() + ":" + mm + ":" + ss
    end if
    return mn.toStr() + ":" + ss
end function

' Build the status object the chrome renders from + push it to PlayerChrome (Incr C). Also drives a debug
' label (covered by the panel) while iterating.
sub publishStatus(cur as object, effective as double, t as double)
    behind# = t - effective
    if behind# < 0 then behind# = 0
    isBumper = (cur.kind = "BUMPER")

    live = "LIVE"
    if behind# >= LIVE_THRESHOLD then live = "-" + fmtDur(behind#)
    if isBumper
        remS = Int(cur.endS - effective + 0.999)   ' NB: `rem` is the reserved REM comment keyword
        if remS < 0 then remS = 0
        m.status.text = "BUMPER  " + Str(remS).Trim() + "s   up next: " + titleOf(cur.guide)
    else
        m.status.text = titleOf(cur.guide) + "    " + fmtDur(effective - cur.startS) + "    " + live
    end if

    if m.chrome = invalid then return
    st = "program"
    if isBumper then st = "bumper"
    status = {
        state: st,
        guide: cur.guide,
        paused: m.paused,
        canRestart: (cur.kind = "PROGRAM"),
        loading: false,
        bumperRemaining: -1,
        scrubber: buildScrubber(effective, t)
    }
    if isBumper
        rr = Int(cur.endS - effective + 0.999)
        if rr < 0 then rr = 0
        status.bumperRemaining = rr
    end if
    if cur.delivery <> invalid then status.delivery = cur.delivery

    ' Drive the "Coming up next" bumper card (shown over the frozen held frame during a bumper slot).
    if m.bumper <> invalid
        if isBumper and (m.top.layout = "full" or m.top.layout = "mini")
            m.bumper.channelId = m.top.channelId
            m.bumper.guide = cur.guide
            m.bumper.accent = m.top.accent
            m.bumper.total = Int(cur.endS - cur.startS)
            m.bumper.paused = m.paused
            m.bumper.compact = (m.top.layout = "mini")   ' compact variant when docked
            if m.top.layout = "mini"
                m.bumper.dockX = m.top.dockX
                m.bumper.dockY = m.top.dockY
                m.bumper.dockW = m.top.dockW
                m.bumper.dockH = m.top.dockH
            end if
            m.bumper.remaining = status.bumperRemaining
            if not m.bumper.active then m.bumper.active = true
        else if m.bumper.active
            m.bumper.active = false
        end if
    end if

    m.chrome.playerStatus = status
end sub

' Map a timeline instant → a bar percentage (0–100): the focus program fills the wide middle; timeline
' before/after compresses into the fixed left/right peeks. Ported from tv-web buildScrubber's mapT.
function mapT(t as double, fStart as double, fEnd as double, fDur as double) as double
    f# = 0.0
    if t < fStart
        d# = (fStart - t) / LOOKBACK_S
        if d# > 1.0 then d# = 1.0
        f# = PEEK_L * (1.0 - d#)
    else if t > fEnd
        d# = (t - fEnd) / LOOKAHEAD_S
        if d# > 1.0 then d# = 1.0
        f# = 1.0 - PEEK_R + d# * PEEK_R
    else
        f# = PEEK_L + ((t - fStart) / fDur) * (1.0 - PEEK_L - PEEK_R)
    end if
    p# = f# * 100.0
    if p# < 0.0 then p# = 0.0
    if p# > 100.0 then p# = 100.0
    return p#
end function

' The multi-segment scrubber view — the PROGRAM you're in is the expanded middle, flanked by fixed
' left/right peeks (prev tail + bumper, upcoming bumper + next head). Ported EXACTLY from tv-web.
function buildScrubber(effective as double, nowS as double) as object
    slots = m.slots
    behind# = nowS - effective
    if behind# < 0 then behind# = 0
    atLive = (behind# < LIVE_THRESHOLD)
    curIdx = findSlot(effective)
    if curIdx < 0 then return { segments: [], thumbPct: 0.0, livePct: 100.0, liveVisible: false, slotPositionS: 0.0, atLive: atLive, behindS: behind# }
    cur = slots[curIdx]

    ' Focus = the program you're in; if in a bumper, the nearest program (prev, else next).
    focus = cur
    if cur.kind = "BUMPER"
        j = curIdx - 1
        while j >= 0 and slots[j].kind <> "PROGRAM"
            j = j - 1
        end while
        if j >= 0
            focus = slots[j]
        else
            k = curIdx + 1
            while k < slots.count() and slots[k].kind <> "PROGRAM"
                k = k + 1
            end while
            if k < slots.count() then focus = slots[k]
        end if
    end if

    fStart# = focus.startS
    fEnd# = focus.endS
    fDur# = fEnd# - fStart#
    if fDur# < 1.0 then fDur# = 1.0
    peekStart# = fStart# - LOOKBACK_S
    peekEnd# = fEnd# + LOOKAHEAD_S

    thumbPct# = mapT(effective, fStart#, fEnd#, fDur#)
    liveVisible = (nowS >= peekStart# and nowS <= peekEnd#)
    livePct# = 100.0
    if liveVisible then livePct# = mapT(nowS, fStart#, fEnd#, fDur#)

    segments = []
    for each s in slots
        if s.endS > peekStart# and s.startS < peekEnd#
            ls# = s.startS
            if ls# < peekStart# then ls# = peekStart#
            rs# = s.endS
            if rs# > peekEnd# then rs# = peekEnd#
            l# = mapT(ls#, fStart#, fEnd#, fDur#)
            r# = mapT(rs#, fStart#, fEnd#, fDur#)
            w# = r# - l#
            if w# > 0.05
                isFocus = (s.startS = focus.startS and s.endS = focus.endS)
                fill# = 0.0
                if isFocus and thumbPct# > l#
                    fill# = ((thumbPct# - l#) / w#) * 100.0
                    if fill# > 100.0 then fill# = 100.0
                end if
                segments.push({ kind: s.kind, leftPct: l#, widthPct: w#, current: isFocus, fillPct: fill# })
            end if
        end if
    end for

    return { segments: segments, thumbPct: thumbPct#, livePct: livePct#, liveVisible: liveVisible, slotPositionS: effective - cur.startS, atLive: atLive, behindS: behind# }
end function

' ---- keys (Incr A: media remote drives the DVR before the chrome exists) -----

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    ' PlayerHost only holds focus when the MINI feed is focused (full → the chrome has focus; mini-unfocused
    ' → the guide does). The Full/Close overlay owns the keys here.
    if m.top.layout = "mini" and m.top.miniFocused
        if key = Keys.LEFT
            m.miniSel = 0
            renderMiniOverlay()
        else if key = Keys.RIGHT
            m.miniSel = 1
            renderMiniOverlay()
        else if key = Keys.OK
            if m.miniSel = 0 then fireCmd("goFull") else fireCmd("close")
        else if key = Keys.DOWN or key = Keys.BACK
            fireCmd("blurMini")   ' ▼ (or Back) drops focus back down to the guide (zoned nav)
        end if
        return true
    end if
    return false
end function
