import "pkg:/source/lib/log.bs"

sub init()
    m.top.functionName = "scan"
end sub

' LAN /24 sweep for `/api/health {ok:true}`, mirroring tv-native's batched-concurrent-probe model
' (server-scan.ts): fire a batch of async probes, collect them within a budget, advance. The Roku
' twist that makes it RELIABLE: a FRESH roMessagePort per batch. A single shared port let abandoned
' probes from an earlier batch deliver late roUrlEvents into a later batch, inflating its event count
' so it could exit before the live server answered (the "found once, then flaky" bug). Per-batch ports
' isolate the count completely; stragglers are also explicitly cancelled.
sub scan()
    prefix = localSubnet()
    Log.info("[scan] subnet=" + Log.trunc(prefix))
    if prefix = invalid
        m.top.progress = 1.0
        m.top.found = []
        m.top.finished = true
        return
    end if

    total = 254
    found = []
    batchSize = 24        ' concurrent probes per batch (matches tv-native)
    timeoutS = 2          ' each transfer self-aborts if no data within this window
    batchBudgetMs = 2500  ' max time to collect a batch's events before moving on

    host = 1
    while host <= total
        port = CreateObject("roMessagePort")   ' FRESH per batch — no cross-batch event leakage
        idToUrl = {}
        xfers = []        ' keep transfers referenced until their events fire (else GC cancels them)
        n = 0
        while n < batchSize and host <= total
            url = "http://" + prefix + "." + host.toStr() + ":3000"
            xfer = CreateObject("roUrlTransfer")
            xfer.setMessagePort(port)
            xfer.setUrl(url + "/api/health")
            xfer.setMinimumTransferRate(1, timeoutS)
            idToUrl[xfer.getIdentity().toStr()] = url
            xfers.push(xfer)
            xfer.asyncGetToString()
            host = host + 1
            n = n + 1
        end while

        ts = CreateObject("roTimespan")
        got = 0
        while got < n
            remaining = batchBudgetMs - ts.totalMilliseconds()
            if remaining <= 0 then exit while
            msg = wait(remaining, port)
            if msg = invalid then exit while
            if type(msg) = "roUrlEvent"
                got = got + 1
                if msg.getResponseCode() = 200
                    u = idToUrl[msg.getSourceIdentity().toStr()]
                    if u <> invalid
                        body = ParseJson(msg.getString())
                        if body <> invalid and body.ok = true
                            found.push(u)
                            Log.info("[scan] found " + u)
                        end if
                    end if
                end if
            end if
        end while

        ' Cancel any stragglers so they can't emit late events; the fresh next-batch port already
        ' isolates us, this just frees sockets promptly.
        for each x in xfers
            x.asyncCancel()
        end for

        m.top.progress = (host - 1) / total
        m.top.found = found
    end while

    Log.info("[scan] done — " + Str(found.count()).Trim() + " found")
    m.top.progress = 1.0
    m.top.found = found
    m.top.finished = true
end sub

' The /24 prefix of the Roku's LAN IP (e.g. "192.168.1"), or invalid. Replaces tv-web's WebRTC trick.
function localSubnet() as dynamic
    di = CreateObject("roDeviceInfo")
    addrs = di.GetIPAddrs()
    if type(addrs) <> "roAssociativeArray" then return invalid
    re = CreateObject("roRegex", "^(\d+\.\d+\.\d+)\.\d+$", "")
    for each iface in addrs
        ip = addrs[iface]
        if ip <> invalid and ip <> "" and Left(ip, 4) <> "127." and Left(ip, 8) <> "169.254."
            mm = re.match(ip)
            if mm.count() > 1 then return mm[1]
        end if
    end for
    return invalid
end function
