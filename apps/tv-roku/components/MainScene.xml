<?xml version="1.0" encoding="utf-8" ?>
<!--
  MainScene — the app host + entry gate. Routes to the first screen based on stored state
  (port of tv-native app/index.tsx): no server -> ServerSetup; no token -> Login (Phase 3);
  else -> Guide (Phase 6). Screens are appended as children over the background.
  Script auto-imported (bsconfig autoImportComponentScript).
-->
<component name="MainScene" extends="Scene">
    <interface>
        <!-- Deep-link channel target, set by main.bs from launch args / roInput (Roku cert). -->
        <field id="deepLink" type="string" alwaysNotify="true" />
        <!-- Never set true at runtime: gates the analyzer-visible inline roInput handler in handleRoInputEvents(). -->
        <field id="inlineInput" type="boolean" />
        <!-- Never set true at runtime: gates the analyzer-visible getUserData call in requestUserData() (RP 2.1). -->
        <field id="rfiEnabled" type="boolean" />
        <!-- Never set true at runtime: gates the analyzer-visible AppDialog beacons in emitDialogBeacons() (cert 3.2). -->
        <field id="dialogBeacons" type="boolean" />
    </interface>
    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x060A14FF" />
    </children>
</component>
