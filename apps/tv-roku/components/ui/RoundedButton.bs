import "pkg:/source/theme.bs"

sub init()
    render()
end sub

sub render()
    if m.bg = invalid then return   ' fields can change before init()
    r = m.top.radius
    w = m.top.w
    h = m.top.h
    focused = m.top.focused

    m.bg.width = w
    m.bg.height = h

    if m.top.outlined and not focused
        m.bg.uri = Theme.npBorder(r)
        m.bg.blendColor = m.top.fillColor    ' border color when outlined + unfocused
        m.label.color = m.top.textColor
    else
        m.bg.uri = Theme.npFill(r)
        if focused
            m.bg.blendColor = m.top.focusFill
            m.label.color = m.top.focusInk
        else
            m.bg.blendColor = m.top.fillColor
            m.label.color = m.top.textColor
        end if
    end if

    ' Focus ring — an accent outline offset OUTSIDE the button with a visible gap (tv-web's
    ' outline + outline-offset), so it reads as a ring, not just a bigger button.
    gap = 9
    m.ring.visible = focused
    m.ring.uri = Theme.npBorder(r)
    m.ring.blendColor = Theme.ACCENT   ' focus ring is always accent (tv-web's outline color)
    m.ring.width = w + gap * 2
    m.ring.height = h + gap * 2
    m.ring.translation = [-gap, -gap]

    m.label.text = m.top.text
    m.label.height = h
    ' Alignment: "left" indents the label (like a text input); "center" (default) fills the width.
    if m.top.align = "left"
        padX = 20
        m.label.horizAlign = "left"
        m.label.translation = [padX, 0]
        m.label.width = w - padX * 2
    else
        m.label.horizAlign = "center"
        m.label.translation = [0, 0]
        m.label.width = w
    end if
    ' jellyfin pattern: mutate the label's existing font object (uri+size), don't assign a new Font node.
    m.label.font.uri = m.top.fontUri
    m.label.font.size = m.top.fontSize
end sub
