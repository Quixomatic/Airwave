# ============================================================================
#  Airwave admin web — LOCAL DEVELOPMENT env (`pnpm dev`)
#  Copy to `apps/web/.env`.
# ============================================================================

# Full URL of the API the admin talks to. In dev this is the server (default :3000).
#
# It is OPTIONAL in the schema (packages/env/src/web.ts) — the packaged desktop admin
# injects it at runtime — but you SHOULD set it in dev. If it's unset, the admin falls
# back to its own origin, calls the Vite dev server instead of the API, gets index.html
# back where it expects a session, and white-screens. So set it:
VITE_SERVER_URL=http://localhost:3000
