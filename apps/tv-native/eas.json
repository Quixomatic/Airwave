{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1"
      }
    },
    "development-android": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-androidtv": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1"
      }
    },
    "development-tvos": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1"
      }
    },
    "development-tvos-sim": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1",
        "RCT_BUILD_HERMES_FROM_SOURCE": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "preview-androidtv": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_TV": "1"
      }
    },
    "preview-tvos": {
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1",
        "RCT_BUILD_HERMES_FROM_SOURCE": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1",
        "RCT_BUILD_HERMES_FROM_SOURCE": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    },
    "production-tvos": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "EXPO_TV": "1",
        "REACT_NATIVE_NODE_MODULES_DIR": "/Users/expo/workingdir/build/apps/tv-native/node_modules",
        "RCT_HERMES_V1_ENABLED": "1",
        "RCT_BUILD_HERMES_FROM_SOURCE": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "production": {},
    "production-tvos": {}
  }
}
