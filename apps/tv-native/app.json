{
  "expo": {
    "name": "ChannelGuide",
    "slug": "channelguide",
    "version": "0.8.8",
    "scheme": "channelguide",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060a14",
    "splash": {
      "backgroundColor": "#060a14",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.channelguide.tv",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.channelguide.tv",
      "adaptiveIcon": {
        "backgroundColor": "#060a14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@react-native-tvos/config-tv",
        {
          "showVerboseWarnings": false
        }
      ],
      "@ChannelGuide/mpv-player",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49e8c4ad-45d5-4dbc-a3c8-0b99297fbc00"
      }
    },
    "owner": "quixomatic"
  }
}
