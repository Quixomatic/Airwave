# Dev convenience: point the native app at your server so you skip onboarding while iterating.
# Copy to `.env` and set your server. EXPO_PUBLIC_* vars are exposed to the app at build time.
# Leave empty (or omit) to exercise the real onboarding/setup flow. A production build bakes nothing.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.156:3000
