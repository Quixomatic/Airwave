# ============================================================================
#  Airwave server — LOCAL DEVELOPMENT env (`pnpm dev`)
#  Copy to `apps/server/.env` and fill in the values.
#  (For Docker / self-host deployments use the ROOT .env.example instead.)
#
#  Validated by packages/env/src/server.ts — the server REFUSES TO BOOT if a
#  required var is missing or malformed. Everything under OPTIONAL can be left out.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# Postgres connection string. Point it at your local Postgres + a database you've created.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airwave

# 32+ character secret. It encrypts auth sessions AND every secret at rest (AI provider
# keys, the Plex owner token). Generate one with:  openssl rand -base64 48
# KEEP IT STABLE — changing it makes all stored secrets undecryptable (re-enter them).
BETTER_AUTH_SECRET=replace-with-a-32-plus-character-random-string

# Full URL where the API is reachable. In dev this is the API itself.
BETTER_AUTH_URL=http://localhost:3000

# The admin web origin allowed through CORS + better-auth (full URL, no trailing slash).
CORS_ORIGIN=http://localhost:3001

# --- FIRST ADMIN (recommended) ----------------------------------------------
# There is NO public sign-up. Set both to seed an admin account on first boot,
# otherwise you'll have no way to log in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- OPTIONAL: general ------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# The TV app origin (dev: http://localhost:3002) — allows it through CORS + auth.
# TV_APP_ORIGIN=http://localhost:3002
# Extra admin origins beyond CORS_ORIGIN — comma-separated exact origins (scheme+host+port).
# EXTRA_CORS_ORIGINS=

# --- OPTIONAL: AI lineup builder (durable workflow engine) ------------------
# Off by default. Enable to use "Build with AI" / the AI lineup + import workflows.
# The world runs in the same Postgres (its own `workflow` schema), so the URL usually
# matches DATABASE_URL. AI PROVIDER KEYS are NOT set here — add them in the admin UI
# (Settings → AI Assistant); they're stored encrypted in the DB.
# WORKFLOW_ENABLED=1
# WORKFLOW_TARGET_WORLD=postgres
# WORKFLOW_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/airwave
# WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:3152
# AI_LINEUP_BUILD_LIMIT=0   # cap channels built per run while testing (0/unset = full lineup)

# --- OPTIONAL: social OAuth (a provider is enabled only when BOTH are set) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- OPTIONAL: misc ---------------------------------------------------------
# Stable X-Plex-Client-Identifier for the Plex login handshake.
# PLEX_CLIENT_IDENTIFIER=
# Ambient bumper-music library directory.
# BUMPER_MUSIC_DIR=
