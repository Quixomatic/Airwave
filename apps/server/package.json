{
  "name": "server",
  "version": "0.8.21",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "workflow build && tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun --env-file=.env run scripts/dev.ts",
    "start": "bun run dist/index.mjs",
    "workflow:build": "workflow build",
    "workflow:bootstrap": "bootstrap",
    "workflow:ui": "bun --env-file=.env run scripts/workflow-ui.ts"
  },
  "dependencies": {
    "@ChannelGuide/api": "workspace:*",
    "@ChannelGuide/auth": "workspace:*",
    "@ChannelGuide/db": "workspace:*",
    "@ChannelGuide/env": "workspace:*",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "@workflow/world-postgres": "4.3.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "workflow": "4.3.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ChannelGuide/config": "workspace:*",
    "@swc/core": "1.15.3",
    "@types/bun": "catalog:",
    "@workflow/swc-plugin": "4.1.1",
    "tsdown": "^0.22.3",
    "typescript": "catalog:"
  }
}
