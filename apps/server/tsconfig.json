{
  "extends": "@airwave/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["src", "scripts", "workflows", "types"],
  "exclude": ["dist", "capability-media", ".well-known"]
}
