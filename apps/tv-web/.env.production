# Native app (webOS/Tizen) default: EMPTY, so the packaged build bakes NO server URL — it must
# onboard to a user-chosen server (an empty SERVER_URL → the setup screen). The Docker web player
# overrides this with its own URL via the container env at build time.
#
# ⚠️ Do NOT put a real URL here. If this is non-empty, the native app bakes it in, and "Change
# server" falls back to it instead of reaching the setup screen (you land on /login).
VITE_SERVER_URL=

# TV mode by default — the packaged webOS/Tizen .ipk builds from this file, so it must be a real
# 10-foot TV. The browser web players (Docker `CG_ROLE=tvweb`, the desktop server) override this to
# `true` (Docker bakes it in the build env; the desktop supervisor injects it at serve time).
VITE_IS_BROWSER=false
