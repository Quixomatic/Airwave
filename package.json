{
  "name": "Airwave",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=!desktop --filter=!@airwave/desktop-setup",
    "dev:core": "turbo run dev -F server -F web -F tv-web",
    "dev:setup": "bun scripts/dev-setup.ts",
    "version:bump": "bun scripts/bump-version.ts",
    "build": "turbo run build --filter=!tv-tauri",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "dev:desktop": "turbo run dev -F desktop",
    "db:push": "turbo run db:push -F @airwave/db",
    "db:studio": "turbo run db:studio -F @airwave/db",
    "db:generate": "turbo run db:generate -F @airwave/db",
    "db:migrate": "turbo run db:migrate -F @airwave/db",
    "workflow:build": "turbo run workflow:build -F server",
    "workflow:ui": "turbo run workflow:ui -F server"
  },
  "dependencies": {
    "@airwave/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@airwave/config": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@types/bun": "catalog:",
    "picocolors": "^1.1.1",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "overrides": {
      "@expo/dom-webview": "55.0.6"
    },
    "patchedDependencies": {
      "react-native-tvos@0.83.6-0": "patches/react-native-tvos@0.83.6-0.patch"
    },
    "onlyBuiltDependencies": [
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/linux-arm64"
    ]
  }
}
