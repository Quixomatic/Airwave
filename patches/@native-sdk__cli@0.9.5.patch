diff --git a/build/app.zig b/build/app.zig
index 7590a9e0ef354474b82d0ba16fb60d38828d8812..c14dc870c8338deece64eaa6314e731f869475eb 100644
--- a/build/app.zig
+++ b/build/app.zig
@@ -1772,6 +1772,17 @@ pub fn addAppArtifacts(b: *std.Build, dep: *std.Build.Dependency, app_options: A
     // cached object plus the tiny generated markup-data object. A markup edit
     // therefore avoids re-analyzing the SDK and app runner entirely.
     const exe_root = if (ts_stage) |stage| root: {
+        // PATCH (Airwave, tv-desktop): Windows COFF `zig build-obj` cannot merge
+        // the multi-object compiled-core archive + the loose platform C++ objects
+        // into one object — "coff does not support linking multiple objects into
+        // one" (Zig 0.16). Skip the compile-once-into-an-object split on Windows
+        // and link the app module straight into the exe: `addExecutable` does a
+        // real link, which handles an archive + many objects fine. Costs only the
+        // markup-edit caching optimization, and only on Windows. See upstream #365.
+        if (target.result.os.tag == .windows) {
+            app_mod.addObject(markupDataObject(b, target, app_optimize, stage.markup_c));
+            break :root app_mod;
+        }
         const app_code = b.addObject(.{
             .name = b.fmt("{s}-app-code", .{app_options.name}),
             .root_module = app_mod,
@@ -2620,6 +2631,11 @@ fn linkPlatform(b: *std.Build, dep: *std.Build.Dependency, target: std.Build.Res
         app_mod.linkSystemLibrary("mf", .{});
         app_mod.linkSystemLibrary("mfplat", .{});
         app_mod.linkSystemLibrary("winhttp", .{});
+        // Airwave (tv-desktop): DirectComposition + D3D11/DXGI for the glass
+        // chrome composited (per-pixel alpha) over the mpv video child HWND.
+        app_mod.linkSystemLibrary("dcomp", .{});
+        app_mod.linkSystemLibrary("d3d11", .{});
+        app_mod.linkSystemLibrary("dxgi", .{});
         if (web_engine == .chromium) app_mod.linkSystemLibrary("libcef", .{});
     }
 }
