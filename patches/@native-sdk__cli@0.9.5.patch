+#include <dxgi1_2.h>
+#include <dcomp.h>
+#include <d2d1_1.h>
 
 #include <stdint.h>
 #include <stdlib.h>
@@ -1970,6 +1977,21 @@ static void reorderWindowChildren(Host *host, uint64_t window_id) {
