+// ---- Airwave (tv-desktop): DirectComposition glass over the mpv video (0.3c) ----
+// The mpv video is a child HWND; a child HWND cannot be alpha-composited by the
+// SDK's software layered path. DirectComposition composes a TOPMOST visual (per-
+// pixel alpha) ABOVE all child HWNDs via the DWM, so UI drawn into that visual
+// shows the video through its transparent pixels. This is the airspace fix: the
+// glass chrome (controls/scrubber/scrim) lives in a DComp surface over the video.
+// PROOF STAGE: fills the surface with a vertical scrim gradient (transparent at
+// top -> dark at the bottom, the tv-web/tv-native player-chrome look). Later the
+// SDK canvas pixels are drawn here instead of a hardcoded gradient.
+struct VideoGlass {
+    ID3D11Device *d3d = nullptr;
+    IDCompositionDevice *dcomp = nullptr;
+    IDCompositionTarget *target = nullptr;
+    IDCompositionVisual *visual = nullptr;
+    IDCompositionSurface *surface = nullptr;
+    ID2D1Device *d2d_device = nullptr;
+    ID2D1DeviceContext *d2d_ctx = nullptr;
+    int width = 0;
+    int height = 0;
+};
+static std::map<HWND, VideoGlass> g_video_glass;
+
+// Returns 0 on success, or a negative code identifying the failed COM call.
+static int videoGlassEnsureDevice(VideoGlass &g) {
+    if (g.dcomp && g.d2d_ctx) return 0;
+    D3D_FEATURE_LEVEL fl = D3D_FEATURE_LEVEL_11_0;
+    HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+        D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0, D3D11_SDK_VERSION, &g.d3d, &fl, nullptr);
+    if (FAILED(hr)) {
+        hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_WARP, nullptr,
+            D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0, D3D11_SDK_VERSION, &g.d3d, &fl, nullptr);
+        if (FAILED(hr)) return -1;
+    }
+    IDXGIDevice *dxgi = nullptr;
+    if (FAILED(g.d3d->QueryInterface(__uuidof(IDXGIDevice), (void **)&dxgi)) || !dxgi) return -2;
+    hr = DCompositionCreateDevice(dxgi, __uuidof(IDCompositionDevice), (void **)&g.dcomp);
+    if (FAILED(hr)) { dxgi->Release(); return -3; }
+    ID2D1Factory1 *factory = nullptr;
+    D2D1_FACTORY_OPTIONS opts = {};
+    if (FAILED(D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, __uuidof(ID2D1Factory1),
+            &opts, (void **)&factory)) || !factory) { dxgi->Release(); return -4; }
+    if (FAILED(factory->CreateDevice(dxgi, &g.d2d_device)) || !g.d2d_device) { factory->Release(); dxgi->Release(); return -5; }
+    if (FAILED(g.d2d_device->CreateDeviceContext(D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &g.d2d_ctx)) || !g.d2d_ctx) { factory->Release(); dxgi->Release(); return -6; }
+    factory->Release();
+    dxgi->Release();
+    return 0;
+}
+
+// Returns 0 on success, negative on the failed step. Draws the player-chrome
+// scrim: transparent at top (video fully visible) → dark at the bottom, plus a
+// lighter top scrim — the tv-web/tv-native chrome look. (Real SDK-canvas chrome
+// replaces this hardcoded gradient in the next increment.)
+static int videoGlassPaint(VideoGlass &g) {
+    if (!g.surface || !g.d2d_ctx) return -20;
+    POINT offset = {};
+    IDXGISurface *dxgi_surface = nullptr;
+    HRESULT hr = g.surface->BeginDraw(nullptr, __uuidof(IDXGISurface), (void **)&dxgi_surface, &offset);
+    if (FAILED(hr) || !dxgi_surface) return -21;
+    ID2D1Bitmap1 *bitmap = nullptr;
+    D2D1_BITMAP_PROPERTIES1 props = D2D1::BitmapProperties1(
+        D2D1_BITMAP_OPTIONS_TARGET | D2D1_BITMAP_OPTIONS_CANNOT_DRAW,
+        D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED),
+        96.0f, 96.0f);
+    hr = g.d2d_ctx->CreateBitmapFromDxgiSurface(dxgi_surface, &props, &bitmap);
+    if (FAILED(hr)) fprintf(stderr, "[airwave] 0.3c CreateBitmapFromDxgiSurface hr=0x%08lx\n", (unsigned long)hr);
+    int rc = -22;
+    if (SUCCEEDED(hr) && bitmap) {
+        g.d2d_ctx->SetTarget(bitmap);
+        g.d2d_ctx->BeginDraw();
+        g.d2d_ctx->SetTransform(D2D1::Matrix3x2F::Translation((FLOAT)offset.x, (FLOAT)offset.y));
+        g.d2d_ctx->Clear(D2D1::ColorF(0, 0, 0, 0.0f)); // fully transparent → video shows through
+        const FLOAT fh = (FLOAT)g.height;
+        const FLOAT fw = (FLOAT)g.width;
+        // Bottom scrim: transparent for the top ~55%, ramping to ~88% black at
+        // the very bottom (where the transport controls sit).
+        ID2D1GradientStopCollection *stops = nullptr;
+        D2D1_GRADIENT_STOP gs[3] = {
+            { 0.0f, D2D1::ColorF(0, 0, 0, 0.0f) },
+            { 0.55f, D2D1::ColorF(0, 0, 0, 0.0f) },
+            { 1.0f, D2D1::ColorF(0, 0, 0, 0.88f) },
+        };
+        if (SUCCEEDED(g.d2d_ctx->CreateGradientStopCollection(gs, 3, &stops)) && stops) {
+            ID2D1LinearGradientBrush *brush = nullptr;
+            if (SUCCEEDED(g.d2d_ctx->CreateLinearGradientBrush(
+                    D2D1::LinearGradientBrushProperties(D2D1::Point2F(0, 0), D2D1::Point2F(0, fh)),
+                    stops, &brush)) && brush) {
+                g.d2d_ctx->FillRectangle(D2D1::RectF(0, 0, fw, fh), brush);
+                brush->Release();
+            }
+            stops->Release();
+        }
+        // Lighter top scrim (title/live badge area): ~55% black fading down.
+        ID2D1GradientStopCollection *top = nullptr;
+        D2D1_GRADIENT_STOP ts[2] = {
+            { 0.0f, D2D1::ColorF(0, 0, 0, 0.55f) },
+            { 1.0f, D2D1::ColorF(0, 0, 0, 0.0f) },
+        };
+        if (SUCCEEDED(g.d2d_ctx->CreateGradientStopCollection(ts, 2, &top)) && top) {
+            ID2D1LinearGradientBrush *tbrush = nullptr;
+            if (SUCCEEDED(g.d2d_ctx->CreateLinearGradientBrush(
+                    D2D1::LinearGradientBrushProperties(D2D1::Point2F(0, 0), D2D1::Point2F(0, fh * 0.22f)),
+                    top, &tbrush)) && tbrush) {
+                g.d2d_ctx->FillRectangle(D2D1::RectF(0, 0, fw, fh * 0.22f), tbrush);
+                tbrush->Release();
+            }
+            top->Release();
+        }
+        HRESULT edr = g.d2d_ctx->EndDraw();
+        g.d2d_ctx->SetTarget(nullptr);
+        bitmap->Release();
+        rc = SUCCEEDED(edr) ? 0 : -23;
+    }
+    dxgi_surface->Release();
+    g.surface->EndDraw();
+    return rc;
+}
+
+// Returns 1 on success, or a negative code identifying the failed step.
+static int videoGlassSetup(HWND hwnd) {
+    if (!hwnd) return -10;
+    RECT rc = {};
+    GetClientRect(hwnd, &rc);
+    int w = rc.right - rc.left;
+    int h = rc.bottom - rc.top;
+    if (w <= 0 || h <= 0) return -11;
+    VideoGlass &g = g_video_glass[hwnd];
+    int dev = videoGlassEnsureDevice(g);
+    if (dev != 0) return dev; // -1..-6
+    if (!g.target && FAILED(g.dcomp->CreateTargetForHwnd(hwnd, TRUE /*topmost*/, &g.target))) return -12;
+    if (!g.visual) {
+        if (FAILED(g.dcomp->CreateVisual(&g.visual))) return -13;
+        g.target->SetRoot(g.visual);
+    }
+    if (g.surface && (g.width != w || g.height != h)) { g.surface->Release(); g.surface = nullptr; }
+    if (!g.surface) {
+        if (FAILED(g.dcomp->CreateSurface((UINT)w, (UINT)h, DXGI_FORMAT_B8G8R8A8_UNORM,
+                DXGI_ALPHA_MODE_PREMULTIPLIED, &g.surface))) return -14;
+        g.width = w;
+        g.height = h;
+        g.visual->SetContent(g.surface);
+    }
+    int paint_rc = videoGlassPaint(g);
+    if (paint_rc != 0) return paint_rc; // -20..-23
+    HRESULT hr = g.dcomp->Commit();
+    if (FAILED(hr)) return -15;
+    return 1;
+}
+
 } // namespace
 
 extern "C" {
 
+// Airwave (tv-desktop): set up / refresh the DComp glass over the video (0.3c).
+// Keyed on the top-level HWND the app already holds — no Host dependency, so the
+// app can call it directly from its embed worker.
+int native_sdk_windows_video_glass_setup(void *hwnd) {
+    return videoGlassSetup((HWND)hwnd);
+}
