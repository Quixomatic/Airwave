+          moduleName,
+          methodName,
+          exception.name,
+          exception.reason);
     } @finally {
       [retainedObjectsForInvocation removeAllObjects];
     }
diff --git a/sdks/hermes-engine/utils/build-apple-framework.sh b/sdks/hermes-engine/utils/build-apple-framework.sh
index 1af9c76af96721a5e3359d15e6520a97ec834abc..51cd242bf042a633969526a53a62f260ccdd88c8 100644
--- a/sdks/hermes-engine/utils/build-apple-framework.sh
+++ b/sdks/hermes-engine/utils/build-apple-framework.sh
@@ -162,6 +162,19 @@ function build_apple_framework {
     xcrun dsymutil "./build_$1/lib/hermesvm.framework/hermesvm" -o "./build_$1/lib/hermesvm.framework.dSYM"
     cp -R "./build_$1"/lib/hermesvm.framework* "destroot/Library/Frameworks/$1"
 
+    # [Airwave patch — react-native-tvos#563 / facebook/react-native#45855]
+    # The from-source Hermes build does NOT stamp MinimumOSVersion into the tvOS framework's Info.plist
+    # (it's present for ios-arm64 but missing for tvos-arm64), so an App Store upload of the Apple TV app fails
+    # validation with ITMS-90360: "A value for the key 'MinimumOSVersion' in bundle …/hermesvm.framework is
+    # required." Stamp it here from the deployment target ($3) for every platform — a no-op where it's already
+    # correct (iOS), the fix where it's missing (tvOS). Runs before the universal xcframework is assembled, so
+    # the tvos-arm64 slice inherits it. iOS/tvOS frameworks are flat, so Info.plist is at the framework root.
+    HERMES_FW_PLIST="destroot/Library/Frameworks/$1/hermesvm.framework/Info.plist"
+    if [ -n "$3" ] && [ -f "$HERMES_FW_PLIST" ]; then
+      /usr/libexec/PlistBuddy -c "Set :MinimumOSVersion $3" "$HERMES_FW_PLIST" 2>/dev/null ||
+        /usr/libexec/PlistBuddy -c "Add :MinimumOSVersion string $3" "$HERMES_FW_PLIST"
+    fi
+
     # In a MacOS build, also produce the hermes and hermesc CLI tools.
     if [[ $1 == macosx ]]; then
       cmake --build "./build_$1" --target hermesc hermes -j "${NUM_CORES}"
