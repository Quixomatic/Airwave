diff --git a/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm b/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
index 35cfd7a..5482b64 100644
--- a/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
+++ b/ReactCommon/react/nativemodule/core/platform/ios/ReactCommon/RCTTurboModule.mm
@@ -470,9 +470,20 @@ void ObjCTurboModule::performVoidMethodInvocation(
     @try {
       [inv invokeWithTarget:strongModule];
     } @catch (NSException *exception) {
-      // Void methods are always async, re-throw instead of converting to
-      // JSError, same as the async branch in performMethodInvocation.
-      @throw exception;
+      // [ChannelGuide patch — facebook/react-native#54859]
+      // A void TurboModule method is dispatched ASYNC (see below), so there is NO caller to receive a
+      // re-thrown NSException: the original `@throw exception;` propagated into C++ on the async queue with
+      // no handler → std::terminate → abort(), which crashes the whole app at startup with
+      // 'RCTFatalException: non-std C++ exception' (iOS/tvOS 26 + release + New Architecture, fine in debug).
+      // Upstream fixed the non-void path (PR #50193) but never the void one. Since a void method is
+      // fire-and-forget (no return value, nothing awaits it), we LOG the culprit and swallow it instead of
+      // aborting — so a throwing native call (tvOS keychain, TVEventControl, etc.) can't kill the process.
+      NSLog(
+          @"[RN#54859] void TurboModule %s.%s threw (swallowed, NOT aborting): %@: %@",
+          moduleName,
+          methodName,
+          exception.name,
+          exception.reason);
     } @finally {
       [retainedObjectsForInvocation removeAllObjects];
     }
diff --git a/React/CxxModule/RCTCxxUtils.mm b/React/CxxModule/RCTCxxUtils.mm
index 4c018e6..ed377ab 100644
--- a/React/CxxModule/RCTCxxUtils.mm
+++ b/React/CxxModule/RCTCxxUtils.mm
@@ -12,6 +12,9 @@
 #import <cxxreact/CxxNativeModule.h>
 #import <jsi/jsi.h>
 
+#include <cxxabi.h>
+#include <typeinfo>
+
 #import "DispatchMessageQueueThread.h"
 #import "RCTCxxModule.h"
 #import "RCTNativeModule.h"
@@ -85,9 +88,31 @@ NSError *tryAndReturnError(const std::function<void()> &func)
   } catch (const std::exception &ex) {
     return errorWithException(ex);
   } catch (...) {
-    // On a 64-bit platform, this would catch ObjC exceptions, too, but not on
-    // 32-bit platforms, so we catch those with id exceptions above.
-    return RCTErrorWithMessage(@"non-std C++ exception");
+    // [ChannelGuide patch — facebook/react-native#54859]
+    // Reveal the ACTUAL non-std C++ exception type + message (via the C++ ABI) so the crash REASON names the
+    // culprit instead of the useless generic string. Kept FATAL (return the error): swallowing it here
+    // (return nil) let the app open but then HANG on a white screen, proving this exception is on a critical
+    // init path, not fire-and-forget — so we surface it to identify and fix the real source.
+    const char *mangled = "unknown";
+    if (const std::type_info *t = abi::__cxa_current_exception_type()) {
+      mangled = t->name();
+    }
+    int demangleStatus = 0;
+    char *demangled = abi::__cxa_demangle(mangled, nullptr, nullptr, &demangleStatus);
+    const char *typeName = (demangleStatus == 0 && demangled != nullptr) ? demangled : mangled;
+    std::string detail;
+    try {
+      throw;
+    } catch (const std::exception &e) {
+      detail = e.what();
+    } catch (...) {
+    }
+    NSString *msg = [NSString stringWithFormat:@"non-std C++ exception [type: %s] %s", typeName, detail.c_str()];
+    NSLog(@"[RN#54859] %@", msg);
+    if (demangled != nullptr) {
+      free(demangled);
+    }
+    return RCTErrorWithMessage(msg);
   }
 }
 
diff --git a/sdks/hermes-engine/utils/build-hermes-xcode.sh b/sdks/hermes-engine/utils/build-hermes-xcode.sh
index 60506d1..aa75880 100644
--- a/sdks/hermes-engine/utils/build-hermes-xcode.sh
+++ b/sdks/hermes-engine/utils/build-hermes-xcode.sh
@@ -52,11 +52,21 @@ fi
 
 deployment_target=$(get_deployment_target $PLATFORM_NAME)
 
-xcode_15_flags=""
+# [ChannelGuide patch — from-source Hermes on tvOS/iOS] Force-include the static jsi + VM
+# object files into the `hermesvm` shared framework. Hermes links `jsi` PUBLIC but WITHOUT
+# whole-archive, and the framework's top-level target is an (empty) dummy.cpp, so any jsi
+# symbol (HostObject/Value/NativeState/MutableBuffer/...) and VM symbol (NopCrashManager)
+# that nothing inside the VM already references gets DROPPED at link and is never exported
+# from the framework. That breaks a from-source build — React-jsi deliberately excludes
+# jsi.cpp expecting hermes-engine to provide these — with "Undefined symbols ... facebook::jsi::".
+# -all_load force-loads every archive in this link so those symbols land in (and export from)
+# the framework, matching the prebuilt hermes.framework. HERMES_EXTRA_LINKER_FLAGS reaches the
+# hermesvm shared link (proven: the -ld_classic flag below is applied to it).
+xcode_15_flags="LINKER:-all_load"
 xcode_major_version=$(xcodebuild -version | grep -oE '[0-9]*' | head -n 1)
 if [[ $xcode_major_version -ge 15 ]]; then
   echo "########### Using LINKER:-ld_classic ###########"
-  xcode_15_flags="LINKER:-ld_classic"
+  xcode_15_flags="$xcode_15_flags;LINKER:-ld_classic"
 fi
 
 boost_context_flag=""
@@ -68,6 +78,15 @@ architectures=$( echo "$ARCHS" | tr  " " ";" )
 
 echo "Configure Apple framework"
 
+# [ChannelGuide patch] The CMAKE_*_FLAGS_MINSIZEREL/_RELEASE overrides below add
+# -fvisibility=default so the from-source hermesvm.framework EXPORTS its public jsi + VM
+# symbols. Hermes's root CMakeLists appends "-fvisibility=hidden" to the GENERAL CMAKE_CXX/C
+# flags ("Don't export symbols unless we explicitly say so"), which hides jsi
+# (HostObject/Value/typeinfo/vtables) and hermes::vm::NopCrashManager; a from-source build
+# then can't link them (React-jsi excludes jsi.cpp expecting the framework to provide them).
+# The per-config flags are applied AFTER the general flags on every compile and Hermes does
+# NOT touch them, so -fvisibility=default here is the last -fvisibility and wins. Pairs with
+# LINKER:-all_load above, which force-includes jsi's objects so there is something to export.
 "$CMAKE_BINARY" \
   -S "${PODS_ROOT}/hermes-engine" \
   -B "${PODS_ROOT}/hermes-engine/build/${PLATFORM_NAME}" \
@@ -85,6 +104,10 @@ echo "Configure Apple framework"
   -DHERMES_BUILD_SHARED_JSI:BOOLEAN=false \
   -DCMAKE_CXX_FLAGS:STRING="-gdwarf" \
   -DCMAKE_C_FLAGS:STRING="-gdwarf" \
+  -DCMAKE_CXX_FLAGS_MINSIZEREL:STRING="-Os -DNDEBUG -fvisibility=default" \
+  -DCMAKE_C_FLAGS_MINSIZEREL:STRING="-Os -DNDEBUG -fvisibility=default" \
+  -DCMAKE_CXX_FLAGS_RELEASE:STRING="-O3 -DNDEBUG -fvisibility=default" \
+  -DCMAKE_C_FLAGS_RELEASE:STRING="-O3 -DNDEBUG -fvisibility=default" \
   -DIMPORT_HOST_COMPILERS:PATH="${hermesc_path}" \
   -DJSI_DIR="$jsi_path" \
   -DHERMES_RELEASE_VERSION="for RN $release_version" \
