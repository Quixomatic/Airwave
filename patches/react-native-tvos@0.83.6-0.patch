+++ b/sdks/hermes-engine/utils/build-hermes-xcode.sh
@@ -19,6 +19,14 @@ function get_platform_copy_destination {
     elif [[ $1 == "xros" || $1 == "xrsimulator" ]]; then
       echo "xros"
       return
+    elif [[ $1 == "appletvos" || $1 == "appletvsimulator" ]]; then
+      # [Airwave patch] Apple TV must copy the built framework to the "tvos" folder,
+      # because hermes-engine.podspec vendors tvOS from destroot/Library/Frameworks/tvos/.
+      # Upstream fell through to "ios" here, so the real from-source Apple TV framework landed
+      # in ios/ while the app linked an empty/missing framework at tvos/ -> every hermes + jsi
+      # symbol (makeHermesRuntime, HostObject, NopCrashManager, ...) came up undefined at link.
+      echo "tvos"
+      return
     fi
 
     echo "ios"
@@ -106,3 +114,19 @@ mkdir -p "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/${platform_copy
 cp -pfR \
   "${PODS_ROOT}/hermes-engine/build/${PLATFORM_NAME}/lib/hermesvm.framework" \
   "${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/${platform_copy_destination}"
+
+# [Airwave patch — react-native-tvos#563 / facebook/react-native#45855]
+# The from-source Hermes build (this script) does NOT stamp MinimumOSVersion into the tvOS framework's
+# Info.plist (it's set for iOS but missing for tvOS), so an Apple TV App Store upload fails validation with
+# ITMS-90360: "A value for the key 'MinimumOSVersion' in bundle …/hermesvm.framework is required." Stamp it into
+# the framework we just copied to destroot (the one the app embeds). Use TVOS_DEPLOYMENT_TARGET for Apple TV —
+# get_deployment_target() above falls through to IPHONEOS_… which is the wrong axis for tvOS.
+hermes_min_os="$deployment_target"
+if [[ $PLATFORM_NAME == "appletvos" || $PLATFORM_NAME == "appletvsimulator" ]]; then
+  hermes_min_os="${TVOS_DEPLOYMENT_TARGET:-$deployment_target}"
+fi
+hermes_fw_plist="${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/${platform_copy_destination}/hermesvm.framework/Info.plist"
+if [[ -n "$hermes_min_os" && -f "$hermes_fw_plist" ]]; then
+  /usr/libexec/PlistBuddy -c "Set :MinimumOSVersion $hermes_min_os" "$hermes_fw_plist" 2>/dev/null ||
+    /usr/libexec/PlistBuddy -c "Add :MinimumOSVersion string $hermes_min_os" "$hermes_fw_plist"
+fi
